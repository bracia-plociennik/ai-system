#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fail=0

require_file() {
  local path="$1"
  if [[ ! -f "$repo_root/$path" ]]; then
    echo "Missing personal-ops artifact: $path"
    fail=1
  fi
}

require_executable() {
  local path="$1"
  require_file "$path"
  if [[ -f "$repo_root/$path" && ! -x "$repo_root/$path" ]]; then
    echo "Personal-ops artifact is not executable: $path"
    fail=1
  fi
}

require_ref() {
  local file="$1"
  local pattern="$2"
  local label="$3"

  if [[ ! -f "$repo_root/$file" ]]; then
    echo "Missing file for personal-ops check: $file"
    fail=1
    return 0
  fi

  if ! rg -F -q -- "$pattern" "$repo_root/$file"; then
    echo "Missing personal-ops reference in $file: $label"
    fail=1
  fi
}

required_files=(
  ".systems/ai/core/personal-ops.md"
  ".systems/ai/templates/workspace/personal-ops/README.md"
  ".systems/ai/templates/workspace/personal-ops/personal-ops-readme.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-ins-readme.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-ins-index.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-ins-v3-index.template.md"
  ".systems/ai/templates/workspace/personal-ops/manual-daily-check-in.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-in.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-in-properties-v3.schema.json"
  ".systems/ai/templates/workspace/personal-ops/check-in-settings.local.template.md"
  ".systems/ai/templates/workspace/tasks/taskforge-vault.local.template.md"
  ".systems/scripts/map-notion-check-ins"
  ".systems/scripts/sync-personal-ops-check-ins"
  ".systems/scripts/sync-personal-ops-check-ins-v3"
  ".systems/scripts/personal_ops_properties_v3.py"
  ".systems/scripts/check-personal-ops"
)

for path in "${required_files[@]}"; do
  require_file "$path"
done

require_executable ".systems/scripts/map-notion-check-ins"
require_executable ".systems/scripts/sync-personal-ops-check-ins"
require_executable ".systems/scripts/sync-personal-ops-check-ins-v3"
require_executable ".systems/scripts/propose-task-candidates"

for term in \
  'context-as-data' \
  'dump/incoming/external/notion/check-ins' \
  'personal-ops/check-ins/YYYY/YYYY-MM-DD.md' \
  'personal-ops/indexes/check-ins.csv' \
  'personal-ops/indexes/check-ins.jsonl' \
  'personal-ops/indexes/check-ins.metrics.csv' \
  'personal-ops/check-ins/import-profiles/manual-daily-check-in.md' \
  'personal-ops/check-ins/YYYY/YYYY-MM-DD.assets' \
  'Markdown wins' \
  'private-sensitive' \
  'source_row_id' \
  'Manual Check-In Profile' \
  'Seed kolejnego dnia' \
  'unmapped_fields' \
  'attachments' \
  'Duplicate' \
  'Do not promote check-in content into memory' \
  'Derived indexes may be intentionally stale' \
  'unsynced-check-in-count' \
  'sync-recommendation-threshold: 7' \
  'last-sync-source: manual|notion-import|owner-approved-sync' \
  'sync-personal-ops-check-ins --workspace <workspace-path> --status-only' \
  'deleted daily files' \
  'do not use it to refresh manual-only edits' \
  'propose-task-candidates --workspace <workspace-path> --check-in' \
  'tags: [6d/do]' \
  'due: YYYY-MM-DDT23:59' \
  'schema_version: 3' \
  'session_date' \
  'previous_day_date' \
  'normalization_authority' \
  'report_revision' \
  'task_generation_status' \
  'task_generation_reason' \
  'task_generation_references' \
  'V2 Compatibility' \
  'derived-only V3 closure overlay' \
  'HH:MM' \
  'V2-only' \
  'check-ins.trends.md' \
  'For `detailed-private`, local `check-ins.csv`' \
  'source_session_date + source_plan_item_id' \
  'One exact `owner-approved` write' \
  'Interpreted Input' \
  'canonical fields take precedence' \
  'Task: create' \
  'Task: skip' \
  'Task title' \
  'Task bucket: <6d/do|6d/defer|6d/delegate|6d/delete|6d/dump>' \
  'legacy `5d/*` input is read-compatible and normalizes to the matching 6D tag' \
  'routine_completion_percent' \
  'actual_training_performed' \
  'actual_nsdr_performed' \
  'previous_day_actual_training_doms' \
  'previous_day_actual_training_pain' \
  'previous_day_actual_training_performance' \
  'planned_training_approximate' \
  'previous_day_actual_training_approximate' \
  'planned_nsdr_approximate' \
  'previous_day_actual_nsdr_approximate' \
  'planned_if_approximate' \
  'previous_day_actual_if_approximate' \
  'actual_self_count' \
  'actual_close_people_count' \
  'reflection_plus_one' \
  'reflection_redundant' \
  'V3.1 Priorities, Minimum Day, And Overload' \
  'WIG plan_item_id' \
  'WIG definition of done' \
  'must_do_plan_item_ids' \
  'plan_readiness' \
  'overload_status' \
  'overload_acknowledged' \
  'private_index_policy' \
  'detailed-private' \
  'redacted' \
  'source_status: unverified'
do
  require_ref ".systems/ai/core/personal-ops.md" "$term" "$term"
done

for term in \
  '--status-only' \
  '--dry-run' \
  'SYNC_THRESHOLD = 7' \
  'daily_files' \
  'personal-ops/check-ins' \
  'check-ins.csv' \
  'check-ins.jsonl' \
  'check-ins.metrics.csv' \
  'check-ins.trends.md' \
  'check-ins-fields.md' \
  'check-ins.md' \
  'Malformed check-in Markdown' \
  'unmapped_fields' \
  'write_indexes' \
  'never rewrites daily Markdown' \
  'build_v3_session' \
  'merge_v3_sessions' \
  'v3_normalize_range' \
  'v3_closure' \
  'schema_version' \
  'normalize_missing' \
  'interpreted_input' \
  'routine_completion_percent' \
  'actual_training_performed' \
  'actual_nsdr_performed' \
  'reflection_plus_one' \
  'v3_priority_state' \
  'v3_minimum_day_status' \
  'private_index_policy' \
  'redacted_v3_payload' \
  'index_contract'
do
  require_ref ".systems/scripts/sync-personal-ops-check-ins" "$term" "sync tool term $term"
done

for sync_field in \
  'last-synced-at' \
  'last-synced-check-in-count' \
  'current-check-in-count' \
  'unsynced-check-in-count' \
  'sync-recommendation-threshold: 7' \
  'last-sync-source' \
  'latest-unsynced-dates'
do
  require_ref ".systems/ai/templates/workspace/personal-ops/check-ins-index.template.md" "$sync_field" "sync state field $sync_field"
  require_ref ".systems/scripts/map-notion-check-ins" "$sync_field" "notion mapper sync state field $sync_field"
  require_ref ".systems/scripts/sync-personal-ops-check-ins" "${sync_field%%:*}" "sync script state field $sync_field"
done

for column in \
  'date' \
  'file_path' \
  'source_provider' \
  'minimum_day_done' \
  'day_mode' \
  'sleep_hours' \
  'if_hours' \
  'training_minutes' \
  'nsdr_minutes' \
  'habit_count_done' \
  'habit_count_total' \
  'has_plus_one' \
  'has_threat' \
  'has_built' \
  'has_delivered' \
  'has_promoted' \
  'has_body_action' \
  'has_spirit_action' \
  'has_close_people_action' \
  'has_gratitude' \
  'has_redundant' \
  'attachment_count' \
  'ocr_count' \
  'screenshot_count' \
  'note_image_count'
do
  require_ref ".systems/ai/core/personal-ops.md" "$column" "required index column $column"
  require_ref ".systems/scripts/map-notion-check-ins" "$column" "script index column $column"
done

for section in \
  'schema_version: 3' \
  'index_contract: 3' \
  'properties:' \
  'planned_items_json:' \
  'previous_day_actual_items_json:' \
  'previous_day_actual_training_doms:' \
  'previous_day_actual_training_pain:' \
  'previous_day_actual_training_performance:' \
  'planned_training_approximate:' \
  'previous_day_actual_training_approximate:' \
  'planned_nsdr_approximate:' \
  'previous_day_actual_nsdr_approximate:' \
  'planned_if_approximate:' \
  'task_generation_references_json:' \
  'previous_day_actual_if_approximate:' \
  'attachments_json:' \
  'ocr_entries_json:' \
  'session_date:' \
  'previous_day_date:' \
  '## Interpreted Check-In' \
  '## Lekcja dnia' \
  '## OCR / Notatka robocza' \
  '## Dodatkowe informacje' \
  '## Załączniki' \
  '## Raw Check-In' \
  'remaining professional entries default to `6d/dump`' \
  'private-sensitive context-as-data'
do
  require_ref ".systems/ai/templates/workspace/personal-ops/check-in.template.md" "$section" "check-in section $section"
done

for profile_term in \
  'Properties + Raw Audit v3' \
  'properties' \
  'Raw Check-In' \
  'OCR / Notatka robocza' \
  'Explicit normalized values supplied by the owner win' \
  'sync-personal-ops-check-ins-v3' \
  'seven new reports' \
  'Kandydaci na taski' \
  'planned_items_json'
do
  require_ref ".systems/ai/templates/workspace/personal-ops/manual-daily-check-in.template.md" "$profile_term" "manual profile term $profile_term"
done

for term in \
  'check-in-properties-v3.schema.json' \
  'index_contract: 3' \
  'check-ins-v3.csv' \
  'check-ins-v3.jsonl' \
  'check-ins-v3.metrics.csv' \
  'check-ins-v3.trends.md' \
  'Raw Check-In' \
  'OCR / Notatka robocza' \
  'sole source' \
  'Kandydaci na taski' \
  'planned_items_json'
do
  require_ref ".systems/ai/core/personal-ops.md" "$term" "properties v3 contract $term"
done

for term in \
  'index_contract' \
  'properties' \
  'check-ins-v3.csv' \
  'check-ins-v3.jsonl' \
  'check-ins-v3.metrics.csv' \
  'check-ins-v3.trends.md' \
  'SYNC_THRESHOLD = 7' \
  'write_atomic'
do
  require_ref ".systems/scripts/sync-personal-ops-check-ins-v3" "$term" "properties v3 sync term $term"
done

for term in 'Missing required properties' 'Unknown properties' 'Property' 'must be'; do
  require_ref ".systems/scripts/personal_ops_properties_v3.py" "$term" "properties v3 parser term $term"
done

require_ref ".systems/ai/templates/workspace/personal-ops/check-ins-v3-index.template.md" 'check-ins-v3.csv' "v3 index router CSV"
require_ref ".systems/ai/templates/workspace/personal-ops/check-ins-v3-index.template.md" 'sync-recommendation-threshold: 7' "v3 index lazy threshold"

require_ref ".systems/ai/templates/workspace/personal-ops/check-in-settings.local.template.md" 'timezone:' "local check-in settings timezone"
require_ref ".systems/ai/templates/workspace/personal-ops/check-in-settings.local.template.md" 'private_index_policy_default:' "local check-in settings privacy policy"
require_ref ".systems/ai/templates/workspace/tasks/taskforge-vault.local.template.md" 'vault_path:' "local TaskForge vault path"
require_ref ".systems/ai/templates/workspace/tasks/taskforge-vault.local.template.md" 'enabled:' "local TaskForge vault enabled flag"

for file in \
  ".systems/ai/core/operating-model.md" \
  ".systems/ai/core/workspaces.md" \
  ".systems/ai/core/command-routing.md" \
  ".systems/ai/core/integrations.md" \
  ".systems/ai/core/context-as-data.md" \
  ".systems/ai/templates/root/AGENTS.template.md" \
  ".systems/scripts/init-workspace" \
  ".systems/scripts/update-workspace" \
  "README.md" \
  "HUMANS.md"
do
  require_ref "$file" 'personal-ops' "personal-ops guidance"
done

for file in \
  ".systems/ai/core/operating-model.md" \
  ".systems/ai/core/command-routing.md" \
  ".systems/ai/core/integrations.md" \
  ".systems/ai/templates/root/AGENTS.template.md" \
  "README.md" \
  "HUMANS.md"
do
  require_ref "$file" 'sync-personal-ops-check-ins' "lazy sync guidance"
done

require_ref ".systems/scripts/validate-ai-system" 'check-personal-ops' "validator chain"
require_ref ".systems/scripts/check-required-artifacts" 'check-personal-ops' "required artifact list"
require_ref ".systems/scripts/check-validator-smoke-tests" 'map-notion-check-ins' "smoke coverage"
require_ref ".systems/scripts/check-validator-smoke-tests" 'sync-personal-ops-check-ins' "lazy sync smoke coverage"
require_ref ".systems/scripts/check-validator-smoke-tests" 'propose-task-candidates' "task candidate smoke coverage"

exit "$fail"
