#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fail=0

require_file() {
  local path="$1"
  if [[ ! -f "$repo_root/$path" ]]; then
    echo "Missing Personal Ops artifact: $path"
    fail=1
  fi
}

require_executable() {
  local path="$1"
  require_file "$path"
  if [[ -f "$repo_root/$path" && ! -x "$repo_root/$path" ]]; then
    echo "Personal Ops artifact is not executable: $path"
    fail=1
  fi
}

require_ref() {
  local file="$1"
  local term="$2"
  if [[ ! -f "$repo_root/$file" ]] || ! rg -F -q -- "$term" "$repo_root/$file"; then
    echo "Missing Personal Ops reference '$term' in $file"
    fail=1
  fi
}

required_files=(
  ".systems/ai/core/personal-ops.md"
  ".systems/ai/templates/workspace/personal-ops/README.md"
  ".systems/ai/templates/workspace/personal-ops/personal-ops-readme.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-ins-readme.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-ins-v3-index.template.md"
  ".systems/ai/templates/workspace/personal-ops/manual-daily-check-in.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-in.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-in-properties-v3.schema.json"
  ".systems/ai/templates/workspace/personal-ops/check-in-settings.local.template.md"
  ".systems/scripts/check-personal-ops"
  ".systems/scripts/personal_ops_properties_v3.py"
  ".systems/scripts/sync-personal-ops-check-ins-v3"
  ".systems/scripts/migrate-personal-ops-legacy-check-ins-v3"
  ".systems/scripts/sync-personal-ops-check-ins"
  ".systems/scripts/map-notion-check-ins"
)

for path in "${required_files[@]}"; do require_file "$path"; done
for path in \
  ".systems/scripts/check-personal-ops" \
  ".systems/scripts/sync-personal-ops-check-ins-v3" \
  ".systems/scripts/migrate-personal-ops-legacy-check-ins-v3" \
  ".systems/scripts/sync-personal-ops-check-ins" \
  ".systems/scripts/map-notion-check-ins"
do
  require_executable "$path"
done

if [[ -e "$repo_root/.systems/ai/templates/workspace/personal-ops/check-ins-index.template.md" ]]; then
  echo "Retired V2 index template remains active"
  fail=1
fi

for term in \
  'Properties + Raw Audit V3' \
  'task_generation_policy: deadline-aware-6d-v1' \
  'definition_of_done' \
  'task_bucket' \
  'deadline defaults to `6d/do`' \
  'no deadline defaults to `6d/defer`' \
  'legacy-normalized-v3.jsonl' \
  'manifest.json' \
  'import-report.md' \
  'immutable' \
  'legacy-v2-one-time-migration' \
  'legacy_minimum_day_done' \
  'Pre-contract V3 reports are source-only' \
  'never creates retrospective TaskNotes' \
  'check-ins-v3.trends.md' \
  'sync-personal-ops-check-ins-v3' \
  'migrate-personal-ops-legacy-check-ins-v3' \
  'map-notion-check-ins` are retired'
do
  require_ref ".systems/ai/core/personal-ops.md" "$term"
done

for term in \
  'load_legacy_snapshot' \
  'legacy_metadata' \
  'source hash mismatch' \
  'Duplicate effective session_date' \
  'check-ins-v3.trends.md' \
  'current-native-check-in-count' \
  'current-legacy-check-in-count' \
  'last-synced-native-check-in-count' \
  'unsynced-native-check-in-count'
do
  require_ref ".systems/scripts/sync-personal-ops-check-ins-v3" "$term"
done

for term in \
  'legacy-normalized-v3.jsonl' \
  'archive/indexes/v2' \
  '--owner-approved' \
  'never creates retrospective TaskNotes' \
  '2026-05-19'
do
  require_ref ".systems/scripts/migrate-personal-ops-legacy-check-ins-v3" "$term"
done

for term in \
  'last-synced-native-check-in-count' \
  'unsynced-native-check-in-count' \
  'compatibility alias'
do
  require_ref ".systems/ai/templates/workspace/personal-ops/check-ins-v3-index.template.md" "$term"
done

for retired in \
  ".systems/scripts/sync-personal-ops-check-ins" \
  ".systems/scripts/map-notion-check-ins"
do
  if ! "$repo_root/$retired" --workspace /tmp/personal-ops-retired-smoke >/tmp/personal-ops-retired.out 2>&1; then
    if ! rg -F -q 'STOP:' /tmp/personal-ops-retired.out; then
      echo "Retired command did not emit STOP: $retired"
      fail=1
    fi
  else
    echo "Retired command unexpectedly succeeded: $retired"
    fail=1
  fi
done

for file in \
  ".systems/ai/core/operating-model.md" \
  ".systems/ai/core/command-routing.md" \
  ".systems/ai/core/integrations.md" \
  ".systems/ai/core/dreaming-mode.md" \
  ".systems/ai/templates/root/AGENTS.template.md" \
  "README.md" \
  "HUMANS.md"
do
  require_ref "$file" 'check-ins-v3'
  require_ref "$file" 'retired'
done

exit "$fail"
