#!/usr/bin/env bash
set -euo pipefail

dry_run=0
skip_validation=0
remote_arg=""
branch_arg=""

usage() {
  cat <<'EOF'
Usage: .systems/scripts/update-from-upstream [options]

Options:
  --dry-run              classify paths and print planned update without fetching or merging
  --remote <name>        remote to fetch from (default: upstream tracking remote or origin)
  --branch <name>        branch to merge (default: upstream tracking branch or main)
  --skip-validation      skip post-update validators; unsafe for final PASS
  -h, --help             show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    --remote)
      remote_arg="${2:-}"
      [[ -n "$remote_arg" ]] || { echo "Missing value for --remote"; exit 2; }
      shift 2
      ;;
    --branch)
      branch_arg="${2:-}"
      [[ -n "$branch_arg" ]] || { echo "Missing value for --branch"; exit 2; }
      shift 2
      ;;
    --skip-validation)
      skip_validation=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ai_system_home="$(cd "$script_dir/../.." && pwd -P)"
source "$script_dir/lib-workspaces"
cd "$ai_system_home"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "STOP: AI_SYSTEM_HOME is not a git worktree: $ai_system_home"
  exit 1
fi

repo_root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"
if [[ "$repo_root" != "$ai_system_home" ]]; then
  echo "STOP: update-from-upstream must run from the ai-system repository root."
  echo "Expected AI_SYSTEM_HOME: $ai_system_home"
  echo "Git root: $repo_root"
  exit 1
fi

remote="$remote_arg"
branch="$branch_arg"
if [[ -z "$remote" || -z "$branch" ]]; then
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$upstream" && "$upstream" == */* ]]; then
    [[ -n "$remote" ]] || remote="${upstream%%/*}"
    [[ -n "$branch" ]] || branch="${upstream#*/}"
  fi
fi
remote="${remote:-origin}"
branch="${branch:-main}"
target_ref="$remote/$branch"

workspace_home="${AI_SYSTEM_WORKSPACE_HOME:-}"
if [[ -z "$workspace_home" ]]; then
  default_workspaces=()
  registry_file="$(ai_system_workspace_registry_file "$ai_system_home")"
  while IFS= read -r default_workspace; do
    default_workspaces+=("$default_workspace")
  done < <(ai_system_workspace_registry_default_paths "$ai_system_home")
  if [[ "${#default_workspaces[@]}" -gt 1 ]]; then
    echo "STOP: multiple default workspaces in ai-system-workspaces.md"
    exit 1
  elif [[ "${#default_workspaces[@]}" -eq 1 ]]; then
    workspace_home="${default_workspaces[0]}"
  elif [[ -f "$registry_file" ]]; then
    echo "STOP: ai-system-workspaces.md exists but no default=yes workspace is defined"
    exit 1
  else
    workspace_home="$ai_system_home/ai-system-workspace"
  fi
else
  workspace_home="$(ai_system_workspace_normalize_path "$ai_system_home" "$workspace_home")"
fi

protected_dirty=()
system_dirty=()
protected_roots=()

add_protected_root() {
  local root="$1"
  local normalized

  [[ -n "$root" ]] || return 0
  normalized="$(ai_system_workspace_normalize_path "$ai_system_home" "$root")"
  [[ -n "$normalized" ]] || return 0

  local existing
  if [[ "${#protected_roots[@]}" -gt 0 ]]; then
    for existing in "${protected_roots[@]}"; do
      [[ "$existing" == "$normalized" ]] && return 0
    done
  fi

  protected_roots+=("$normalized")
}

while IFS= read -r known_root; do
  add_protected_root "$known_root"
done < <(ai_system_workspace_known_local_roots "$ai_system_home")

while IFS= read -r registry_root; do
  add_protected_root "$registry_root"
done < <(ai_system_workspace_registry_paths "$ai_system_home")

add_protected_root "$workspace_home"

is_protected_path() {
  local path="${1#./}"
  local root
  local root_relative

  case "$path" in
    ai-system-workspaces.md)
      return 0
      ;;
  esac

  for root in "${protected_roots[@]}"; do
    [[ "$root" == "$ai_system_home/"* ]] || continue
    root_relative="${root#$ai_system_home/}"
    case "$path" in
      "$root_relative"|"$root_relative"/*)
        return 0
        ;;
    esac
  done

  return 1
}

classify_status_path() {
  local status="$1"
  local path="$2"

  [[ -n "$path" ]] || return 0

  if is_protected_path "$path"; then
    protected_dirty+=("$status $path")
  else
    system_dirty+=("$status $path")
  fi
}

print_update_workspace_followups() {
  local registry_rows=0
  local workspace_id
  local workspace_path
  local default_flag
  local workspace_status
  local scope
  local notes

  while IFS=$'\t' read -r workspace_id workspace_path default_flag workspace_status scope notes; do
    registry_rows=$((registry_rows + 1))
  done < <(ai_system_workspace_registry_rows "$ai_system_home")

  echo
  echo "Recommended workspace schema backfill:"
  echo ".systems/scripts/update-workspace --dry-run"
  echo ".systems/scripts/update-workspace"

  if [[ "$registry_rows" -gt 1 ]]; then
    echo
    echo "Multiple workspace rows detected. To backfill all active/paused existing workspaces:"
    echo ".systems/scripts/update-workspace --all --dry-run"
    echo ".systems/scripts/update-workspace --all"
  fi
}

if [[ -e "$workspace_home" ]]; then
  echo "AI_SYSTEM_WORKSPACE_HOME: $workspace_home"
  echo "Protected runtime workspace will not be touched by this updater."
else
  echo "AI_SYSTEM_WORKSPACE_HOME: $workspace_home (not found)"
  echo "Continuing because update-from-upstream only updates system-owned repository files."
fi

while IFS= read -r -d '' entry; do
  status="${entry:0:2}"
  path="${entry:3}"
  classify_status_path "$status" "$path"

  if [[ "$status" == R* || "$status" == C* ]]; then
    IFS= read -r -d '' old_path || true
    classify_status_path "$status" "$old_path"
  fi
done < <(git status --porcelain -z)

if [[ "${#protected_dirty[@]}" -gt 0 ]]; then
  echo "Protected local paths detected and excluded from update blockers:"
  printf ' - %s\n' "${protected_dirty[@]}"
fi

if [[ "${#system_dirty[@]}" -gt 0 ]]; then
  echo "STOP: system-owned files are dirty. Commit, stash, or discard these before update-from-upstream:"
  printf ' - %s\n' "${system_dirty[@]}"
  exit 1
fi

current_branch="$(git branch --show-current 2>/dev/null || true)"
current_branch="${current_branch:-HEAD}"

echo "AI_SYSTEM_HOME: $ai_system_home"
echo "Current branch: $current_branch"
echo "Update target: $target_ref"
echo "Protected runtime workspace: $workspace_home"
if [[ "${#protected_roots[@]}" -gt 0 ]]; then
  echo "Protected local roots:"
  for protected_root in "${protected_roots[@]}"; do
    echo " - $(ai_system_workspace_relative_path "$ai_system_home" "$protected_root")"
  done
fi

if [[ "$dry_run" -eq 1 ]]; then
  echo "Dry run only. No fetch, merge, or validation was performed."
  exit 0
fi

git fetch "$remote" "$branch"
git merge --ff-only FETCH_HEAD

if [[ "$skip_validation" -eq 1 ]]; then
  echo "WARNING: validation skipped. This update result is not eligible for final PASS."
else
  .systems/scripts/validate-ai-system --profile full
fi

echo "update-from-upstream completed."
print_update_workspace_followups
