#!/usr/bin/env python3
"""Preview/write a local client report only; never send."""
import argparse
import json
import sys
from work_evidence import EvidenceError, read_json, safe_path, require
from work_evidence_ledger import Ledger
from work_evidence_report import report, write_report

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("preview", "write"))
    parser.add_argument("--workspace", required=True)
    parser.add_argument("--policy", required=True)
    parser.add_argument("--expected-hash")
    parser.add_argument("--owner-approved", action="store_true")
    args = parser.parse_args()
    try:
        if args.action == "write":
            require(args.owner_approved, "owner-approval-required", "report")
        ledger = Ledger(args.workspace)
        policy = read_json(safe_path(ledger.workspace, args.policy))
        value = report(ledger, policy) if args.action == "preview" else write_report(
            ledger, policy, args.expected_hash, owner_approved=True)
        print(json.dumps(value, ensure_ascii=False, allow_nan=False))
        return 0
    except (EvidenceError, OSError, ValueError, TypeError, KeyError):
        error = sys.exc_info()[1]
        print(json.dumps({"state": "blocked", "category": error.category if isinstance(
            error, EvidenceError) else "invalid-or-unavailable-input"}), file=sys.stderr)
        return 2

if __name__ == "__main__":
    sys.exit(main())
