#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
source "$repo_root/.systems/scripts/lib-workspaces"
args=(--repo "$repo_root")
while IFS= read -r root; do
  [[ -n "$root" ]] && args+=(--prune "$root")
done < <(ai_system_workspace_known_local_roots "$repo_root")
while IFS= read -r root; do
  [[ -n "$root" ]] && args+=(--prune "$root")
done < <(ai_system_workspace_registry_paths "$repo_root")
if [[ -n "${AI_SYSTEM_WORKSPACE_HOME:-}" ]]; then
  workspace="$(ai_system_workspace_normalize_path "$repo_root" "$AI_SYSTEM_WORKSPACE_HOME")"
  args+=(--workspace "$workspace" --prune "$workspace")
fi
python3 -B "$repo_root/.systems/scripts/naming_check.py" "${args[@]}"
python3 -B "$repo_root/.systems/scripts/tests/test_naming.py"
