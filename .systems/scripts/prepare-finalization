#!/usr/bin/env python3
"""Read-only finalization preview from JSON stdin. Does not execute recorded text."""
import argparse,json,sys
from pathlib import Path
from finalization_support import preview
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--root',type=Path,required=True)
a=p.parse_args()
try:
    result=preview(json.load(sys.stdin),a.root)
    print(json.dumps(result,ensure_ascii=False,indent=2))
except (ValueError,OSError,KeyError,TypeError) as exc:
    print(json.dumps({'status':'blocked','reason':str(exc)}));sys.exit(2)
