#!/usr/bin/env python3
"""Audit or explicitly migrate one workspace's derived history to V4 generations."""

import argparse
import json
import sys
from pathlib import Path

from personal_ops_aggregates_v4 import migration, rollback


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", required=True, type=Path)
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--rollback", action="store_true")
    parser.add_argument("--owner-approved", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        if args.apply and args.rollback:
            raise ValueError("choose apply or rollback")
        if (args.apply or args.rollback) and not args.owner_approved:
            raise ValueError("aggregate migration/rollback writes require --owner-approved")
        workspace = args.workspace.resolve()
        result = rollback(workspace) if args.rollback else migration(workspace, args.apply)
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
        return 0
    except Exception as exc:
        print(f"STOP: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
