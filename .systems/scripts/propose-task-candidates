#!/usr/bin/env python3
"""Propose owner-approved TaskForge TaskNotes from AI System artifacts."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import sys
import unicodedata
from pathlib import Path

from personal_ops_properties_v3 import parse_frontmatter_and_properties, validate_properties


CHECK_IN_FIELDS = {
    "Zbudowałem": "built",
    "Dowiozłem": "delivered",
    "Wypromowałem": "promoted",
}

POLISH_REPLACEMENTS = {
    "ą": "a",
    "ć": "c",
    "ę": "e",
    "ł": "l",
    "ń": "n",
    "ó": "o",
    "ś": "s",
    "ż": "z",
    "ź": "z",
}

SIX_D = {
    "do": {"tag": "6d/do", "status": "open", "priority": "high"},
    "defer": {"tag": "6d/defer", "status": "planned", "priority": "normal"},
    "delegate": {"tag": "6d/delegate", "status": "waiting", "priority": "normal"},
    "delete": {"tag": "6d/delete", "status": "cancelled", "priority": "none"},
    "dump": {"tag": "6d/dump", "status": "open", "priority": "none"},
}

def apply_execution_classification(candidate: dict[str, object], bucket: str, tag: str = "") -> None:
    """Accept legacy/current bucket input but always emit current 6D task tags."""
    if bucket not in SIX_D:
        raise ValueError(f"Unsupported task bucket: {bucket}")
    explicit_tag = tag.strip().lower()
    if explicit_tag and not re.fullmatch(r"(?:5d|6d)/(?:do|defer|delegate|delete|dump)", explicit_tag):
        raise ValueError(f"Unsupported task tag: {tag}")
    candidate["status"] = SIX_D[bucket]["status"]
    candidate["priority"] = SIX_D[bucket]["priority"]
    candidate["tags"] = [SIX_D[bucket]["tag"]]
    candidate["task_method"] = "6d"
    candidate["execution_bucket"] = bucket


def normalize_task_bucket(value: object) -> str:
    """Normalize explicit 5D/6D input to one current 6D bucket."""
    raw = str(value or "").strip().lower()
    if not raw:
        return ""
    if raw.startswith(("5d/", "6d/")):
        raw = raw.split("/", 1)[1]
    raw = raw.replace(" ", "-")
    if raw not in SIX_D:
        raise ValueError(f"Unsupported task bucket: {value}")
    return raw


def normalize_deadline(value: object, session_date: str, item_id: str, source: Path) -> str:
    """Normalize a planned-item deadline without inventing a missing deadline."""
    raw = str(value or "").strip()
    if not raw:
        return ""
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", raw):
        try:
            dt.date.fromisoformat(raw)
        except ValueError as exc:
            raise ValueError(f"Invalid deadline for {item_id} in {source}: {raw}") from exc
        return f"{raw}T23:59"
    candidate = raw.replace(" ", "T", 1) if " " in raw and "T" not in raw else raw
    try:
        parsed = dt.datetime.fromisoformat(candidate.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError(f"Invalid deadline for {item_id} in {source}: {raw}") from exc
    if parsed.tzinfo is None:
        return parsed.isoformat(timespec="minutes" if parsed.second == 0 and parsed.microsecond == 0 else "seconds")
    return parsed.isoformat(timespec="minutes" if parsed.second == 0 and parsed.microsecond == 0 else "seconds")


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"Cannot read {path}: {exc}") from exc


def parse_frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 4)
    if end == -1:
        return {}
    values: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" not in line or line.startswith(" "):
            continue
        key, value = line.split(":", 1)
        values[key.strip()] = value.strip().strip('"')
    return values


def section_between(text: str, start: str, end_pattern: str) -> str:
    start_match = re.search(rf"^##\s+{re.escape(start)}\s*$", text, re.MULTILINE)
    if not start_match:
        return ""
    rest = text[start_match.end() :]
    end_match = re.search(end_pattern, rest, re.MULTILINE)
    return rest[: end_match.start()] if end_match else rest


def subsection_value(section: str, heading: str) -> str:
    match = re.search(rf"^###\s+{re.escape(heading)}\s*$", section, re.MULTILINE)
    if not match:
        return ""
    rest = section[match.end() :]
    end = re.search(r"^###\s+", rest, re.MULTILINE)
    value = rest[: end.start()] if end else rest
    lines = [line.rstrip() for line in value.strip().splitlines()]
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    return "\n".join(lines).strip()


def normalize_title(value: str) -> str:
    collapsed = re.sub(r"\s+", " ", value).strip(" -\t\n")
    collapsed = re.sub(r"^(zrobić|zrobic|do zrobienia|task)\s*[:\-]\s*", "", collapsed, flags=re.I)
    if not collapsed:
        return ""
    return collapsed[:110].rstrip()


def slugify(value: str) -> str:
    normalized = value.lower()
    for src, dst in POLISH_REPLACEMENTS.items():
        normalized = normalized.replace(src, dst)
    normalized = re.sub(r"[^a-z0-9]+", "-", normalized).strip("-")
    return normalized[:70] or "task"


def quote_yaml(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def fold_text(value: str) -> str:
    normalized = value.lower()
    for src, dst in POLISH_REPLACEMENTS.items():
        normalized = normalized.replace(src, dst)
    normalized = unicodedata.normalize("NFKD", normalized)
    return "".join(ch for ch in normalized if not unicodedata.combining(ch))


def match_tokens(value: str) -> list[str]:
    return re.findall(r"[a-z0-9]+", fold_text(value))


def label_matches(text_tokens: list[str], label: str) -> bool:
    label_tokens = match_tokens(label)
    if len("".join(label_tokens)) < 3:
        return False
    if not label_tokens or len(label_tokens) > len(text_tokens):
        return False
    width = len(label_tokens)
    return any(text_tokens[idx : idx + width] == label_tokens for idx in range(0, len(text_tokens) - width + 1))


def frontmatter_text(text: str) -> str:
    if not text.startswith("---\n"):
        return ""
    end = text.find("\n---", 4)
    return text[4:end] if end != -1 else ""


def wikilinks(value: str) -> list[str]:
    return [match.strip() for match in re.findall(r"\[\[([^\]]+)\]\]", value) if match.strip()]


def projects_from_frontmatter(text: str) -> list[str]:
    fm = frontmatter_text(text)
    if not fm:
        return []
    projects: list[str] = []
    in_projects = False
    for line in fm.splitlines():
        if not in_projects:
            match = re.match(r"^projects\s*:\s*(.*)$", line)
            if match:
                projects.extend(wikilinks(match.group(1)))
                in_projects = True
            continue
        if re.match(r"^[A-Za-z0-9_-]+\s*:", line):
            break
        stripped = line.strip()
        if stripped.startswith("-"):
            projects.extend(wikilinks(stripped))
    return sorted(set(projects))


def discover_labels(workspace: Path, task_vault: Path | None) -> dict[str, list[tuple[str, str]]]:
    labels: dict[str, list[tuple[str, str]]] = {"client": [], "owned_asset": [], "project_state": [], "taskforge_project": []}
    for key, rel in [("client", "clients"), ("owned_asset", "owned-assets"), ("project_state", "project-state")]:
        root = workspace / rel
        if root.is_dir():
            for child in root.iterdir():
                if child.is_dir() and not child.name.startswith("."):
                    labels[key].append((child.name, child.name))
    if task_vault:
        for path in task_vault.rglob("*.md"):
            if ".git" in path.parts:
                continue
            text = read_text(path)
            for project in projects_from_frontmatter(text):
                labels["taskforge_project"].append((project, project))
    return labels


def unique_match(text: str, labels: list[tuple[str, str]]) -> str:
    text_tokens = match_tokens(text)
    matches = sorted({value for needle, value in labels if needle and label_matches(text_tokens, needle)})
    return matches[0] if len(matches) == 1 else ""


def set_single_context(candidate: dict[str, object], value: str) -> None:
    candidate["contexts"] = [value]


def apply_mapping(candidate: dict[str, object], labels: dict[str, list[tuple[str, str]]]) -> None:
    text = f"{candidate.get('title', '')} {candidate.get('raw_value', '')}"
    client = unique_match(text, labels["client"])
    owned_asset = unique_match(text, labels["owned_asset"])
    project_state = unique_match(text, labels["project_state"])
    taskforge_project = unique_match(text, labels["taskforge_project"])
    if client:
        candidate["client"] = client
        candidate["owner_scope"] = "client"
        set_single_context(candidate, f"client/{client}")
    if owned_asset:
        candidate["owned_asset"] = owned_asset
        candidate["owner_scope"] = "owned-asset"
        set_single_context(candidate, f"owned-asset/{owned_asset}")
    if project_state:
        candidate["project_state"] = f"project-state/{project_state}/"
        candidate["project"] = project_state
        candidate["owner_scope"] = "project"
    if taskforge_project:
        candidate["projects"] = [f"[[{taskforge_project}]]"]
    if not any(candidate.get(key) for key in ("client", "owned_asset", "project", "project_state", "projects")):
        candidate["mapping_note"] = "Mapping requires review"


def candidates_from_check_in(path: Path, workspace: Path, labels: dict[str, list[tuple[str, str]]]) -> list[dict[str, object]]:
    text = read_text(path)
    fm = parse_frontmatter(text)
    if fm.get("index_contract") == "3":
        return candidates_from_index_v3_check_in(path, workspace, labels, text)
    if fm.get("schema_version") == "3":
        raise SystemExit(f"V3 check-ins require index_contract: 3 and the current properties contract: {path}")
    check_date = fm.get("date") or path.stem
    try:
        dt.date.fromisoformat(check_date)
    except ValueError as exc:
        raise SystemExit(f"Check-in date is missing or invalid for {path}") from exc
    plan = section_between(text, "1. Plan dnia", r"^##\s+2\.")
    candidates: list[dict[str, object]] = []
    for heading, source_key in CHECK_IN_FIELDS.items():
        value = subsection_value(plan, heading)
        title = normalize_title(value)
        if not title:
            continue
        candidate: dict[str, object] = {
            "type": "task",
            "title": title,
            "due": f"{check_date}T23:59",
            "scheduled": check_date,
            "contexts": [f"workspace/{workspace.name}"],
            "workspace": workspace.name,
            "owner_scope": "workspace",
            "client": "",
            "owned_asset": "",
            "project": "",
            "project_state": "",
            "source_system": "ai-system",
            "source_type": "check-in",
            "source_check_in_date": check_date,
            "source_check_in_field": heading,
            "source_path": str(path),
            "raw_value": value,
            "candidate_key": source_key,
        }
        apply_execution_classification(candidate, "do")
        apply_mapping(candidate, labels)
        candidates.append(candidate)
    return candidates


def candidates_from_index_v3_check_in(path: Path, workspace: Path, labels: dict[str, list[tuple[str, str]]], text: str) -> list[dict[str, object]]:
    """Create candidates from canonical properties only, never audit sections."""
    top, properties, _ = parse_frontmatter_and_properties(text, path)
    validate_properties(top, properties, path)
    session_date = str(properties["session_date"])
    try:
        dt.date.fromisoformat(session_date)
    except ValueError as exc:
        raise SystemExit(f"V3 session_date is missing or invalid for {path}") from exc
    try:
        items = json.loads(str(properties["planned_items_json"]))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Malformed V3 planned item JSON in {path}: {exc}") from exc
    if not isinstance(items, list):
        raise SystemExit(f"V3 planned_items_json must be a JSON array in {path}")
    item_ids = [str(item.get("id", "")).strip() for item in items if isinstance(item, dict)]
    if len(item_ids) != len(set(item_ids)):
        raise SystemExit(f"V3 planned_items_json has duplicate item IDs in {path}")
    if str(properties["task_generation_policy"]) != "deadline-aware-6d-v1":
        raise SystemExit(f"V3 requires task_generation_policy: deadline-aware-6d-v1 in {path}")

    candidates: list[dict[str, object]] = []
    for item in items:
        if not isinstance(item, dict):
            raise SystemExit(f"V3 planned_items_json contains a non-object item in {path}")
        item_id = str(item.get("id", "")).strip()
        stream = str(item.get("stream", "")).strip().lower()
        title = str(item.get("title", "")).strip()
        if not item_id or not title:
            raise SystemExit(f"V3 planned item requires id and title in {path}")
        if stream not in {"build", "deliver", "promote"}:
            continue
        try:
            deadline = normalize_deadline(item.get("deadline", ""), session_date, item_id, path)
            explicit_bucket = normalize_task_bucket(item.get("task_bucket", ""))
        except ValueError as exc:
            raise SystemExit(str(exc)) from exc
        bucket = explicit_bucket or ("do" if deadline else "defer")
        definition_of_done = str(item.get("definition_of_done", "")).strip()
        candidate: dict[str, object] = {
            "type": "task",
            "title": normalize_title(str(item.get("task_title", "")) or title),
            "due": deadline,
            "scheduled": "",
            "contexts": [f"workspace/{workspace.name}"],
            "workspace": workspace.name,
            "owner_scope": "workspace",
            "client": "",
            "owned_asset": "",
            "project": "",
            "project_state": "",
            "source_system": "ai-system",
            "source_type": "check-in-v3-properties",
            "source_session_date": session_date,
            "source_check_in_date": session_date,
            "source_check_in_field": stream,
            "source_plan_item_id": item_id,
            "source_path": str(path),
            "raw_value": title,
            "definition_of_done": definition_of_done,
            "candidate_key": f"{session_date}:{item_id}",
        }
        apply_execution_classification(candidate, bucket)
        apply_mapping(candidate, labels)
        candidates.append(candidate)
    return candidates


def execution_bucket_from_text(text: str) -> str:
    """Read legacy/new explicit tags but always emit a new 6D tag."""
    matches = {
        match.group("bucket")
        for match in re.finditer(r"(?<![a-z0-9])(?:5d|6d)/(?P<bucket>do|defer|delegate|delete|dump)(?![a-z0-9])", text.lower())
    }
    if len(matches) == 1:
        return matches.pop()
    return "defer"


def candidates_from_dream_report(path: Path, workspace: Path, labels: dict[str, list[tuple[str, str]]]) -> list[dict[str, object]]:
    text = read_text(path)
    in_queue = section_between(text, "Owner Decision Queue", r"^##\s+")
    candidates: list[dict[str, object]] = []
    for line in in_queue.splitlines():
        if not line.startswith("|") or "---" in line or "Priority" in line:
            continue
        cells = [cell.strip() for cell in line.strip("|").split("|")]
        if len(cells) < 5:
            continue
        priority, source_path, finding, proposed_target, owner_action = cells[:5]
        row_text = " ".join(cells)
        if "create-task" not in owner_action and "task" not in proposed_target.lower():
            continue
        execution_bucket = execution_bucket_from_text(row_text)
        title = normalize_title(finding)
        if not title:
            continue
        today = dt.date.today().isoformat()
        candidate: dict[str, object] = {
            "type": "task",
            "title": title,
            "due": "",
            "scheduled": "",
            "contexts": [f"workspace/{workspace.name}"],
            "workspace": workspace.name,
            "owner_scope": "workspace",
            "client": "",
            "owned_asset": "",
            "project": "",
            "project_state": "",
            "source_system": "ai-system",
            "source_type": "dream-report",
            "source_dream_report": str(path),
            "source_path": source_path,
            "source_dream_priority": priority,
            "raw_value": finding,
            "candidate_key": f"dream-{today}",
        }
        apply_execution_classification(candidate, execution_bucket)
        apply_mapping(candidate, labels)
        candidates.append(candidate)
    return candidates


def render_tasknote(candidate: dict[str, object]) -> str:
    lines = ["---"]
    scalar_fields = [
        "type",
        "title",
        "status",
        "priority",
        "due",
        "scheduled",
        "workspace",
        "owner_scope",
        "client",
        "owned_asset",
        "project",
        "project_state",
        "source_system",
        "source_type",
        "source_check_in_date",
        "source_check_in_field",
        "source_session_date",
        "source_plan_item_id",
        "source_dream_report",
        "source_dream_priority",
    ]
    for key in scalar_fields:
        if key in candidate:
            value = str(candidate.get(key) or "")
            lines.append(f"{key}: {quote_yaml(value) if value else ''}")
    for key in ("tags", "contexts", "projects"):
        values = candidate.get(key)
        if isinstance(values, list):
            lines.append(f"{key}:")
            for value in values:
                lines.append(f"  - {quote_yaml(str(value))}")
    lines.extend(["---", "", f"# {candidate['title']}", "", "## Outcome", "", str(candidate.get("raw_value", "")).strip(), ""])
    if candidate.get("definition_of_done"):
        lines.extend(["## Definition Of Done", "", str(candidate["definition_of_done"]).strip(), ""])
    lines.extend(["## Context", ""])
    lines.append(f"- Source type: `{candidate.get('source_type', '')}`")
    lines.append(f"- Source path: `{candidate.get('source_path', '')}`")
    if candidate.get("mapping_note"):
        lines.append(f"- {candidate['mapping_note']}")
    lines.extend(["", "## Next Action", "", "- [ ] Review and execute this task.", "", "## Evidence", "", "Generated from owner-approved AI System task candidate workflow.", "", "## Notes", ""])
    return "\n".join(lines).rstrip() + "\n"


def existing_task_keys(task_dir: Path) -> set[tuple[str, str]]:
    keys: set[tuple[str, str]] = set()
    for path in task_dir.glob("*.md"):
        frontmatter = parse_frontmatter(read_text(path))
        key = (frontmatter.get("source_session_date", ""), frontmatter.get("source_plan_item_id", ""))
        if all(key):
            keys.add(key)
    return keys


def task_token_similarity(left: str, right: str) -> float:
    left_tokens = set(match_tokens(left))
    right_tokens = set(match_tokens(right))
    if len(left_tokens) < 3 or len(right_tokens) < 3:
        return 0.0
    return len(left_tokens & right_tokens) / min(len(left_tokens), len(right_tokens))


def equivalent_label(left: str, right: str) -> bool:
    return bool(left and right and match_tokens(left) == match_tokens(right))


def candidate_project_labels(candidate: dict[str, object]) -> list[str]:
    labels = [str(candidate.get("project", "")).strip()]
    for value in candidate.get("projects", []):
        labels.extend(wikilinks(str(value)))
    return [label for label in labels if label]


def compatible_parent(candidate: dict[str, object], text: str) -> bool:
    frontmatter = parse_frontmatter(text)
    candidate_projects = candidate_project_labels(candidate)
    parent_projects = [frontmatter.get("project", "").strip(), *projects_from_frontmatter(text)]
    if candidate_projects and any(equivalent_label(candidate_project, parent_project) for candidate_project in candidate_projects for parent_project in parent_projects):
        return True
    candidate_client = str(candidate.get("client", "")).strip()
    parent_client = frontmatter.get("client", "").strip()
    return bool(candidate_client and parent_client and candidate_client == parent_client)


def find_similar_parent(candidate: dict[str, object], task_dir: Path) -> Path | None:
    matches: list[Path] = []
    for path in task_dir.glob("*.md"):
        text = read_text(path)
        frontmatter = parse_frontmatter(text)
        if frontmatter.get("status") in {"done", "cancelled"}:
            continue
        if not compatible_parent(candidate, text):
            continue
        if task_token_similarity(str(candidate.get("title", "")), frontmatter.get("title", "")) >= 0.75:
            matches.append(path)
    return matches[0] if len(matches) == 1 else None


def append_subtask(parent_path: Path, candidate: dict[str, object]) -> bool:
    marker = f"ai-system:v3:{candidate['source_session_date']}:{candidate['source_plan_item_id']}"
    text = read_text(parent_path)
    if marker in text:
        return False
    line = f"- [ ] {candidate['title']} <!-- {marker} -->"
    heading = re.search(r"^##\s+Subtasks\s*$", text, re.MULTILINE | re.IGNORECASE)
    if heading:
        insertion = heading.end()
        text = text[:insertion] + "\n\n" + line + text[insertion:]
    else:
        text = text.rstrip() + "\n\n## Subtasks\n\n" + line + "\n"
    parent_path.write_text(text, encoding="utf-8")
    return True


def write_candidates(candidates: list[dict[str, object]], task_vault: Path) -> tuple[list[Path], int, list[Path]]:
    task_dir = task_vault / "TaskNotes" / "Tasks"
    if not task_vault.is_dir():
        raise ValueError(f"--task-vault does not exist or is not a directory: {task_vault}")
    if not task_dir.is_dir():
        raise ValueError(f"--task-vault must already contain TaskNotes/Tasks/: {task_vault}")
    written: list[Path] = []
    skipped = 0
    extended: list[Path] = []
    existing = existing_task_keys(task_dir)
    for candidate in candidates:
        key = (str(candidate.get("source_session_date", "")), str(candidate.get("source_plan_item_id", "")))
        if all(key) and key in existing:
            skipped += 1
            continue
        parent = find_similar_parent(candidate, task_dir)
        if parent:
            if append_subtask(parent, candidate):
                extended.append(parent)
            else:
                skipped += 1
            if all(key):
                existing.add(key)
            continue
        source_date = str(candidate.get("source_session_date") or candidate.get("source_check_in_date") or dt.date.today().isoformat())
        base = f"{source_date}-{slugify(str(candidate['title']))}"
        path = task_dir / f"{base}.md"
        counter = 2
        while path.exists():
            path = task_dir / f"{base}-{counter}.md"
            counter += 1
        path.write_text(render_tasknote(candidate), encoding="utf-8")
        written.append(path)
        if all(key):
            existing.add(key)
    return written, skipped, extended


def task_vault_from_config(path: Path) -> Path:
    if not path.is_file():
        raise ValueError(f"TaskForge vault configuration is missing: {path}")
    values = parse_frontmatter(read_text(path))
    vault_path = values.get("vault_path", "")
    if values.get("enabled", "").lower() not in {"true", "yes"} or not vault_path:
        raise ValueError(f"TaskForge vault configuration is disabled or incomplete: {path}")
    return Path(vault_path).expanduser().resolve()


def task_vault_for_discovery(args: argparse.Namespace, config_path: Path) -> tuple[Path | None, str]:
    """Resolve an optional vault for read-only project discovery without blocking proposals."""
    try:
        task_vault = args.task_vault.resolve() if args.task_vault else task_vault_from_config(config_path)
        if not task_vault.is_dir():
            raise ValueError(f"TaskForge vault does not exist or is not a directory: {task_vault}")
        return task_vault, ""
    except ValueError as exc:
        return None, f"TaskForge project mapping unavailable: {exc}"


def set_frontmatter_scalar(text: str, key: str, value: str) -> str:
    if not text.startswith("---\n"):
        raise ValueError("Canonical check-in has no YAML frontmatter")
    end = text.find("\n---", 4)
    if end == -1:
        raise ValueError("Canonical check-in frontmatter is unterminated")
    frontmatter = text[4:end]
    line = f"{key}: {quote_yaml(value)}"
    pattern = re.compile(rf"^{re.escape(key)}\s*:\s*.*$", re.MULTILINE)
    if pattern.search(frontmatter):
        frontmatter = pattern.sub(line, frontmatter)
    else:
        frontmatter = frontmatter.rstrip() + "\n" + line
    return "---\n" + frontmatter + text[end:]


def update_v3_task_generation_status(path: Path, status: str, reason: str, references: list[Path], task_vault: Path | None) -> None:
    text = read_text(path)
    frontmatter = parse_frontmatter(text)
    if frontmatter.get("schema_version") != "3":
        return
    if frontmatter.get("index_contract") == "3":
        def set_property(content: str, key: str, value: str) -> str:
            pattern = re.compile(rf"^(  {re.escape(key)}:)[^\n]*$", re.MULTILINE)
            line = f'{key}: {quote_yaml(value)}'
            updated, count = pattern.subn(f"  {line}", content, count=1)
            if count != 1:
                raise ValueError(f"Missing V3 properties.{key} in {path}")
            return updated
        _, existing_properties, _ = parse_frontmatter_and_properties(text, path)
        text = set_property(text, "task_generation_status", status)
        text = set_property(text, "task_generation_reason", reason)
        reference_values: list[str] = []
        for reference in references:
            if task_vault:
                try:
                    reference_values.append(reference.relative_to(task_vault).as_posix())
                    continue
                except ValueError:
                    pass
            reference_values.append(str(reference))
        if status == "already-generated" and not reference_values:
            references_json = str(existing_properties["task_generation_references_json"])
        else:
            references_json = json.dumps(reference_values, ensure_ascii=False)
        text = set_property(text, "task_generation_references_json", references_json)
        path.write_text(text, encoding="utf-8")
        return
    reference_values: list[str] = []
    for reference in references:
        if task_vault:
            try:
                reference_values.append(reference.relative_to(task_vault).as_posix())
                continue
            except ValueError:
                pass
        reference_values.append(str(reference))
    updated = set_frontmatter_scalar(text, "task_generation_status", status)
    updated = set_frontmatter_scalar(updated, "task_generation_reason", reason)
    updated = set_frontmatter_scalar(updated, "task_generation_references", ", ".join(reference_values))
    path.write_text(updated, encoding="utf-8")


def task_preflight(args: argparse.Namespace, config_path: Path) -> tuple[Path | None, str]:
    try:
        task_vault = args.task_vault.resolve() if args.task_vault else task_vault_from_config(config_path)
        task_dir = task_vault / "TaskNotes" / "Tasks"
        if not task_vault.is_dir():
            raise ValueError(f"TaskForge vault does not exist or is not a directory: {task_vault}")
        if not task_dir.is_dir():
            raise ValueError(f"TaskForge vault must already contain TaskNotes/Tasks/: {task_vault}")
        return task_vault, ""
    except ValueError as exc:
        return None, str(exc)


def v3_task_generation_gate(path: Path) -> str:
    text = read_text(path)
    frontmatter = parse_frontmatter(text)
    if frontmatter.get("index_contract") == "3":
        top, properties, _ = parse_frontmatter_and_properties(text, path)
        validate_properties(top, properties, path)
        return ""
    if frontmatter.get("schema_version") == "3":
        return "V3 check-ins require index_contract: 3 and the current properties contract"
    return ""


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--check-in", type=Path, help="Canonical daily check-in Markdown file")
    source.add_argument("--dream-report", type=Path, help="Dream Report Markdown file")
    parser.add_argument("--workspace", type=Path, required=True, help="AI System workspace path")
    parser.add_argument("--task-vault", type=Path, help="TaskForge vault path")
    parser.add_argument("--task-vault-config", type=Path, help="Local-only TaskForge vault configuration")
    parser.add_argument("--write", action="store_true", help="Write TaskNotes instead of printing candidates")
    parser.add_argument("--owner-approved", action="store_true", help="Required for --write")
    parser.add_argument("--json", action="store_true", help="Print JSON instead of Markdown")
    args = parser.parse_args()

    workspace = args.workspace.resolve()
    config_path = args.task_vault_config or (workspace / "tasks" / "taskforge-vault.local.md")
    task_vault = args.task_vault.resolve() if args.task_vault else None
    if args.write and not args.owner_approved:
        raise SystemExit("--write requires --owner-approved")
    is_v3_check_in = False
    unsupported_v3_check_in = False
    task_generation_gate = ""
    if args.check_in:
        check_in_frontmatter = parse_frontmatter(read_text(args.check_in.resolve()))
        is_v3_check_in = check_in_frontmatter.get("index_contract") == "3"
        unsupported_v3_check_in = (
            check_in_frontmatter.get("schema_version") == "3" and not is_v3_check_in
        )
        if unsupported_v3_check_in:
            raise SystemExit(
                "V3 check-ins require index_contract: 3 and the current properties contract; "
                "migrate the report before task generation"
            )
        if is_v3_check_in:
            task_generation_gate = v3_task_generation_gate(args.check_in.resolve())
    if task_generation_gate:
        if args.write:
            update_v3_task_generation_status(args.check_in.resolve(), "skipped", task_generation_gate, [], None)
            print(f"Task generation skipped: {task_generation_gate}")
            return 0
        print(f"Task generation unavailable: {task_generation_gate}", file=sys.stderr)
    if args.write:
        task_vault, preflight_reason = task_preflight(args, config_path)
        if preflight_reason:
            if args.check_in and is_v3_check_in:
                update_v3_task_generation_status(args.check_in.resolve(), "skipped", preflight_reason, [], None)
                print(f"Task generation skipped: {preflight_reason}")
                return 0
            raise SystemExit(preflight_reason)
    else:
        task_vault, discovery_warning = task_vault_for_discovery(args, config_path)
        if discovery_warning:
            print(discovery_warning, file=sys.stderr)

    labels = discover_labels(workspace, task_vault)
    if args.check_in:
        candidates = candidates_from_check_in(args.check_in.resolve(), workspace, labels)
    else:
        candidates = candidates_from_dream_report(args.dream_report.resolve(), workspace, labels)

    if args.write:
        try:
            written, skipped, extended = write_candidates(candidates, task_vault)
        except ValueError as exc:
            if args.check_in and is_v3_check_in:
                update_v3_task_generation_status(args.check_in.resolve(), "skipped", str(exc), [], task_vault)
                print(f"Task generation skipped: {exc}")
                return 0
            raise SystemExit(str(exc)) from exc
        if args.check_in and is_v3_check_in:
            if written and extended:
                status = "created-and-subtasks"
            elif written:
                status = "created"
            elif extended:
                status = "subtasks-created"
            elif candidates:
                status = "already-generated"
            else:
                status = "no-candidates"
            update_v3_task_generation_status(
                args.check_in.resolve(),
                status,
                "TaskForge preflight passed; task generation completed.",
                [*written, *extended],
                task_vault,
            )
        print("Written TaskNotes:")
        for path in written:
            print(path)
        print(f"Skipped existing TaskNotes: {skipped}")
        print("Extended existing TaskNotes with subtasks:")
        for path in extended:
            print(path)
        return 0

    if args.json:
        print(json.dumps(candidates, indent=2, ensure_ascii=False))
    else:
        print("# TaskNote Candidates")
        print()
        print("Mode: dry-run")
        print("Writes performed: no")
        print()
        if not candidates:
            print("No task candidates.")
        for idx, candidate in enumerate(candidates, 1):
            print(f"## {idx}. {candidate['title']}")
            print()
            print(f"- status: `{candidate['status']}`")
            print(f"- priority: `{candidate['priority']}`")
            print(f"- tags: `{', '.join(candidate.get('tags', []))}`")
            print(f"- task method: `{candidate.get('task_method', 'none')}`")
            print(f"- execution bucket: `{candidate.get('execution_bucket', 'unclassified')}`")
            print(f"- contexts: `{', '.join(candidate.get('contexts', []))}`")
            print(f"- due: `{candidate.get('due', '')}`")
            print(f"- source: `{candidate.get('source_type', '')}` / `{candidate.get('source_path', '')}`")
            if candidate.get("mapping_note"):
                print(f"- mapping: `{candidate['mapping_note']}`")
            print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
