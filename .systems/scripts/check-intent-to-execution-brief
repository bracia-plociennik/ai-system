#!/usr/bin/env python3
"""Read-only intent capability inspection and offline synthetic checks."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
sys.dont_write_bytecode = True
from intent_brief import InvalidCapability, candidate, verify
ROOT=Path(__file__).resolve().parents[2]
PROFILE=ROOT/'.systems/ai/capabilities/workflow-intent-to-execution-brief-v1.json'
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--workflow-root',type=Path)
p.add_argument('--expected-head')
a=p.parse_args()
try:
    if a.workflow_root is not None or a.expected_head is not None:
        if not a.workflow_root or not a.expected_head:p.error('explicit Workflow root and accepted HEAD required together')
        print(json.dumps(verify(a.workflow_root,PROFILE,a.expected_head),sort_keys=True))
    else:
        # Structural checks do not select an installation or attest source/native support.
        for relative in ['.systems/ai/core/intent-to-execution-brief.md','.systems/ai/core/style-profile.md']:
            path=ROOT/relative
            if not path.is_file() or path.is_symlink():raise InvalidCapability('missing/linked local contract')
        for name in ['test_style_profile.py','test_intent_to_execution_brief.py']:
            r=subprocess.run([sys.executable,'-B',str(ROOT/'.systems/scripts/tests'/name)])
            if r.returncode:raise SystemExit(r.returncode)
        print('Intent brief checks completed; structural-only, native behavior/owner authority unverified')
except (InvalidCapability,OSError,TypeError,ValueError) as e:
    p.exit(1,'Intent capability rejected: '+str(e)+'\n')
