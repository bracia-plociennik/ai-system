#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fail=0

require_file() {
  local path="$1"
  if [[ ! -f "$repo_root/$path" ]]; then
    echo "Missing update-workspace artifact: $path"
    fail=1
  fi
}

require_executable() {
  local path="$1"
  require_file "$path"
  if [[ -f "$repo_root/$path" && ! -x "$repo_root/$path" ]]; then
    echo "Update-workspace artifact is not executable: $path"
    fail=1
  fi
}

require_ref() {
  local file="$1"
  local pattern="$2"
  local label="$3"

  if [[ ! -f "$repo_root/$file" ]]; then
    echo "Missing file for update-workspace check: $file"
    fail=1
    return 0
  fi

  if ! rg -q -- "$pattern" "$repo_root/$file"; then
    echo "Missing update-workspace reference in $file: $label"
    fail=1
  fi
}

required_files=(
  ".systems/ai/core/update-from-upstream.md"
  ".systems/ai/templates/workspace/core/workstreams.template.md"
  ".systems/ai/templates/workspace/links/links-readme.template.md"
  ".systems/ai/templates/workspace/project-state/project-state-readme.template.md"
  ".systems/ai/templates/workspace/project-state/project-state.template.md"
  ".systems/ai/templates/workspace/personal-ops/personal-ops-readme.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-ins-readme.template.md"
  ".systems/ai/templates/workspace/personal-ops/check-ins-index.template.md"
  ".systems/ai/templates/workspace/personal-ops/manual-daily-check-in.template.md"
  ".systems/scripts/check-update-workspace"
)

for path in "${required_files[@]}"; do
  require_file "$path"
done

require_executable ".systems/scripts/update-workspace"

required_script_terms=(
  "--workspace"
  "--workspace-profile"
  "--all"
  "--dry-run"
  "No existing workspace files were overwritten"
  "would create directory"
  "would create file"
  "kept existing file"
  "active|paused"
  "planned|archived"
  "prompting"
  "project-state"
  "personal-ops"
  "links"
)

for term in "${required_script_terms[@]}"; do
  require_ref ".systems/scripts/update-workspace" "$term" "$term"
done

for file in \
  ".systems/ai/core/update-from-upstream.md" \
  ".systems/ai/core/workspaces.md" \
  ".systems/ai/core/command-routing.md" \
  ".systems/ai/templates/root/AGENTS.template.md" \
  "README.md" \
  "HUMANS.md"
do
  require_ref "$file" 'update-workspace' "update-workspace guidance"
done

require_ref ".systems/scripts/init-workspace" 'core/workstreams\.template\.md' "init-workspace creates workstreams"
require_ref ".systems/scripts/init-workspace" 'links/README.md' "init-workspace creates links README"
require_ref ".systems/scripts/update-workspace" 'links/README.md' "update-workspace backfills links README"
require_ref ".systems/scripts/init-workspace" 'personal-ops/check-ins' "init-workspace creates personal-ops check-ins"
require_ref ".systems/scripts/init-workspace" 'personal-ops/check-ins/import-profiles' "init-workspace creates personal-ops import profiles"
require_ref ".systems/scripts/update-workspace" 'personal-ops/check-ins' "update-workspace backfills personal-ops check-ins"
require_ref ".systems/scripts/update-workspace" 'personal-ops/check-ins/import-profiles' "update-workspace backfills personal-ops import profiles"
require_ref ".systems/scripts/update-from-upstream" 'update-workspace --dry-run' "post-upstream dry-run recommendation"
require_ref ".systems/scripts/update-from-upstream" 'update-workspace --all --dry-run' "post-upstream all-workspaces dry-run recommendation"
require_ref ".systems/scripts/validate-ai-system" 'check-update-workspace' "validator chain"
require_ref ".systems/scripts/check-required-artifacts" 'check-update-workspace' "required artifact list"
require_ref ".systems/scripts/check-validator-smoke-tests" 'update-workspace' "smoke coverage"

exit "$fail"
