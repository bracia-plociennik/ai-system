#!/usr/bin/env python3
"""Synchronize index_contract: 3 Personal Ops reports into check-ins-v3.* only."""

from __future__ import annotations

import argparse
import csv
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
from datetime import date, timedelta
from pathlib import Path

from personal_ops_properties_v3 import (
    CURRENT_TASK_GENERATION_POLICY,
    HISTORICAL_NATIVE_CUTOFF,
    HISTORICAL_TASK_GENERATION_POLICY,
    PREVIOUS_TASK_GENERATION_POLICY,
    csv_value,
    decoded_json_properties,
    load_schema,
    parse_frontmatter_and_properties,
    project_historical_properties,
    redacted_properties,
    validate_property_map,
    validate_properties,
)


SYNC_THRESHOLD = 7


def daily_reports(workspace: Path, excluded_source_paths: set[str] | None = None) -> list[Path]:
    root = workspace / "personal-ops/check-ins"
    reports: list[Path] = []
    excluded_source_paths = excluded_source_paths or set()
    if not root.is_dir():
        return reports
    for path in sorted(root.glob("[0-9][0-9][0-9][0-9]/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md")):
        if path.relative_to(workspace).as_posix() in excluded_source_paths:
            continue
        text = path.read_text(encoding="utf-8")
        # Historical reports are outside this contract, even when malformed.
        if not re.search(r"^index_contract:\s*3\s*$", text, re.MULTILINE):
            continue
        top, _, _ = parse_frontmatter_and_properties(text, path)
        if str(top.get("index_contract", "")) == "3":
            reports.append(path)
    return reports


def load_native_records(workspace: Path, excluded_source_paths: set[str] | None = None) -> tuple[list[dict], list[dict]]:
    records: list[dict] = []
    session_dates: dict[str, Path] = {}
    schema_fields = load_schema()
    schema = {field["key"]: field for field in schema_fields}
    for path in daily_reports(workspace, excluded_source_paths):
        text = path.read_text(encoding="utf-8")
        top, properties, _ = parse_frontmatter_and_properties(text, path)
        policy = str(properties.get("task_generation_policy", ""))
        if policy in {CURRENT_TASK_GENERATION_POLICY, PREVIOUS_TASK_GENERATION_POLICY}:
            validate_properties(top, properties, path)
        elif policy == HISTORICAL_TASK_GENERATION_POLICY:
            try:
                session_date = date.fromisoformat(str(properties.get("session_date", "")))
            except ValueError as exc:
                raise ValueError(f"Historical native report has invalid session_date in {path}") from exc
            if session_date > HISTORICAL_NATIVE_CUTOFF:
                raise ValueError(f"Retired task_generation_policy is not allowed after {HISTORICAL_NATIVE_CUTOFF}: {path}")
            properties = project_historical_properties(properties, path)
            validate_properties(top, properties, path, historical=True)
        else:
            validate_properties(top, properties, path)
        expected_path = path.relative_to(workspace).as_posix()
        if properties["file_path"] != expected_path:
            raise ValueError(f"properties.file_path must equal {expected_path} in {path}")
        session_date = str(properties["session_date"])
        if session_date in session_dates:
            raise ValueError(
                f"Duplicate effective session_date {session_date} in {path} and {session_dates[session_date]}"
            )
        session_dates[session_date] = path
        effective = redacted_properties(properties, schema) if properties["private_index_policy"] == "redacted" else properties
        records.append({"path": path, "properties": effective, "full_properties": properties, "record_kind": "native"})
    return records, schema_fields


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def snapshot_paths(workspace: Path) -> tuple[Path, Path, Path]:
    root = workspace / "personal-ops/archive/check-ins-v3-migration"
    return root / "legacy-normalized-v3.jsonl", root / "manifest.json", root / "import-report.md"


def safe_workspace_source(workspace: Path, relative_path: str) -> Path:
    candidate = (workspace / relative_path).resolve()
    try:
        candidate.relative_to(workspace)
    except ValueError as exc:
        raise ValueError(f"Legacy snapshot source path escapes workspace: {relative_path}") from exc
    return candidate


def validate_legacy_metadata(metadata: object, workspace: Path, source: Path, schema_keys: set[str]) -> tuple[str, dict]:
    if not isinstance(metadata, dict):
        raise ValueError(f"Legacy snapshot metadata must be an object in {source}")
    origin = metadata.get("origin")
    if not isinstance(origin, dict):
        raise ValueError(f"Legacy snapshot metadata.origin must be an object in {source}")
    source_path = origin.get("source_path")
    source_sha = origin.get("source_sha256")
    if not isinstance(source_path, str) or not source_path:
        raise ValueError(f"Legacy snapshot source path is required in {source}")
    if not isinstance(source_sha, str) or not re.fullmatch(r"[0-9a-f]{64}", source_sha):
        raise ValueError(f"Legacy snapshot source SHA-256 is invalid in {source}")
    current_source = safe_workspace_source(workspace, source_path)
    if not current_source.is_file():
        raise ValueError(f"Legacy snapshot source is missing: {current_source}")
    if sha256_file(current_source) != source_sha:
        raise ValueError(f"Legacy snapshot source hash mismatch: {current_source}")
    confidence = metadata.get("field_confidence")
    if not isinstance(confidence, dict):
        raise ValueError(f"Legacy snapshot must provide confidence for every V3 property in {source}")
    extra_confidence = set(confidence) - schema_keys
    missing_confidence = schema_keys - set(confidence)
    if extra_confidence or missing_confidence - {"planned_do_count", "planned_defer_count", "planned_delegate_count", "planned_delete_count", "planned_dump_count", "planned_with_deadline_count", "planned_without_deadline_count", "planned_earliest_deadline", "planned_latest_deadline"}:
        raise ValueError(f"Legacy snapshot confidence keys drifted in {source}")
    projected_metadata = dict(metadata)
    projected_confidence = dict(confidence)
    for key in missing_confidence:
        projected_confidence[key] = "unknown"
    projected_metadata["field_confidence"] = projected_confidence
    projected_metadata["compatibility_projection"] = {
        "source_format_version": 1,
        "unknown_properties": sorted(missing_confidence),
    }
    if any(value not in {"direct", "derived", "unknown"} for value in confidence.values()):
        raise ValueError(f"Legacy snapshot confidence values must be direct, derived, or unknown in {source}")
    if not isinstance(metadata.get("unmapped_fields"), list):
        raise ValueError(f"Legacy snapshot unmapped_fields must be an array in {source}")
    legacy_minimum = metadata.get("legacy_minimum_day_done", "")
    if legacy_minimum not in {"", True, False}:
        raise ValueError(f"Legacy snapshot legacy_minimum_day_done must be boolean or empty in {source}")
    return source_path, projected_metadata


def load_legacy_snapshot(workspace: Path, schema_fields: list[dict]) -> list[dict]:
    snapshot, manifest_path, report_path = snapshot_paths(workspace)
    existing = [path for path in (snapshot, manifest_path, report_path) if path.exists()]
    if not existing:
        return []
    if len(existing) != 3:
        raise ValueError("Legacy V3 migration snapshot is incomplete; expected JSONL, manifest, and import report")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise ValueError(f"Malformed legacy snapshot manifest: {manifest_path}") from exc
    format_version = manifest.get("format_version")
    if manifest.get("format") != "personal-ops-legacy-normalized-v3" or format_version not in {1, 2}:
        raise ValueError(f"Unsupported legacy snapshot manifest: {manifest_path}")
    snapshot_hash = sha256_file(snapshot)
    if manifest.get("legacy_normalized_v3_sha256") != snapshot_hash:
        raise ValueError(f"Legacy snapshot hash mismatch: {snapshot}")

    schema_keys = {field["key"] for field in schema_fields}
    records: list[dict] = []
    dates: set[str] = set()
    for line_number, line in enumerate(snapshot.read_text(encoding="utf-8").splitlines(), start=1):
        if not line.strip():
            continue
        source = snapshot.with_name(f"{snapshot.name}:{line_number}")
        try:
            payload = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ValueError(f"Malformed legacy snapshot JSONL at line {line_number}") from exc
        if not isinstance(payload, dict) or set(payload) != {"properties", "legacy_metadata"}:
            raise ValueError(f"Legacy snapshot row must contain only properties and legacy_metadata at line {line_number}")
        properties = payload["properties"]
        if not isinstance(properties, dict):
            raise ValueError(f"Legacy snapshot properties must be an object at line {line_number}")
        if format_version == 1:
            properties = project_historical_properties(properties, source)
        else:
            validate_property_map(properties, source)
        if str(properties.get("index_contract")) != "3" or str(properties.get("schema_version")) != "3":
            raise ValueError(f"Legacy snapshot properties must use V3 at line {line_number}")
        source_type = str(properties.get("source_type", ""))
        if source_type != "legacy-v2-one-time-migration":
            raise ValueError(f"Unsupported legacy snapshot source_type at line {line_number}")
        session_date = str(properties.get("session_date", ""))
        if not session_date or session_date in dates:
            raise ValueError(f"Duplicate or missing legacy snapshot session_date at line {line_number}")
        if str(properties.get("report_id", "")) != session_date:
            raise ValueError(f"Legacy snapshot report_id must equal session_date at line {line_number}")
        try:
            expected_closure_date = (date.fromisoformat(session_date) - timedelta(days=1)).isoformat()
        except ValueError as exc:
            raise ValueError(f"Legacy snapshot session_date is invalid at line {line_number}") from exc
        if str(properties.get("closure_date", "")) != expected_closure_date:
            raise ValueError(f"Legacy snapshot closure_date must be the prior calendar day at line {line_number}")
        source_path, metadata = validate_legacy_metadata(payload["legacy_metadata"], workspace, source, schema_keys)
        if str(properties.get("file_path", "")) != source_path:
            raise ValueError(f"Legacy snapshot properties.file_path must equal origin source_path at line {line_number}")
        dates.add(session_date)
        effective = redacted_properties(properties, {field["key"]: field for field in schema_fields}) if properties["private_index_policy"] == "redacted" else properties
        records.append({"path": snapshot, "properties": effective, "full_properties": properties, "legacy_metadata": metadata, "record_kind": "legacy"})
    expected_count = manifest.get("record_count")
    if expected_count != len(records):
        raise ValueError(f"Legacy snapshot manifest record_count mismatch: expected {expected_count}, got {len(records)}")
    return records


def load_records(workspace: Path) -> tuple[list[dict], list[dict]]:
    schema_fields = load_schema()
    legacy_records = load_legacy_snapshot(workspace, schema_fields)
    legacy_source_paths = {
        str(record["legacy_metadata"]["origin"]["source_path"])
        for record in legacy_records
    }
    native_records, _ = load_native_records(workspace, legacy_source_paths)
    seen = {str(record["full_properties"]["session_date"]): record["path"] for record in native_records}
    for record in legacy_records:
        session_date = str(record["full_properties"]["session_date"])
        if session_date in seen:
            raise ValueError(f"Duplicate effective session_date {session_date} in legacy snapshot and {seen[session_date]}")
        seen[session_date] = record["path"]
    return sorted(native_records + legacy_records, key=lambda record: str(record["properties"]["session_date"])), schema_fields


def write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(handle, "w", encoding="utf-8", newline="") as out:
            out.write(content)
        Path(temp_name).replace(path)
    except Exception:
        Path(temp_name).unlink(missing_ok=True)
        raise


def render_csv(records: list[dict], fields: list[dict], metrics_only: bool = False) -> str:
    selected = [field for field in fields if not metrics_only or field.get("metric")]
    import io
    buffer = io.StringIO(newline="")
    writer = csv.DictWriter(buffer, fieldnames=[field["key"] for field in selected])
    writer.writeheader()
    for record in records:
        writer.writerow({field["key"]: csv_value(record["properties"][field["key"]]) for field in selected})
    return buffer.getvalue()


def render_jsonl(records: list[dict]) -> str:
    rows = []
    for record in records:
        payload = {"properties": decoded_json_properties(record["properties"])}
        if record["record_kind"] == "legacy":
            payload["legacy_metadata"] = record["legacy_metadata"]
        rows.append(json.dumps(payload, ensure_ascii=False, sort_keys=True))
    return "\n".join(rows) + ("\n" if rows else "")


def render_fields(fields: list[dict]) -> str:
    lines = ["# Check-Ins v3 Field Dictionary", "", "`check-ins-v3.csv` is generated directly from the canonical `properties` map. Do not edit it manually.", "", "| Column | Type | Default | Private | Metrics | Trends |", "| --- | --- | --- | --- | --- | --- |"]
    for field in fields:
        lines.append(f"| `{field['key']}` | `{field['type']}` | `{field.get('default', '')}` | `{str(bool(field.get('private'))).lower()}` | `{str(bool(field.get('metric'))).lower()}` | `{str(bool(field.get('trend'))).lower()}` |")
    return "\n".join(lines) + "\n"


def render_trends(records: list[dict], fields: list[dict]) -> str:
    records = [record for record in records if record["record_kind"] == "native"]
    trend_keys = [field["key"] for field in fields if field.get("trend")]
    dates = [str(record["properties"]["session_date"]) for record in records if record["properties"]["session_date"]]
    lines = ["# Check-Ins v3 Trends", "", "Sanitized derived summary for Dreaming Mode. It contains no raw input, OCR, finance, calories, health detail, attachment paths, reflections, lessons, or quotations.", "", f"report-count: {len(records)}", f"latest-session-date: {max(dates) if dates else ''}"]
    for key in trend_keys:
        values = [str(record["properties"][key]) for record in records if record["properties"][key] != ""]
        lines.append(f"{key}-observed-count: {len(values)}")
    return "\n".join(lines) + "\n"


def read_router_counts(router: Path) -> dict[str, int]:
    """Read total and native freshness baselines from the last official V3 sync."""
    counts = {
        "last-synced-check-in-count": 0,
        "last-synced-native-check-in-count": 0,
    }
    if not router.is_file():
        return counts
    for line in router.read_text(encoding="utf-8").splitlines():
        for key in counts:
            match = re.match(rf"^\s*(?:-\s+)?{re.escape(key)}:\s*(.*?)\s*$", line)
            if not match:
                continue
            try:
                counts[key] = int(match.group(1))
            except ValueError:
                counts[key] = 0
    return counts


def render_router(records: list[dict], source: str) -> str:
    native_count = sum(record["record_kind"] == "native" for record in records)
    legacy_count = sum(record["record_kind"] == "legacy" for record in records)
    current = len(records)
    return "\n".join([
        "# Check-Ins v3 Index", "", "Derived official V3 index. Native V3 reports and an owner-created immutable legacy snapshot may contribute rows; active V2 indexes are retired.", "",
        f"last-synced-at: {__import__('datetime').datetime.now().astimezone().isoformat(timespec='seconds')}",
        f"last-synced-check-in-count: {current}", f"last-synced-native-check-in-count: {native_count}", f"current-check-in-count: {current}", f"current-native-check-in-count: {native_count}", f"current-legacy-check-in-count: {legacy_count}", "unsynced-native-check-in-count: 0", "unsynced-check-in-count: 0",
        f"sync-recommendation-threshold: {SYNC_THRESHOLD}", f"last-sync-source: {source}",
        "", "- CSV: `check-ins-v3.csv`", "- JSONL: `check-ins-v3.jsonl`", "- Metrics: `check-ins-v3.metrics.csv`", "- Fields: `check-ins-v3-fields.md`", "- Sanitized trends: `check-ins-v3.trends.md`", "",
    ])


def write_index_set_atomic(outputs: dict[Path, str]) -> None:
    paths = list(outputs)
    if not paths:
        return
    index = paths[0].parent
    index.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=".check-ins-v3-stage.", dir=index))
    backup = Path(tempfile.mkdtemp(prefix=".check-ins-v3-backup.", dir=index))
    replaced: list[Path] = []
    try:
        for path, content in outputs.items():
            staged = stage / path.name
            staged.write_text(content, encoding="utf-8", newline="")
            if path.exists():
                shutil.copy2(path, backup / path.name)
        try:
            for path in paths:
                (stage / path.name).replace(path)
                replaced.append(path)
        except Exception:
            for path in replaced:
                previous = backup / path.name
                if previous.exists():
                    previous.replace(path)
                else:
                    path.unlink(missing_ok=True)
            raise
    finally:
        shutil.rmtree(stage, ignore_errors=True)
        shutil.rmtree(backup, ignore_errors=True)


def write_indexes(records: list[dict], fields: list[dict], workspace: Path, dry_run: bool, source: str) -> None:
    index = workspace / "personal-ops/indexes"
    outputs = {
        index / "check-ins-v3.csv": render_csv(records, fields),
        index / "check-ins-v3.jsonl": render_jsonl(records),
        index / "check-ins-v3.metrics.csv": render_csv(records, fields, metrics_only=True),
        index / "check-ins-v3-fields.md": render_fields(fields),
        index / "check-ins-v3.trends.md": render_trends(records, fields),
        index / "check-ins-v3.md": render_router(records, source),
    }
    if dry_run:
        for path in outputs:
            print(f"would write: {path}")
        return
    from personal_ops_aggregates_v4 import is_unified, writer_lock
    if source == "owner-approved-rollback":
        write_index_set_atomic(outputs)
        return
    with writer_lock(workspace):
        if is_unified(workspace):
            raise ValueError("V3 sync retired in unified workspace")
        write_index_set_atomic(outputs)


def print_status(records: list[dict], workspace: Path) -> None:
    router = workspace / "personal-ops/indexes/check-ins-v3.md"
    native_count = sum(record["record_kind"] == "native" for record in records)
    legacy_count = sum(record["record_kind"] == "legacy" for record in records)
    counts = read_router_counts(router)
    last_total = counts["last-synced-check-in-count"]
    last_native = counts["last-synced-native-check-in-count"]
    unsynced_native = max(0, native_count - last_native)
    print(f"current-check-in-count: {native_count + legacy_count}")
    print(f"current-native-check-in-count: {native_count}")
    print(f"current-legacy-check-in-count: {legacy_count}")
    print(f"last-synced-check-in-count: {last_total}")
    print(f"last-synced-native-check-in-count: {last_native}")
    print(f"unsynced-native-check-in-count: {unsynced_native}")
    print(f"unsynced-check-in-count: {unsynced_native}")
    print(f"sync-recommendation-threshold: {SYNC_THRESHOLD}")
    print("sync-recommendation: recommend sync" if unsynced_native >= SYNC_THRESHOLD else "sync-recommendation: not required yet")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", required=True, type=Path)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--status-only", action="store_true")
    parser.add_argument("--post-write", action="store_true", help="Mark this real refresh as required after a canonical check-in write")
    args = parser.parse_args()
    try:
        from personal_ops_aggregates_v4 import is_unified, read_generation
        if is_unified(args.workspace.resolve()):
            if args.status_only or args.dry_run:
                rows, _ = read_generation(args.workspace.resolve())
                print(f"unified-v4-record-count: {len(rows)}; V3 sync retired for this workspace")
                return 0
            raise ValueError("V3 sync retired in unified workspace; use sync-personal-ops-check-ins-v4")
        records, fields = load_records(args.workspace.resolve())
        if args.post_write and (args.status_only or args.dry_run):
            raise ValueError("--post-write requires a real index refresh, not --status-only or --dry-run")
        source = "post-write-check-in" if args.post_write else "owner-approved-sync"
        if args.status_only:
            print_status(records, args.workspace.resolve())
        elif args.dry_run:
            print_status(records, args.workspace.resolve())
            write_indexes(records, fields, args.workspace.resolve(), True, source)
        else:
            write_indexes(records, fields, args.workspace.resolve(), False, source)
    except Exception as exc:  # noqa: BLE001
        print(f"STOP: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
