#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
workspace=""
fail=0

usage() {
  echo "Usage: .systems/scripts/check-block-checkpoint [--workspace <path>]"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workspace)
      workspace="${2:-}"
      [[ -n "$workspace" ]] || { echo "Missing value for --workspace"; exit 2; }
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

require_file() {
  local path="$1"
  if [[ ! -f "$repo_root/$path" ]]; then
    echo "Missing block checkpoint artifact: $path"
    fail=1
  fi
}

require_ref() {
  local path="$1"
  local term="$2"
  if [[ ! -f "$repo_root/$path" ]] || ! rg -F -q -- "$term" "$repo_root/$path"; then
    echo "Missing block checkpoint reference '$term' in $path"
    fail=1
  fi
}

for path in \
  ".systems/ai/core/block-checkpoint.md" \
  ".systems/ai/templates/checkpoint/block-checkpoint.template.md" \
  ".systems/ai/templates/workspace/checkpoints/README.md" \
  ".systems/ai/templates/workspace/checkpoints/blocks/README.md" \
  ".systems/scripts/check-block-checkpoint" \
  ".systems/ai/core/command-routing.md" \
  ".systems/ai/core/response-contract.md" \
  ".systems/ai/core/project-state.md" \
  ".systems/ai/core/weekly-planning.md" \
  ".systems/scripts/init-workspace" \
  ".systems/scripts/update-workspace" \
  ".systems/scripts/check-required-artifacts" \
  ".systems/scripts/check-validator-smoke-tests" \
  ".systems/scripts/validate-ai-system"
do
  require_file "$path"
done

for term in \
  'checkpoint bloku' \
  'koniec bloku' \
  'checkpoint przed zmianą bloku' \
  'checkpoint_kind: block-boundary' \
  'schema_version: 1' \
  'last_completed_step' \
  'next_step' \
  'blocker' \
  'scope_fate' \
  'continue|defer|delegate|dump|stop' \
  'latest.md' \
  'Never overwrite' \
  'read-only summary' \
  'targeted'
do
  require_ref ".systems/ai/core/block-checkpoint.md" "$term"
done

if rg -n '^scope_fate:' "$repo_root/.systems/ai/core/block-checkpoint.md" | grep -vE 'scope_fate:\s*(continue\|defer\|delegate\|dump\|stop)' >/dev/null; then
  echo "Invalid scope_fate value in block checkpoint contract"
  fail=1
fi

for term in \
  'Last Completed Step' \
  'Next Step' \
  'Blocker' \
  'Scope Fate' \
  'Delivered / Unfinished' \
  'Evidence and Artifacts' \
  'Resume Context'
do
  require_ref ".systems/ai/templates/checkpoint/block-checkpoint.template.md" "$term"
done

for path in \
  ".systems/ai/core/command-routing.md" \
  ".systems/ai/core/operating-model.md" \
  ".systems/ai/core/project-state.md" \
  ".systems/ai/core/weekly-planning.md" \
  ".systems/ai/core/response-contract.md" \
  ".systems/ai/templates/root/AGENTS.template.md" \
  ".systems/scripts/README.md" \
  "README.md" \
  "HUMANS.md"
do
  require_ref "$path" 'block-checkpoint'
done

if rg -i -q -- 'block checkpoint.*(automatically|scheduler|daemon)|checkpoint.*(may|can|will) (write|create) (memory|tasknotes|distillation|project status)' \
  "$repo_root/.systems/ai/core/block-checkpoint.md" \
  "$repo_root/.systems/ai/templates/checkpoint/block-checkpoint.template.md"; then
  echo "Unsafe block checkpoint authority wording detected"
  fail=1
fi

if [[ -n "$workspace" ]]; then
  workspace="$(cd "$workspace" 2>/dev/null && pwd -P || true)"
  if [[ -z "$workspace" || ! -d "$workspace" ]]; then
    echo "Block checkpoint workspace does not exist: ${workspace:-unknown}"
    exit 1
  fi
  blocks_dir="$workspace/checkpoints/blocks"
  if [[ -d "$blocks_dir" ]]; then
    while IFS= read -r checkpoint; do
      [[ -n "$checkpoint" ]] || continue
      for field in schema_version checkpoint_kind checkpoint_id created_at timezone owner_scope workspace work_id block_id block_label block_date last_completed_step next_step blocker scope_fate delivered_scope unfinished_scope changed_artifacts evidence_paths resume_context resume_instruction; do
        if ! rg -q "^${field}:" "$checkpoint"; then
          echo "Block checkpoint missing '$field': $checkpoint"
          fail=1
        fi
      done
      if ! rg -q '^schema_version:\s*1\s*$' "$checkpoint"; then
        echo "Invalid block checkpoint schema version: $checkpoint"
        fail=1
      fi
      if ! rg -q '^checkpoint_kind:\s*block-boundary\s*$' "$checkpoint"; then
        echo "Invalid block checkpoint kind: $checkpoint"
        fail=1
      fi
      if ! rg -q '^scope_fate:\s*(continue|defer|delegate|dump|stop)\s*$' "$checkpoint"; then
        echo "Invalid block checkpoint scope fate: $checkpoint"
        fail=1
      fi
      filename="$(basename "$checkpoint")"
      if [[ ! "$filename" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}-[a-z0-9-]+(-r[0-9]+)?\.md$ ]]; then
        echo "Unsafe block checkpoint filename: $checkpoint"
        fail=1
      fi
    done < <(find "$blocks_dir" -maxdepth 1 -type f -name '*.md' ! -name 'README.md' ! -name 'latest.md' | sort)
    if [[ -f "$blocks_dir/latest.md" ]]; then
      for field in latest_checkpoint_id latest_checkpoint_path updated_at; do
        if ! rg -q "^${field}:" "$blocks_dir/latest.md"; then
          echo "Block checkpoint router missing '$field': $blocks_dir/latest.md"
          fail=1
        fi
      done
      latest_target="$(sed -n 's/^latest_checkpoint_path:[[:space:]]*//p' "$blocks_dir/latest.md" | head -n 1)"
      if [[ -z "$latest_target" || "$latest_target" == /* || "$latest_target" == *..* || ! -f "$blocks_dir/$latest_target" ]]; then
        echo "Invalid block checkpoint latest target: $blocks_dir/latest.md"
        fail=1
      fi
    fi
  fi
fi

exit "$fail"
