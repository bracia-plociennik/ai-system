#!/usr/bin/env python3
"""Offline startup/adapter conformance. Never starts a model or edits a user profile."""
from pathlib import Path
import argparse,os,subprocess,sys
from agent_context import source_consistency
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--workflow-source',type=Path)
args=parser.parse_args()
if args.workflow_source is not None:
    assert args.workflow_source.is_absolute() and not args.workflow_source.is_symlink()
    os.environ['ASA_WORKFLOW_SOURCE']=str(args.workflow_source)
root=Path(__file__).resolve().parents[2]
assert source_consistency(root,'agent-startup-v1.json','agent-startup-v1')=='verified-source'
for name in ('resolve-agent-context','manage-agent-adapter'):
    assert (root/'.systems/scripts'/name).stat().st_mode & 0o111
result=subprocess.run([sys.executable,'-B','-m','unittest','discover','-s',str(root/'.systems/scripts/tests'),'-p','test_agent_*.py'])
raise SystemExit(result.returncode)
