def normalize_slug(value: str) -> str:
    import unicodedata

    normalized = unicodedata.normalize("NFKD", value)
    ascii_value = "".join(ch for ch in normalized if not unicodedata.combining(ch))
    ascii_value = ascii_value.lower()
    ascii_value = re.sub(r"[^a-z0-9]+", "_", ascii_value).strip("_")
    return ascii_value or "value"


def parse_scalar(value: str):
    raw = value.strip()
    if raw == "":
        return ""
    if raw in {"true", "True"}:
        return True
    if raw in {"false", "False"}:
        return False
    if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return raw[1:-1]
    return raw


def parse_frontmatter(text: str, source: Path) -> tuple[dict, str]:
    if not text.startswith("---\n"):
        raise ValueError(f"Malformed check-in Markdown missing frontmatter: {source}")
    end = text.find("\n---\n", 4)
    if end == -1:
        raise ValueError(f"Malformed check-in Markdown missing closing frontmatter: {source}")
    raw_frontmatter = text[4:end]
    body = text[end + 5 :]
    frontmatter = {}
    for line in raw_frontmatter.splitlines():
        if not line.strip():
            continue
        if ":" not in line:
            raise ValueError(f"Malformed frontmatter line in {source}: {line}")
        key, value = line.split(":", 1)
        frontmatter[key.strip()] = parse_scalar(value)
    return frontmatter, body


def extract_sections(body: str) -> dict[str, dict[str, str]]:
    phases = {phase: {field: "" for field in fields} for phase, fields in PHASE_FIELDS.items()}
    current_phase = ""
    current_field = ""
    buffer: list[str] = []

    def flush() -> None:
        nonlocal buffer
        if current_phase and current_field:
            phases[current_phase][current_field] = "\n".join(buffer).strip()
        buffer = []

    for line in body.splitlines():
        if line.startswith("## "):
            flush()
            heading = line[3:].strip()
            current_phase = PHASE_HEADINGS.get(heading, "")
            current_field = ""
            continue
        if line.startswith("### "):
            flush()
            field = line[4:].strip()
            if current_phase and field in phases[current_phase]:
                current_field = field
            else:
                current_field = ""
            continue
        if current_phase and current_field:
            buffer.append(line)
    flush()
    return phases


def parse_datetime(value) -> datetime | None:
    if not value:
        return None
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.strptime(str(value), fmt)
        except ValueError:
            continue
    return None


def duration(start, end, unit: str) -> str:
    start_dt = parse_datetime(start)
    end_dt = parse_datetime(end)
    if not start_dt or not end_dt:
        return ""
    minutes = int((end_dt - start_dt).total_seconds() // 60)
    if minutes < 0:
        return ""
    if unit == "hours":
        return f"{minutes / 60:.2f}".rstrip("0").rstrip(".")
    return str(minutes)


def bool_value(value):
    raw = str(value).strip().lower()
    if raw in {"true", "yes", "tak", "1"}:
        return True
    if raw in {"false", "no", "nie", "0"}:
        return False
    return ""


def bool_text(value) -> str:
    parsed = bool_value(value)
    if parsed is True:
        return "true"
    if parsed is False:
        return "false"
    return ""


def attachment_kind(path: Path) -> str:
    suffix = path.suffix.lower()
    name = path.name.lower()
    if suffix == ".md" and ".ocr" in name:
        return "ocr"
    if suffix in {".png", ".jpg", ".jpeg", ".webp", ".gif"}:
        if "screenshot" in name or "screen" in name:
            return "screenshot"
        return "note_image"
    return "other"


def collect_attachments(markdown_path: Path) -> list[dict[str, str]]:
    assets_dir = markdown_path.with_suffix(".assets")
    if not assets_dir.is_dir():
        return []
    return [
        {"path": path.relative_to(markdown_path.parent).as_posix(), "kind": attachment_kind(path)}
        for path in sorted(item for item in assets_dir.iterdir() if item.is_file())
    ]


def attachment_counts(attachments: list[dict[str, str]]) -> dict[str, str]:
    return {
        "attachment_count": str(len(attachments)),
        "ocr_count": str(sum(1 for item in attachments if item["kind"] == "ocr")),
        "screenshot_count": str(sum(1 for item in attachments if item["kind"] == "screenshot")),
        "note_image_count": str(sum(1 for item in attachments if item["kind"] == "note_image")),
    }


def load_existing_unmapped(index_dir: Path) -> dict[tuple[str, str, str], dict]:
    jsonl_path = index_dir / "check-ins.jsonl"
    if not jsonl_path.is_file():
        return {}
    values: dict[tuple[str, str, str], dict] = {}
    with jsonl_path.open(encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            try:
                payload = json.loads(line)
            except json.JSONDecodeError:
                continue
            frontmatter = payload.get("frontmatter", {})
            key = (
                str(payload.get("date", "")),
                str(payload.get("file_path", "")),
                str(frontmatter.get("source_row_id", "")),
            )
            values[key] = payload.get("unmapped_fields", {}) or {}
    return values


def daily_files(workspace: Path) -> list[Path]:
    check_in_root = workspace / "personal-ops" / "check-ins"
    if not check_in_root.is_dir():
        return []
    pattern = re.compile(r"^\d{4}/\d{4}-\d{2}-\d{2}\.md$")
    return sorted(
        path
        for path in check_in_root.glob("*/*.md")
        if pattern.match(path.relative_to(check_in_root).as_posix())
    )


def historical_daily_files(workspace: Path) -> list[Path]:
    """Exclude Properties + Raw Audit reports from the V2/V3.1 index contract."""
    historical: list[Path] = []
    for path in daily_files(workspace):
        frontmatter, _ = parse_frontmatter(path.read_text(encoding="utf-8"), path)
        if str(frontmatter.get("index_contract", "")).strip() != "3":
            historical.append(path)
    return historical


def build_record(workspace: Path, markdown_path: Path, existing_unmapped: dict[tuple[str, str, str], dict]) -> dict:
    frontmatter, body = parse_frontmatter(markdown_path.read_text(encoding="utf-8"), markdown_path)
    phases = extract_sections(body)
    date_text = str(frontmatter.get("date", "")).strip()
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date_text):
        raise ValueError(f"Malformed check-in date in {markdown_path}: {date_text!r}")
    file_path = markdown_path.relative_to(workspace).as_posix()
    source_row_id = str(frontmatter.get("source_row_id", "")).strip()
    reflections = {
        "plus_one": phases["afternoon"].get("Co dało +1%", ""),
        "redundant": phases["afternoon"].get("Co było zbędne", ""),
        "threat": phases["morning"].get("Zagrożenie dnia", ""),
        "built": phases["day_plan"].get("Zbudowałem", ""),
        "delivered": phases["day_plan"].get("Dowiozłem", ""),
        "promoted": phases["day_plan"].get("Wypromowałem", ""),
        "gratitude": phases["morning"].get("Jestem wdzięczny", ""),
        "body": phases["day_plan"].get("Coś dla ciała", ""),
        "spirit": phases["day_plan"].get("Coś dla ducha", ""),
        "close_people": phases["day_plan"].get("Coś dla bliskich", ""),
        "habits_text": phases["afternoon"].get("Nawyki", ""),
        "additional": phases["additional"].get("Dodatkowe informacje", ""),
        "mantra": phases["morning"].get("Mantra", ""),
    }
    habits = []
    for phase_key, field, label in [
        ("morning", "Dwór", HABIT_FIELD_MAP["Dwór"]),
        ("day_plan", "NSDR od-do", HABIT_FIELD_MAP["NSDR od-do"]),
        ("morning", "Pobudka", HABIT_FIELD_MAP["Pobudka"]),
        ("morning", "Deep Focus", HABIT_FIELD_MAP["Deep Focus"]),
        ("morning", "Napiłem się", HABIT_FIELD_MAP["Napiłem się"]),
        ("morning", "Insta Story", HABIT_FIELD_MAP["Insta Story"]),
        ("morning", "Mama i Oliwia", HABIT_FIELD_MAP["Mama i Oliwia"]),
        ("morning", "Kuchnia", HABIT_FIELD_MAP["Kuchnia"]),
    ]:
        raw_value = phases[phase_key].get(field, "")
        habits.append(
            {
                "slug": normalize_slug(label),
                "label": label,
                "value": bool_value(raw_value),
                "raw_value": raw_value,
            }
        )
    key = (date_text, file_path, source_row_id)
    return {
        "date": date_text,
        "file_path": file_path,
        "frontmatter": frontmatter,
        "phases": phases,
        "habits": habits,
        "reflections": reflections,
        "attachments": collect_attachments(markdown_path),
        "unmapped_fields": existing_unmapped.get(key, {}),
    }


def normalize_missing(value: str) -> str:
    raw = str(value or "").strip()
    return "" if raw.lower() in {"", "brak", "nie podano", "nie dotyczy", "null", "n/a"} else raw


def v3_section(body: str, heading: str) -> str:
    pattern = re.compile(rf"^(?P<level>#+)\s+{re.escape(heading)}\s*$", re.MULTILINE)
    match = pattern.search(body)
    if not match:
        return ""
    level = len(match.group("level"))
    end = re.search(rf"^#{{1,{level}}}\s+", body[match.end() :], re.MULTILINE)
    stop = match.end() + end.start() if end else len(body)
    return body[match.end() : stop].strip()


def v3_scalar(text: str, *labels: str) -> str:
    for label in labels:
        match = re.search(rf"^[\s>*-]*{re.escape(label)}\s*:\s*(.+?)\s*$", text, re.IGNORECASE | re.MULTILINE)
        if match:
            return normalize_missing(match.group(1))
    return ""


def v3_items(section: str, stream: str) -> list[dict[str, str]]:
    items: list[dict[str, str]] = []
    matches = list(re.finditer(r"^\s*[-*]\s+\[(?P<id>[a-z][a-z0-9-]*)\]\s+(?P<title>.+?)\s*$", section, re.MULTILINE | re.IGNORECASE))
    for index, match in enumerate(matches):
        title = normalize_missing(match.group("title"))
        if title:
            block_end = matches[index + 1].start() if index + 1 < len(matches) else len(section)
            block = section[match.end() : block_end]
            items.append(
                {
                    "id": match.group("id"),
                    "title": title,
                    "stream": stream,
                    "task_policy": v3_scalar(block, "Task") or "create",
                    "task_title": v3_scalar(block, "Task title"),
                    "task_bucket": v3_scalar(block, "Task bucket"),
                }
            )
    return items


def v3_dynamic_habits(section: str) -> list[dict[str, str]]:
    """Read planned habits while accepting the pre-ID V3 draft shape."""
    habits: list[dict[str, str]] = []
    markers = list(re.finditer(r"^[-*]\s+(?P<label>Habit ID|Nazwa):\s*(?P<value>.*?)\s*$", section, re.MULTILINE | re.IGNORECASE))
    for index, marker in enumerate(markers, 1):
        block_end = markers[index].start() if index < len(markers) else len(section)
        block = section[marker.end() : block_end]
        rest = block
        label = marker.group("label").lower()
        first_value = marker.group("value")
        if label == "habit id":
            habit_id = normalize_missing(first_value)
            name = v3_scalar(block, "Nazwa")
        else:
            habit_id = f"habit-{index:02d}"
            name = normalize_missing(first_value)
        habits.append(
            {
                "id": habit_id,
                "name": name,
                "trigger": v3_scalar(rest, "Trigger"),
                "criterion": v3_scalar(rest, "Kryterium", "Warunek wykonania"),
                "planned_status": v3_scalar(rest, "Status") or "planned",
            }
        )
    return [habit for habit in habits if habit["id"] and habit["name"]]


def v3_actual_dynamic_habits(section: str) -> list[dict[str, str]]:
    habits: list[dict[str, str]] = []
    blocks = re.split(r"^\s*[-*]\s+Habit ID:\s*", section, flags=re.MULTILINE | re.IGNORECASE)
    for block in blocks[1:]:
        habit_id, _, rest = block.partition("\n")
        habit_id = normalize_missing(habit_id)
        status = v3_scalar(rest, "Status")
        if habit_id and status:
            habits.append({"habit_id": habit_id, "status": status, "note": v3_scalar(rest, "Note", "Uwagi")})
    return habits


def v3_comparisons(section: str) -> list[dict[str, str]]:
    comparisons: list[dict[str, str]] = []
    blocks = re.split(r"^\s*[-*]\s+plan_item_id:\s*", section, flags=re.MULTILINE)
    for block in blocks[1:]:
        plan_item_id, _, rest = block.partition("\n")
        comparisons.append(
            {
                "plan_item_id": normalize_missing(plan_item_id),
                "status": v3_scalar(rest, "status", "Status"),
                "actual_item_ids": v3_scalar(rest, "actual_item_ids", "Actual item IDs"),
                "owner_approved": bool_text(v3_scalar(rest, "owner-approved", "Owner approved")),
                "note": v3_scalar(rest, "note", "Uwagi"),
            }
        )
    return [comparison for comparison in comparisons if comparison["plan_item_id"]]


def v3_priority_state(plan: str, plan_items: list[dict[str, str]], frontmatter: dict[str, str]) -> dict[str, object]:
    """Derive V3.1 priorities from canonical plan content without rewriting it."""
    section = v3_section(plan, "Priorytety dnia")
    fields = (
        "wig_plan_item_id", "wig_definition_of_done", "must_do_plan_item_ids",
        "overload_acknowledged", "plan_readiness", "overload_status",
    )
    is_v31 = bool(section.strip()) or any(str(frontmatter.get(field, "")).strip() for field in fields)
    if not is_v31:
        return {
            "is_v31": False,
            "plan_readiness": "legacy-v3-no-wig",
            "overload_status": "none",
            "overload_reasons": [],
            "overload_acknowledged": "false",
            "wig_plan_item_id": "",
            "wig_definition_of_done": "",
            "must_do_plan_item_ids": [],
            "task_candidate_eligible_count": 0,
            "eligible_plan_item_ids": [],
        }

    def values(label: str, field: str) -> list[str]:
        matches = re.findall(rf"^\s*[-*]\s+{re.escape(label)}:\s*(.*?)\s*$", section, re.MULTILINE | re.IGNORECASE)
        if matches:
            return [normalize_missing(match) for match in matches]
        return [normalize_missing(str(frontmatter.get(field, "")))]

    wig_values = values("WIG plan_item_id", "wig_plan_item_id")
    definition_values = values("WIG definition of done", "wig_definition_of_done")
    must_values = values("Must-do plan_item_ids", "must_do_plan_item_ids")
    acknowledged_values = values("Overload acknowledged", "overload_acknowledged")
    wig = wig_values[0] if len(wig_values) == 1 else ""
    definition = definition_values[0] if len(definition_values) == 1 else ""
    must_do = [
        value.strip()
        for raw in must_values
        for value in re.split(r"[,;]", raw)
        if value.strip()
    ]
    acknowledged = bool_text(acknowledged_values[0] if acknowledged_values else "")
    item_ids = {str(item.get("id", "")) for item in plan_items}
    professional_ids = {
        str(item.get("id", "")) for item in plan_items
        if item.get("stream") in {"build", "deliver", "promote"}
    }
    reasons: list[str] = []
    if len(wig_values) > 1:
        reasons.append("duplicate-wig")
    elif not wig:
        reasons.append("missing-wig")
    elif wig not in item_ids:
        reasons.append("invalid-wig")
    if not definition:
        reasons.append("missing-wig-definition-of-done")
    if len(must_do) > 2:
        reasons.append("too-many-must-do")
    if len(set(must_do)) != len(must_do):
        reasons.append("duplicate-must-do")
    if any(item_id not in item_ids for item_id in must_do):
        reasons.append("invalid-must-do")
    if wig and wig in must_do:
        reasons.append("wig-also-must-do")
    if len(professional_ids) > 3:
        reasons.append("too-many-professional-items")

    ready = bool(wig and wig in item_ids and definition)
    priority_ids = [item_id for item_id in [wig, *must_do] if item_id in professional_ids]
    eligible_ids = list(dict.fromkeys(priority_ids)) if ready else []
    overload_status = "warning" if reasons else "none"
    return {
        "is_v31": True,
        "plan_readiness": "ready" if ready else "needs-prioritization",
        "overload_status": overload_status,
        "overload_reasons": reasons,
        "overload_acknowledged": acknowledged,
        "wig_plan_item_id": wig,
        "wig_definition_of_done": definition,
        "must_do_plan_item_ids": must_do,
        "task_candidate_eligible_count": len(eligible_ids) if not (overload_status == "warning" and acknowledged != "true") else 0,
        "eligible_plan_item_ids": eligible_ids,
    }


def v3_minimum_day_status(priorities: dict[str, object], comparisons: list[dict[str, str]], has_closure: bool) -> str:
    if priorities.get("plan_readiness") == "legacy-v3-no-wig":
        return "not-defined"
    if priorities.get("plan_readiness") != "ready" or not has_closure:
        return "unknown"
    wig = str(priorities.get("wig_plan_item_id", ""))
    comparison = next((item for item in comparisons if item.get("plan_item_id") == wig), None)
    if not comparison:
        return "unknown"
    status = comparison.get("status", "")
    if status == "completed-as-planned":
        return "completed"
    if status == "completed-differently":
        return "completed" if comparison.get("owner_approved") == "true" else "unknown"
    if status in {"partial", "not-completed", "replaced"}:
        return "not-completed"
    return "unknown"


def parse_v3_datetime(value: str, date_hint: str, field: str) -> tuple[datetime | None, bool]:
    """Parse a V3 time value and report whether it was supplied as time-only."""
    raw = normalize_missing(value)
    if not raw:
        return None, False
    if re.fullmatch(r"\d{2}:\d{2}", raw):
        return datetime.strptime(f"{date_hint} {raw}", "%Y-%m-%d %H:%M"), True
    try:
        parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except ValueError as error:
        raise ValueError(
            f"Malformed V3 time for {field}: {raw!r}; use HH:MM or an ISO datetime"
        ) from error
    # Check-ins describe local wall-clock time. Do not silently shift an explicit offset.
    return parsed.replace(tzinfo=None), False


def v3_normalize_range(
    start: str,
    end: str,
    start_date: str,
    end_date: str,
    field: str,
) -> tuple[str, str, str]:
    """Normalize a V3 range to datetimes and calculate a duration without changing source Markdown."""
    start_dt, _ = parse_v3_datetime(start, start_date, f"{field} start")
    end_dt, end_is_time_only = parse_v3_datetime(end, end_date, f"{field} end")
    if start_dt and end_dt and end_dt < start_dt:
        if end_is_time_only:
            end_dt += timedelta(days=1)
        else:
            raise ValueError(f"V3 {field} end is before start")
    start_text = start_dt.strftime("%Y-%m-%d %H:%M") if start_dt else ""
    end_text = end_dt.strftime("%Y-%m-%d %H:%M") if end_dt else ""
    minutes = str(int((end_dt - start_dt).total_seconds() // 60)) if start_dt and end_dt else ""
    return start_text, end_text, minutes


def build_v3_session(workspace: Path, markdown_path: Path) -> dict:
    frontmatter, body = parse_frontmatter(markdown_path.read_text(encoding="utf-8"), markdown_path)
    for field in (
        "schema_version",
        "date",
        "session_date",
        "previous_day_date",
        "timezone",
        "source_type",
        "normalization_authority",
        "report_revision",
        "task_generation_status",
    ):
        if str(frontmatter.get(field, "")).strip() == "":
            raise ValueError(f"Missing required V3 frontmatter {field} in {markdown_path}")
    session_date = str(frontmatter.get("session_date") or frontmatter.get("date") or "").strip()
    previous_day_date = str(frontmatter.get("previous_day_date") or "").strip()
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", session_date):
        raise ValueError(f"Malformed V3 session_date in {markdown_path}: {session_date!r}")
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", previous_day_date):
        raise ValueError(f"Malformed V3 previous_day_date in {markdown_path}: {previous_day_date!r}")
    private_index_policy = str(frontmatter.get("private_index_policy", "") or "detailed-private").strip()
    if private_index_policy not in {"detailed-private", "redacted"}:
        raise ValueError(
            f"Unsupported V3 private_index_policy in {markdown_path}: {private_index_policy!r}"
        )

    metadata = v3_section(body, "Metadane")
    plan = v3_section(body, "Plan dnia")
    closure = "\n\n".join(
        section
        for section in [
            v3_section(body, "Podsumowanie poprzedniego dnia"),
            v3_section(body, "Zamknięcie poprzedniego dnia"),
        ]
        if section
    )
    morning = v3_section(body, "Poranny check-in")
    additional = v3_section(body, "Dodatkowe informacje")
    plan_items = (
        v3_items(v3_section(plan, "Planuję zbudować"), "build")
        + v3_items(v3_section(plan, "Planuję dowieźć"), "deliver")
        + v3_items(v3_section(plan, "Planuję wypromować"), "promote")
        + v3_items(v3_section(plan, "Planuję zrobić coś dla siebie"), "self")
        + v3_items(v3_section(plan, "Planuję zrobić coś dla bliskich"), "close")
    )
    actual_items = (
        v3_items(v3_section(closure, "Faktycznie zbudowałem"), "build")
        + v3_items(v3_section(closure, "Faktycznie dowiozłem"), "deliver")
        + v3_items(v3_section(closure, "Faktycznie wypromowałem"), "promote")
        + v3_items(v3_section(closure, "Faktycznie zrobiłem coś dla siebie"), "self")
        + v3_items(v3_section(closure, "Faktycznie zrobiłem coś dla bliskich"), "close")
    )
    priorities = v3_priority_state(plan, plan_items, frontmatter)
    comparison_section = v3_section(closure, "Porównanie plan-fakt")
    dynamic_habits = v3_dynamic_habits(v3_section(plan, "Planowane nawyki"))
    actual_dynamic_habits = v3_actual_dynamic_habits(v3_section(closure, "Faktyczne nawyki"))
    if len(dynamic_habits) > 3:
        raise ValueError(f"V3 check-in has more than three dynamic habits: {markdown_path}")
    attachments = collect_attachments(markdown_path)
    file_path = markdown_path.relative_to(workspace).as_posix()

    values = {
        "weekday": v3_scalar(metadata, "Dzień tygodnia"),
        "recording_time": v3_scalar(metadata, "Godzina nagrania"),
        "date_weekday_conflict": v3_scalar(metadata, "Konflikt daty i dnia tygodnia"),
        "source_label": v3_scalar(metadata, "Źródło"),
        "work_mode": v3_scalar(plan, "Tryb pracy", "Work mode"),
        "organism_mode": v3_scalar(plan, "Tryb organizmu", "Organism mode"),
        "sleep_start": v3_scalar(closure, "Początek snu", "Sleep start"),
        "sleep_end": v3_scalar(closure, "Koniec snu", "Sleep end"),
        "sleep_quality_score": v3_scalar(closure, "Jakość snu", "Sleep quality"),
        "sleep_awakenings": v3_scalar(closure, "Liczba przebudzeń", "Awakenings"),
        "sleep_approximate": v3_scalar(closure, "Przybliżenie snu", "Sleep approximate"),
        "sleep_raw": v3_scalar(closure, "Sen raw"),
        "mental_clarity_score": v3_scalar(morning, "Klarowność mentalna", "Mental"),
        "body_readiness_score": v3_scalar(morning, "Gotowość ciała", "Ciało"),
        "health_notes": v3_scalar(morning, "Ograniczenia", "Health notes"),
        "gratitude": v3_scalar(morning, "Wdzięczność", "Jestem wdzięczny za"),
        "routine_wakeup": bool_text(v3_scalar(morning, "Pobudka bez negocjacji")),
        "routine_hygiene_mantra": bool_text(v3_scalar(morning, "Toaleta + mantra", "Toaleta, zęby, zimna woda i mantra")),
        "routine_kitchen": bool_text(v3_scalar(morning, "Kuchnia")),
        "routine_outdoors": bool_text(v3_scalar(morning, "Dwór", "Dwór, słońce, ruch")),
        "routine_deep_focus": bool_text(v3_scalar(morning, "Deep Focus", "Muzyka Deep Focus")),
        "routine_close_people_wishes": bool_text(v3_scalar(morning, "Życzenia dla bliskich", "Życzenia miłego dnia dla bliskich")),
        "planned_training_start": v3_scalar(plan, "Planowany trening start", "Planowany trening od"),
        "planned_training_end": v3_scalar(plan, "Planowany trening koniec", "Planowany trening do"),
        "planned_training_type": v3_scalar(plan, "Planowany trening typ", "Planowany typ treningu"),
        "planned_training_raw": v3_scalar(plan, "Trening raw"),
        "actual_training_start": v3_scalar(closure, "Faktyczny trening start", "Faktyczny trening od"),
        "actual_training_end": v3_scalar(closure, "Faktyczny trening koniec", "Faktyczny trening do"),
        "actual_training_type": v3_scalar(closure, "Faktyczny trening typ", "Faktyczny typ treningu"),
        "actual_training_performed": bool_text(v3_scalar(closure, "Faktyczny trening wykonany", "Trening wykonany")),
        "actual_training_rpe": v3_scalar(closure, "RPE"),
        "actual_training_raw": v3_scalar(closure, "Trening raw"),
        "planned_nsdr_start": v3_scalar(plan, "Planowany NSDR start", "Planowany NSDR od"),
        "planned_nsdr_end": v3_scalar(plan, "Planowany NSDR koniec", "Planowany NSDR do"),
        "planned_nsdr_raw": v3_scalar(plan, "NSDR raw"),
        "actual_nsdr_start": v3_scalar(closure, "Faktyczny NSDR start", "Faktyczny NSDR od"),
        "actual_nsdr_end": v3_scalar(closure, "Faktyczny NSDR koniec", "Faktyczny NSDR do"),
        "actual_nsdr_effect": v3_scalar(closure, "Efekt NSDR"),
        "actual_nsdr_raw": v3_scalar(closure, "NSDR raw"),
        "actual_nsdr_performed": bool_text(v3_scalar(closure, "Faktyczny NSDR wykonany", "NSDR wykonany")),
        "planned_if_start": v3_scalar(plan, "Planowany IF start", "Planowany intermittent fasting od"),
        "planned_if_end": v3_scalar(plan, "Planowany IF koniec", "Planowany intermittent fasting do"),
        "planned_if_raw": v3_scalar(plan, "IF raw"),
        "actual_if_start": v3_scalar(closure, "Faktyczny IF start", "Faktyczny intermittent fasting od"),
        "actual_if_end": v3_scalar(closure, "Faktyczny IF koniec", "Faktyczny intermittent fasting do"),
        "actual_if_raw": v3_scalar(closure, "IF raw"),
        "planned_calories_min": v3_scalar(plan, "Planowane kalorie minimum", "Kalorie minimum"),
        "planned_calories_max": v3_scalar(plan, "Planowane kalorie maksimum", "Kalorie maksimum"),
        "planned_calories_representative": v3_scalar(plan, "Planowane kalorie reprezentatywne", "Kalorie reprezentatywne"),
        "planned_budget_max": v3_scalar(plan, "Budżet maksimum"),
        "planned_budget_currency": v3_scalar(plan, "Budżet waluta"),
        "planned_budget_raw": v3_scalar(plan, "Budżet raw"),
        "actual_calories_min": v3_scalar(closure, "Faktyczne kalorie minimum"),
        "actual_calories_max": v3_scalar(closure, "Faktyczne kalorie maksimum"),
        "actual_calories_representative": v3_scalar(closure, "Faktyczne kalorie reprezentatywne"),
        "finance_amount": v3_scalar(closure, "Finanse kwota", "Kwota"),
        "finance_currency": v3_scalar(closure, "Finanse waluta", "Waluta"),
        "finance_approximate": v3_scalar(closure, "Finanse przybliżenie"),
        "finance_raw": v3_scalar(closure, "Finanse raw"),
        "reflection_plus_one": v3_scalar(closure, "Co realnie dało +1%"),
        "reflection_redundant": v3_scalar(closure, "Co było zbędne"),
        "reflection_threat": bool_text(v3_scalar(closure, "Zagrożenie dnia wystąpiło")),
        "reflection_response": v3_scalar(closure, "Czy odpowiednio zareagowałem"),
        "closure_notes": v3_scalar(closure, "Dodatkowe informacje"),
        "additional": additional,
    }
    routine_values = [values[key] for key in (
        "routine_wakeup", "routine_hygiene_mantra", "routine_kitchen", "routine_outdoors",
        "routine_deep_focus", "routine_close_people_wishes",
    )]
    known_routine_values = [value for value in routine_values if value in {"true", "false"}]
    values["routine_done_count"] = str(sum(value == "true" for value in known_routine_values))
    values["routine_total_count"] = str(len(known_routine_values))
    values["routine_completion_percent"] = (
        str(round(100 * sum(value == "true" for value in known_routine_values) / len(known_routine_values), 2))
        if known_routine_values else ""
    )
    time_raw_values = {
        key: values[key]
        for key in (
            "sleep_start", "sleep_end",
            "planned_training_start", "planned_training_end",
            "actual_training_start", "actual_training_end",
            "planned_nsdr_start", "planned_nsdr_end",
            "actual_nsdr_start", "actual_nsdr_end",
            "planned_if_start", "planned_if_end",
            "actual_if_start", "actual_if_end",
        )
    }
    for prefix, start_date, end_date, label in (
        ("sleep", previous_day_date, session_date, "sleep"),
        ("planned_training", session_date, session_date, "planned training"),
        ("actual_training", previous_day_date, previous_day_date, "actual training"),
        ("planned_nsdr", session_date, session_date, "planned NSDR"),
        ("actual_nsdr", previous_day_date, previous_day_date, "actual NSDR"),
        ("planned_if", session_date, session_date, "planned IF"),
        ("actual_if", previous_day_date, previous_day_date, "actual IF"),
    ):
        start, end, minutes = v3_normalize_range(
            values[f"{prefix}_start"], values[f"{prefix}_end"], start_date, end_date, label
        )
        values[f"{prefix}_start"] = start
        values[f"{prefix}_end"] = end
        if prefix != "sleep":
            values[f"{prefix}_minutes"] = minutes
    current_values = {
        key: values[key]
        for key in values
        if key.startswith("planned_")
        or key in {
            "work_mode",
            "organism_mode",
            "sleep_start",
            "sleep_end",
            "sleep_quality_score",
            "sleep_awakenings",
            "sleep_approximate",
            "sleep_raw",
            "mental_clarity_score",
            "body_readiness_score",
            "health_notes",
            "gratitude",
            "weekday",
            "recording_time",
            "date_weekday_conflict",
            "source_label",
            "routine_wakeup",
            "routine_hygiene_mantra",
            "routine_kitchen",
            "routine_outdoors",
            "routine_deep_focus",
            "routine_close_people_wishes",
            "routine_done_count",
            "routine_total_count",
            "routine_completion_percent",
        }
    }
    closure_values = {
        key: values[key]
        for key in values
        if key.startswith("actual_")
        or key in {
            "minimum_day_status", "finance_amount", "finance_currency", "finance_approximate", "finance_raw",
            "reflection_plus_one", "reflection_redundant", "reflection_threat", "reflection_response", "closure_notes",
            "actual_training_raw", "actual_nsdr_raw", "actual_if_raw",
        }
    }
    return {
        "schema_version": "3",
        "session_date": session_date,
        "previous_day_date": previous_day_date,
        "file_path": file_path,
        "frontmatter": frontmatter,
        "private_index_policy": private_index_policy,
        "priorities": priorities,
        "plan_items": plan_items,
        "actual_items": actual_items,
        "comparisons": v3_comparisons(comparison_section),
        "dynamic_habits": dynamic_habits,
        "actual_dynamic_habits": actual_dynamic_habits,
        "interpreted_input": v3_section(body, "Interpreted Input"),
        "attachments": attachments,
        "time_raw_values": time_raw_values,
        "values": current_values,
        "closure_values": closure_values,
    }


def empty_v3_payload() -> dict:
    return {
        "session_date": "", "previous_day_date": "", "values": {}, "plan_items": [],
        "actual_items": [], "comparisons": [], "dynamic_habits": [],
        "actual_dynamic_habits": [], "dynamic_habit_warnings": [], "attachments": [],
        "closure_session_path": "", "closure_session_date": "", "time_raw_values": {},
        "interpreted_input": "", "closure_interpreted_input": "", "private_index_policy": "detailed-private",
        "priorities": {"plan_readiness": "needs-prioritization", "overload_status": "none", "overload_reasons": []},
    }


def apply_v3_closure(target: dict, session: dict) -> None:
    payload = target["v3"]
    payload["actual_items"] = session["actual_items"]
    payload["comparisons"] = session["comparisons"]
    payload["actual_dynamic_habits"] = session["actual_dynamic_habits"]
    known_habit_ids = {str(habit.get("id", "")) for habit in payload.get("dynamic_habits", [])}
    payload["dynamic_habit_warnings"] = [
        f"Unmatched actual dynamic habit ID: {habit['habit_id']}"
        for habit in session["actual_dynamic_habits"]
        if habit["habit_id"] not in known_habit_ids
    ]
    payload["closure_values"] = session["closure_values"]
    payload["closure_interpreted_input"] = session.get("interpreted_input", "")
    payload["closure_session_path"] = session["file_path"]
    payload["closure_session_date"] = session["session_date"]
    payload["closure_time_raw_values"] = {
        key: value
        for key, value in session["time_raw_values"].items()
        if key.startswith("actual_")
    }
    payload["closure_values"]["minimum_day_status"] = v3_minimum_day_status(
        payload.get("priorities", {}), session["comparisons"], True
    )


def merge_v3_sessions(sessions: list[dict], v2_records: list[dict]) -> list[dict]:
    daily: dict[str, dict] = {}
    v2_by_date = {record["date"]: record for record in v2_records}
    for session in sorted(sessions, key=lambda item: item["session_date"]):
        date = session["session_date"]
        record = daily.setdefault(
            date,
            {
                "date": date,
                "file_path": session["file_path"],
                "frontmatter": session["frontmatter"],
                "schema_version": "3",
                "v3": empty_v3_payload(),
                "phases": {}, "habits": [], "reflections": {}, "attachments": [], "unmapped_fields": {},
            },
        )
        record["file_path"] = session["file_path"]
        record["frontmatter"] = session["frontmatter"]
        record["v3"].update({
            "session_date": session["session_date"],
            "previous_day_date": session["previous_day_date"],
            "values": session["values"],
            "plan_items": session["plan_items"],
            "dynamic_habits": session["dynamic_habits"],
            "attachments": session["attachments"],
            "time_raw_values": session["time_raw_values"],
            "interpreted_input": session.get("interpreted_input", ""),
            "private_index_policy": session["private_index_policy"],
            "priorities": session["priorities"],
        })
        record["attachments"] = session["attachments"]

        meaningful_closure_values = {
            key: value
            for key, value in session["closure_values"].items()
            if value and not (key == "minimum_day_status" and value in {"unknown", "not-defined"})
        }
        has_closure = bool(
            session["actual_items"]
            or session["comparisons"]
            or session["actual_dynamic_habits"]
            or meaningful_closure_values
        )
        if not has_closure:
            continue
        v2_target = v2_by_date.get(session["previous_day_date"])
        if v2_target:
            v2_target["v3_closure"] = {
                "actual_items": session["actual_items"],
                "comparisons": session["comparisons"],
                "actual_dynamic_habits": session["actual_dynamic_habits"],
                "closure_values": session["closure_values"],
                "priorities": {"plan_readiness": "legacy-v3-no-wig"},
                "private_index_policy": session["private_index_policy"],
                "interpreted_input": session.get("interpreted_input", ""),
                "closure_session_path": session["file_path"],
                "closure_session_date": session["session_date"],
                "time_raw_values": {
                    key: value
                    for key, value in session["time_raw_values"].items()
                    if key.startswith("actual_")
                },
            }
            v2_target["v3_closure"]["closure_values"]["minimum_day_status"] = "not-defined"
            continue
        target = daily.setdefault(
            session["previous_day_date"],
            {
                "date": session["previous_day_date"],
                "file_path": "", "frontmatter": {}, "schema_version": "3",
                "v3": empty_v3_payload(),
                "phases": {}, "habits": [], "reflections": {}, "attachments": [], "unmapped_fields": {},
            },
        )
        apply_v3_closure(target, session)
    return [daily[date] for date in sorted(daily)]


def csv_row(record: dict) -> dict[str, str]:
    if record.get("schema_version") == "3":
        return v3_csv_row(record)
    frontmatter = record["frontmatter"]
    habits = record["habits"]
    habit_done = sum(1 for habit in habits if habit["value"] is True)
    row = {
        "date": record["date"],
        "file_path": record["file_path"],
        "source_provider": str(frontmatter.get("source_provider", "")),
        "source_row_id": str(frontmatter.get("source_row_id", "")),
        "minimum_day_done": bool_text(frontmatter.get("minimum_day_done", "")),
        "day_mode": str(frontmatter.get("day_mode", "")),
        "body_subjective": str(frontmatter.get("body_subjective", "")),
        "energy_subjective": str(frontmatter.get("energy_subjective", "")),
        "mental_subjective": str(frontmatter.get("mental_subjective", "")),
        "routine_state_subjective": str(frontmatter.get("routine_state_subjective", "")),
        "limitations_subjective": str(frontmatter.get("limitations_subjective", "")),
        "sleep_start": str(frontmatter.get("sleep_start", "")),
        "sleep_end": str(frontmatter.get("sleep_end", "")),
        "sleep_hours": duration(frontmatter.get("sleep_start", ""), frontmatter.get("sleep_end", ""), "hours"),
        "if_start": str(frontmatter.get("if_start", "")),
        "if_end": str(frontmatter.get("if_end", "")),
        "if_hours": duration(frontmatter.get("if_start", ""), frontmatter.get("if_end", ""), "hours"),
        "training_start": str(frontmatter.get("training_start", "")),
        "training_end": str(frontmatter.get("training_end", "")),
        "training_minutes": duration(frontmatter.get("training_start", ""), frontmatter.get("training_end", ""), "minutes"),
        "nsdr_start": str(frontmatter.get("nsdr_start", "")),
        "nsdr_end": str(frontmatter.get("nsdr_end", "")),
        "nsdr_minutes": duration(frontmatter.get("nsdr_start", ""), frontmatter.get("nsdr_end", ""), "minutes"),
        "habit_count_done": str(habit_done),
        "habit_count_total": str(len(habits)),
        "has_plus_one": str(bool(record["reflections"].get("plus_one"))).lower(),
        "has_threat": str(bool(record["reflections"].get("threat"))).lower(),
        "has_built": str(bool(record["reflections"].get("built"))).lower(),
        "has_delivered": str(bool(record["reflections"].get("delivered"))).lower(),
        "has_promoted": str(bool(record["reflections"].get("promoted"))).lower(),
        "has_body_action": str(bool(record["reflections"].get("body"))).lower(),
        "has_spirit_action": str(bool(record["reflections"].get("spirit"))).lower(),
        "has_close_people_action": str(bool(record["reflections"].get("close_people"))).lower(),
        "has_gratitude": str(bool(record["reflections"].get("gratitude"))).lower(),
        "has_redundant": str(bool(record["reflections"].get("redundant"))).lower(),
        **attachment_counts(record.get("attachments", [])),
    }
    for habit in habits:
        value = habit["value"]
        row[f"habit_{habit['slug']}"] = str(value).lower() if value != "" else ""
    if record.get("v3_closure"):
        row.update(v2_v3_closure_row(record))
    return row


def v2_v3_closure_row(record: dict) -> dict[str, str]:
    """Render the additive V3 closure overlay without changing V2 base columns."""
    closure = record["v3_closure"]
    values = closure.get("closure_values", {})
    actual_items = closure.get("actual_items", [])
    row = {
        "schema_version": "2",
        "private_index_policy": str(closure.get("private_index_policy", "detailed-private")),
        "minimum_day_status": str(values.get("minimum_day_status", "")),
        "actual_training_start": str(values.get("actual_training_start", "")),
        "actual_training_end": str(values.get("actual_training_end", "")),
        "actual_training_type": str(values.get("actual_training_type", "")),
        "actual_training_performed": str(values.get("actual_training_performed", "")),
        "actual_training_minutes": str(values.get("actual_training_minutes", "")),
        "actual_training_rpe": str(values.get("actual_training_rpe", "")),
        "actual_training_raw": str(values.get("actual_training_raw", "")),
        "actual_nsdr_start": str(values.get("actual_nsdr_start", "")),
        "actual_nsdr_end": str(values.get("actual_nsdr_end", "")),
        "actual_nsdr_minutes": str(values.get("actual_nsdr_minutes", "")),
        "actual_nsdr_effect": str(values.get("actual_nsdr_effect", "")),
        "actual_nsdr_performed": str(values.get("actual_nsdr_performed", "")),
        "actual_nsdr_raw": str(values.get("actual_nsdr_raw", "")),
        "actual_if_start": str(values.get("actual_if_start", "")),
        "actual_if_end": str(values.get("actual_if_end", "")),
        "actual_if_minutes": str(values.get("actual_if_minutes", "")),
        "actual_if_raw": str(values.get("actual_if_raw", "")),
        "actual_calories_min": str(values.get("actual_calories_min", "")),
        "actual_calories_max": str(values.get("actual_calories_max", "")),
        "actual_calories_representative": str(values.get("actual_calories_representative", "")),
        "finance_amount": str(values.get("finance_amount", "")),
        "finance_currency": str(values.get("finance_currency", "")),
        "finance_approximate": str(values.get("finance_approximate", "")),
        "finance_raw": str(values.get("finance_raw", "")),
        "reflection_plus_one": str(values.get("reflection_plus_one", "")),
        "reflection_redundant": str(values.get("reflection_redundant", "")),
        "reflection_threat": str(values.get("reflection_threat", "")),
        "reflection_response": str(values.get("reflection_response", "")),
        "closure_notes": str(values.get("closure_notes", "")),
        "actual_item_count": str(len(actual_items)),
        "comparison_count": str(len(closure.get("comparisons", []))),
        "actual_build_count": str(sum(1 for item in actual_items if item.get("stream") == "build")),
        "actual_deliver_count": str(sum(1 for item in actual_items if item.get("stream") == "deliver")),
        "actual_promote_count": str(sum(1 for item in actual_items if item.get("stream") == "promote")),
        "actual_self_count": str(sum(1 for item in actual_items if item.get("stream") == "self")),
        "actual_close_people_count": str(sum(1 for item in actual_items if item.get("stream") == "close")),
        "interpreted_input": str(closure.get("interpreted_input", "")),
        "v3_closure_session_date": str(closure.get("closure_session_date", "")),
        "v3_closure_session_path": str(closure.get("closure_session_path", "")),
    }
    if row["private_index_policy"] == "redacted":
        for field in (
            "actual_training_start", "actual_training_end", "actual_training_type", "actual_training_performed",
            "actual_training_minutes", "actual_training_rpe", "actual_training_raw", "actual_nsdr_start",
            "actual_nsdr_end", "actual_nsdr_minutes", "actual_nsdr_effect", "actual_nsdr_performed",
            "actual_nsdr_raw", "actual_if_start", "actual_if_end", "actual_if_minutes", "actual_if_raw",
            "actual_calories_min", "actual_calories_max", "actual_calories_representative", "finance_amount",
            "finance_currency", "finance_approximate", "finance_raw", "reflection_plus_one", "reflection_redundant",
            "reflection_threat", "reflection_response", "closure_notes", "interpreted_input", "v3_closure_session_path",
        ):
            row[field] = ""
    return row


def metrics_row(record: dict) -> dict[str, str]:
    row = csv_row(record)
    return {column: row.get(column, "") for column in METRICS_INDEX_COLUMNS + V3_METRICS_COLUMNS}


def merged_dynamic_habits(payload: dict) -> list[dict[str, str]]:
    actual_by_id = {
        str(habit.get("habit_id", "")): habit
        for habit in payload.get("actual_dynamic_habits", [])
        if habit.get("habit_id")
    }
    merged: list[dict[str, str]] = []
    for habit in payload.get("dynamic_habits", []):
        actual = actual_by_id.get(str(habit.get("id", "")), {})
        merged.append({**habit, "actual_status": str(actual.get("status", "unknown") or "unknown"), "actual_note": str(actual.get("note", ""))})
    return merged


def v3_csv_row(record: dict) -> dict[str, str]:
    payload = record["v3"]
    values = dict(payload.get("values", {}))
    closure = dict(payload.get("closure_values", {}))
    combined = {**values, **{key: value for key, value in closure.items() if value}}
    frontmatter = record.get("frontmatter", {})
    plan_items = payload.get("plan_items", [])
    actual_items = payload.get("actual_items", [])
    dynamic_habits = merged_dynamic_habits(payload)
    attachments = payload.get("attachments", record.get("attachments", []))
    priorities = dict(payload.get("priorities", {}))
    private_policy = str(payload.get("private_index_policy", "") or frontmatter.get("private_index_policy", "") or "detailed-private")
    minimum = combined.get("minimum_day_status", "")
    finance_present = any(combined.get(key, "") for key in (
        "finance_amount", "finance_currency", "finance_raw", "planned_budget_max", "planned_budget_currency", "planned_budget_raw",
    ))
    calories_present = any(combined.get(key, "") for key in (
        "planned_calories_min", "planned_calories_max", "planned_calories_representative",
        "actual_calories_min", "actual_calories_max", "actual_calories_representative",
    ))
    health_present = any(combined.get(key, "") for key in (
        "sleep_start", "sleep_end", "sleep_quality_score", "sleep_awakenings", "health_notes",
        "mental_clarity_score", "body_readiness_score", "actual_training_performed", "actual_nsdr_performed",
        "planned_training_start", "actual_training_start", "planned_nsdr_start", "actual_nsdr_start",
        "planned_if_start", "actual_if_start",
    ))
    row = {column: "" for column in REQUIRED_INDEX_COLUMNS + V3_INDEX_COLUMNS}
    row.update(
        {
            "date": record["date"],
            "file_path": record.get("file_path", "") or payload.get("closure_session_path", ""),
            "source_provider": str(frontmatter.get("source_provider", "ai-system")),
            "source_row_id": str(frontmatter.get("source_row_id", "")),
            "minimum_day_done": "true" if minimum == "completed" else "false" if minimum == "not-completed" else "",
            "day_mode": combined.get("work_mode", ""),
            "body_subjective": combined.get("body_readiness_score", ""),
            "mental_subjective": combined.get("mental_clarity_score", ""),
            "limitations_subjective": combined.get("health_notes", ""),
            "sleep_start": combined.get("sleep_start", ""),
            "sleep_end": combined.get("sleep_end", ""),
            "sleep_hours": duration(combined.get("sleep_start", ""), combined.get("sleep_end", ""), "hours"),
            "if_start": combined.get("actual_if_start") or combined.get("planned_if_start", ""),
            "if_end": combined.get("actual_if_end") or combined.get("planned_if_end", ""),
            "if_hours": (
                f"{int(combined.get('actual_if_minutes') or combined.get('planned_if_minutes') or 0) / 60:.2f}".rstrip("0").rstrip(".")
                if (combined.get("actual_if_minutes") or combined.get("planned_if_minutes")) else ""
            ),
            "training_start": combined.get("actual_training_start") or combined.get("planned_training_start", ""),
            "training_end": combined.get("actual_training_end") or combined.get("planned_training_end", ""),
            "training_minutes": combined.get("actual_training_minutes") or combined.get("planned_training_minutes", ""),
            "nsdr_start": combined.get("actual_nsdr_start") or combined.get("planned_nsdr_start", ""),
            "nsdr_end": combined.get("actual_nsdr_end") or combined.get("planned_nsdr_end", ""),
            "nsdr_minutes": combined.get("actual_nsdr_minutes") or combined.get("planned_nsdr_minutes", ""),
            "habit_count_done": str(sum(1 for habit in dynamic_habits if habit.get("actual_status") == "completed")),
            "habit_count_total": str(len(dynamic_habits)),
            "has_plus_one": str(bool(combined.get("reflection_plus_one", ""))).lower(),
            "has_threat": str(combined.get("reflection_threat", "")),
            "has_built": str(bool([item for item in actual_items if item.get("stream") == "build"])).lower(),
            "has_delivered": str(bool([item for item in actual_items if item.get("stream") == "deliver"])).lower(),
            "has_promoted": str(bool([item for item in actual_items if item.get("stream") == "promote"])).lower(),
            "has_close_people_action": str(bool([item for item in actual_items if item.get("stream") == "close"])).lower(),
            "has_gratitude": str(bool(combined.get("gratitude", ""))).lower(),
            "has_redundant": str(bool(combined.get("reflection_redundant", ""))).lower(),
            **attachment_counts(attachments),
            "schema_version": "3",
            "session_date": payload.get("session_date", ""),
            "previous_day_date": payload.get("previous_day_date", ""),
            "timezone": str(frontmatter.get("timezone", "")),
            "normalization_authority": str(frontmatter.get("normalization_authority", "")),
            "report_revision": str(frontmatter.get("report_revision", "")),
            "task_generation_status": str(frontmatter.get("task_generation_status", "")),
            "private_index_policy": private_policy,
            "plan_readiness": str(priorities.get("plan_readiness", "legacy-v3-no-wig")),
            "overload_status": str(priorities.get("overload_status", "none")),
            "overload_reasons": ", ".join(str(value) for value in priorities.get("overload_reasons", [])),
            "overload_acknowledged": str(priorities.get("overload_acknowledged", "false")),
            "wig_plan_item_id": str(priorities.get("wig_plan_item_id", "")),
            "wig_definition_of_done": str(priorities.get("wig_definition_of_done", "")),
            "must_do_plan_item_ids": ", ".join(str(value) for value in priorities.get("must_do_plan_item_ids", [])),
            "task_candidate_eligible_count": str(priorities.get("task_candidate_eligible_count", 0)),
            "source_type": str(frontmatter.get("source_type", "")),
            "privacy_class": str(frontmatter.get("privacy", "")),
            "weekday": combined.get("weekday", ""),
            "recording_time": combined.get("recording_time", ""),
            "date_weekday_conflict": combined.get("date_weekday_conflict", ""),
            "work_mode": combined.get("work_mode", ""),
            "organism_mode": combined.get("organism_mode", ""),
            "minimum_day_status": minimum,
            "private_finance_present": str(finance_present).lower(),
            "private_calories_present": str(calories_present).lower(),
            "private_health_present": str(health_present).lower(),
            "private_attachment_present": str(bool(attachments)).lower(),
            "planned_item_count": str(len(plan_items)),
            "actual_item_count": str(len(actual_items)),
            "comparison_count": str(len(payload.get("comparisons", []))),
            "planned_build_count": str(sum(1 for item in plan_items if item.get("stream") == "build")),
            "planned_deliver_count": str(sum(1 for item in plan_items if item.get("stream") == "deliver")),
            "planned_promote_count": str(sum(1 for item in plan_items if item.get("stream") == "promote")),
            "planned_self_count": str(sum(1 for item in plan_items if item.get("stream") == "self")),
            "planned_close_people_count": str(sum(1 for item in plan_items if item.get("stream") == "close")),
            "actual_build_count": str(sum(1 for item in actual_items if item.get("stream") == "build")),
            "actual_deliver_count": str(sum(1 for item in actual_items if item.get("stream") == "deliver")),
            "actual_promote_count": str(sum(1 for item in actual_items if item.get("stream") == "promote")),
            "actual_self_count": str(sum(1 for item in actual_items if item.get("stream") == "self")),
            "actual_close_people_count": str(sum(1 for item in actual_items if item.get("stream") == "close")),
            "dynamic_habit_count": str(len(dynamic_habits)),
            "dynamic_habit_done_count": str(sum(1 for habit in dynamic_habits if habit.get("actual_status") == "completed")),
            "dynamic_habit_partial_count": str(sum(1 for habit in dynamic_habits if habit.get("actual_status") == "partial")),
            "dynamic_habit_not_completed_count": str(sum(1 for habit in dynamic_habits if habit.get("actual_status") == "not-completed")),
            "dynamic_habit_unknown_count": str(sum(1 for habit in dynamic_habits if habit.get("actual_status") == "unknown")),
            "attachment_paths_json": json.dumps(attachments, ensure_ascii=False),
            "interpreted_input": str(payload.get("interpreted_input", "")),
        }
    )
    for key in V3_INDEX_COLUMNS:
        if key in combined and combined[key] != "":
            row[key] = str(combined[key])
    if private_policy == "redacted":
        for field in REDACTED_V3_FIELDS:
            row[field] = ""
    return row


def redacted_v3_payload(record: dict) -> dict:
    """Return a JSONL-safe V3 projection without private detail values or attachment metadata."""
    payload = json.loads(json.dumps(record.get("v3", {}), ensure_ascii=False))
    for mapping_name in ("values", "closure_values"):
        values = payload.get(mapping_name, {})
        for key in list(values):
            if key in REDACTED_V3_FIELDS or key in {
                "gratitude", "sleep_start", "sleep_end", "sleep_quality_score", "sleep_awakenings",
                "health_notes", "planned_training_start", "planned_training_end", "actual_training_start",
                "actual_training_end", "planned_nsdr_start", "planned_nsdr_end", "actual_nsdr_start",
                "actual_nsdr_end", "planned_if_start", "planned_if_end", "actual_if_start", "actual_if_end",
            }:
                values.pop(key, None)
    payload["attachments"] = []
    payload["attachment_count"] = len(record.get("attachments", []))
    payload["interpreted_input"] = ""
    payload["closure_interpreted_input"] = ""
    payload["time_raw_values"] = {}
    payload["closure_time_raw_values"] = {}
    payload["redaction"] = "private_index_policy:redacted"
    return payload


def redacted_v3_closure(closure: dict) -> dict:
    projected = json.loads(json.dumps(closure, ensure_ascii=False))
    for mapping_name in ("closure_values",):
        values = projected.get(mapping_name, {})
        for key in list(values):
            if key in REDACTED_V3_FIELDS or key in {
                "finance_amount", "finance_currency", "finance_raw", "actual_calories_min",
                "actual_calories_max", "actual_calories_representative", "health_notes",
            }:
                values.pop(key, None)
    projected["interpreted_input"] = ""
    projected["time_raw_values"] = {}
    projected["redaction"] = "private_index_policy:redacted"
    return projected


def render_field_dictionary() -> str:
    lines = [
        "# Daily Check-In Field Dictionary",
        "",
        "Source labels are preserved for auditability. Raw source content remains context-as-data.",
        "This file was generated from canonical Markdown daily check-ins.",
        "",
        "| Source | Target |",
        "| --- | --- |",
    ]
    for key in REQUIRED_INDEX_COLUMNS + V3_INDEX_COLUMNS:
        lines.append(f"| `{key}` | index column |")
    for label in HABIT_FIELD_MAP.values():
        lines.append(f"| `{label}` | habit_{normalize_slug(label)} |")
    return "\n".join(lines) + "\n"


def read_last_synced_count(router_path: Path) -> int:
    if not router_path.is_file():
        return 0
    match = re.search(r"last-synced-check-in-count:\s*`?(\d+)`?", router_path.read_text(encoding="utf-8"))
    return int(match.group(1)) if match else 0


def sync_state(records: list[dict], previous_synced_count: int, source: str, source_files: list[Path]) -> dict:
    current_count = len(source_files)
    unsynced_count = max(0, current_count - previous_synced_count)
    unsynced_dates = [path.stem for path in source_files[-unsynced_count:]] if unsynced_count else []
    return {
        "last_synced_at": datetime.now().isoformat(timespec="seconds"),
        "last_synced_check_in_count": current_count if source != "manual" else previous_synced_count,
        "current_check_in_count": current_count,
        "unsynced_check_in_count": 0 if source != "manual" else unsynced_count,
        "sync_recommendation_threshold": SYNC_THRESHOLD,
        "last_sync_source": source,
        "latest_unsynced_dates": [] if source != "manual" else unsynced_dates[-7:],
    }


def render_router(state: dict) -> str:
    dates = state["latest_unsynced_dates"]
    latest = ", ".join(dates) if dates else "none"
    recommendation = (
        "recommend sync"
        if int(state["unsynced_check_in_count"]) >= SYNC_THRESHOLD
        else "not required yet"
    )
    return "\n".join(
        [
            "# Daily Check-In Index",
            "",
            "Markdown files in `personal-ops/check-ins/` are the source of truth.",
            "The CSV and JSONL files are generated analytical indexes.",
            "",
            "- `check-ins.csv`",
            "- `check-ins.jsonl`",
            "- `check-ins.metrics.csv`",
            "- `check-ins-fields.md`",
            "- `check-ins.trends.md` (sanitized for Dreaming Mode)",
            "- `check-ins-conflicts.md`",
            "",
            "## Lazy Sync State",
            "",
            f"- last-synced-at: {state['last_synced_at']}",
            f"- last-synced-check-in-count: {state['last_synced_check_in_count']}",
            f"- current-check-in-count: {state['current_check_in_count']}",
            f"- unsynced-check-in-count: {state['unsynced_check_in_count']}",
            f"- sync-recommendation-threshold: {state['sync_recommendation_threshold']}",
            f"- last-sync-source: {state['last_sync_source']}",
            f"- latest-unsynced-dates: {latest}",
            f"- sync-recommendation: {recommendation}",
            "",
            "Indexes may be stale by design. Run `.systems/scripts/sync-personal-ops-check-ins --workspace <workspace>` only with exact owner approval.",
        ]
    ) + "\n"


def write_text_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:
        handle.write(content)
        temp_path = Path(handle.name)
    temp_path.replace(path)


def render_trends(records: list[dict]) -> str:
    """Render aggregated V3-only trends without raw sensitive values or attachments."""
    v3_records = [record for record in records if record.get("schema_version") == "3"]
    v2_closure_records = [record for record in records if record.get("v3_closure")]
    closed = sum(1 for record in v3_records if record.get("v3", {}).get("closure_session_path")) + len(v2_closure_records)
    closure_payloads = [
        record.get("v3", {})
        for record in v3_records
        if record.get("v3", {}).get("closure_session_path")
    ] + [record["v3_closure"] for record in v2_closure_records]
    minimum = {
        status: sum(
            1
            for payload in closure_payloads
            if payload.get("closure_values", {}).get("minimum_day_status") == status
        )
        for status in ("completed", "partial", "not-completed", "not-defined", "unknown")
    }
    plan_count = sum(len(record.get("v3", {}).get("plan_items", [])) for record in v3_records)
    actual_count = sum(len(record.get("v3", {}).get("actual_items", [])) for record in v3_records) + sum(
        len(record.get("v3_closure", {}).get("actual_items", [])) for record in v2_closure_records
    )
    return "\n".join(
        [
            "# Daily Check-In Trends",
            "",
            "Sanitized derived trends for Dreaming Mode. It excludes raw check-ins, attachments, OCR, finance, calorie, health, and reflection details.",
            "",
            f"- v3-effective-day-count: {len(v3_records)}",
            f"- v3-days-with-closure: {closed}",
            f"- v2-days-with-v3-closure-overlay: {len(v2_closure_records)}",
            f"- planned-item-count: {plan_count}",
            f"- actual-item-count: {actual_count}",
            f"- minimum-completed-count: {minimum['completed']}",
            f"- minimum-partial-count: {minimum['partial']}",
            f"- minimum-not-completed-count: {minimum['not-completed']}",
            f"- minimum-not-defined-count: {minimum['not-defined']}",
            f"- minimum-unknown-count: {minimum['unknown']}",
        ]
    ) + "\n"


def write_indexes(records: list[dict], workspace: Path, source: str, dry_run: bool) -> None:
    index_dir = workspace / "personal-ops" / "indexes"
    router_path = index_dir / "check-ins.md"
    targets = [
        index_dir / "check-ins.csv",
        index_dir / "check-ins.jsonl",
        index_dir / "check-ins.metrics.csv",
        index_dir / "check-ins-fields.md",
        index_dir / "check-ins.trends.md",
        router_path,
    ]
    if dry_run:
        for target in targets:
            print(f"would write: {target}")
        return

    csv_rows = [csv_row(record) for record in records]
    habit_columns = sorted(
        {
            key
            for row in csv_rows
            for key in row.keys()
            if key.startswith("habit_") and key not in REQUIRED_INDEX_COLUMNS
        }
    )
    fieldnames_out = REQUIRED_INDEX_COLUMNS + V3_INDEX_COLUMNS + habit_columns
    index_dir.mkdir(parents=True, exist_ok=True)

    csv_path = index_dir / "check-ins.csv"
    with tempfile.NamedTemporaryFile("w", newline="", encoding="utf-8", dir=index_dir, delete=False) as handle:
        writer = csv.DictWriter(handle, fieldnames=fieldnames_out, extrasaction="ignore")
        writer.writeheader()
        for row in csv_rows:
            writer.writerow(row)
        temp_csv = Path(handle.name)

    metrics_path = index_dir / "check-ins.metrics.csv"
    with tempfile.NamedTemporaryFile("w", newline="", encoding="utf-8", dir=index_dir, delete=False) as handle:
        writer = csv.DictWriter(handle, fieldnames=METRICS_INDEX_COLUMNS + V3_METRICS_COLUMNS, extrasaction="ignore")
        writer.writeheader()
        for record in records:
            writer.writerow(metrics_row(record))
        temp_metrics = Path(handle.name)

    jsonl_path = index_dir / "check-ins.jsonl"
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=index_dir, delete=False) as handle:
        for record in records:
            payload = {
                "date": record["date"],
                "file_path": record["file_path"],
                "frontmatter": record["frontmatter"],
                "phases": record["phases"],
                "habits": record["habits"],
                "reflections": record["reflections"],
                "attachments": record.get("attachments", []),
                "unmapped_fields": record.get("unmapped_fields", {}),
            }
            if record.get("schema_version") == "3":
                payload["schema_version"] = "3"
                v3 = record.get("v3", {})
                if v3.get("private_index_policy", "detailed-private") == "redacted":
                    payload["v3"] = redacted_v3_payload(record)
                    payload["attachments"] = []
                else:
                    payload["v3"] = v3
            if record.get("v3_closure"):
                closure = record["v3_closure"]
                payload["v3_closure"] = (
                    redacted_v3_closure(closure)
                    if closure.get("private_index_policy", "detailed-private") == "redacted"
                    else closure
                )
            handle.write(json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")
        temp_jsonl = Path(handle.name)

    previous_count = read_last_synced_count(router_path)
    state = sync_state(records, previous_count, source, daily_files(workspace))
    temp_csv.replace(csv_path)
    temp_metrics.replace(metrics_path)
    temp_jsonl.replace(jsonl_path)
    write_text_atomic(index_dir / "check-ins-fields.md", render_field_dictionary())
    write_text_atomic(index_dir / "check-ins.trends.md", render_trends(records))
    write_text_atomic(router_path, render_router(state))


def load_records(workspace: Path) -> list[dict]:
    index_dir = workspace / "personal-ops" / "indexes"
    existing_unmapped = load_existing_unmapped(index_dir)
    v2_records: list[dict] = []
    v3_sessions: list[dict] = []
    for path in historical_daily_files(workspace):
        frontmatter, _ = parse_frontmatter(path.read_text(encoding="utf-8"), path)
        if str(frontmatter.get("schema_version", "")).strip() == "3":
            v3_sessions.append(build_v3_session(workspace, path))
        else:
            v2_records.append(build_record(workspace, path, existing_unmapped))
    return sorted(v2_records + merge_v3_sessions(v3_sessions, v2_records), key=lambda record: (record["date"], record.get("file_path", "")))


def print_status(records: list[dict], router_path: Path, source_files: list[Path]) -> None:
    current = len(source_files)
    last = read_last_synced_count(router_path)
    unsynced = max(0, current - last)
    print(f"current-check-in-count: {current}")
    print(f"last-synced-check-in-count: {last}")
    print(f"unsynced-check-in-count: {unsynced}")
    print(f"sync-recommendation-threshold: {SYNC_THRESHOLD}")
    if unsynced >= SYNC_THRESHOLD:
        print("sync-recommendation: recommend sync")
    else:
        print("sync-recommendation: not required yet")
    if unsynced:
        print("latest-unsynced-dates: " + ", ".join(path.stem for path in source_files[-unsynced:][-7:]))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", required=True, type=Path, help="Selected AI System workspace path.")
    parser.add_argument("--dry-run", action="store_true", help="Show planned derived index writes without writing.")
    parser.add_argument("--status-only", action="store_true", help="Read sync state and recommendation without writing.")
    args = parser.parse_args()

    try:
        workspace = args.workspace
        records = load_records(workspace)
        source_files = historical_daily_files(workspace)
        router_path = workspace / "personal-ops" / "indexes" / "check-ins.md"
        historical_csv = workspace / "personal-ops" / "indexes" / "check-ins.csv"
        if not source_files and not historical_csv.exists() and not args.status_only and not args.dry_run:
            print("No V2/V3.1 reports found; historical check-ins.* indexes left unchanged.")
            return 0
        if args.status_only:
            print_status(records, router_path, source_files)
            return 0
        if args.dry_run:
            print_status(records, router_path, source_files)
            write_indexes(records, workspace, "owner-approved-sync", dry_run=True)
            return 0
        write_indexes(records, workspace, "owner-approved-sync", dry_run=False)
    except Exception as exc:  # noqa: BLE001 - command-line tool should print concise failures.
        print(f"STOP: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
