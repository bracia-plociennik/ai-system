#!/usr/bin/env python3
"""Private rule preview/write/current-read. No filing or network calls."""
import argparse
import json
import sys
from work_evidence import EvidenceError, require, read_json, safe_path, digest
from work_evidence_tax_evidence import TaxRegister
from work_evidence_tax import Calculator

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("preview", "write", "read"))
    parser.add_argument("--workspace", required=True)
    parser.add_argument("--taxpayer", required=True)
    parser.add_argument("--bundle", required=True)
    parser.add_argument("--rules", required=True)
    parser.add_argument("--result")
    parser.add_argument("--expected-hash")
    parser.add_argument("--owner-approved", action="store_true")
    args = parser.parse_args()
    try:
        if args.action == "write":
            require(args.owner_approved, "owner-approval-required", "calculation")
        register = TaxRegister(args.workspace, args.taxpayer)
        calculator = Calculator(register, args.rules)
        bundle = read_json(safe_path(register.home, args.bundle))
        if args.action == "preview":
            value = calculator.calculate(bundle)
            value = {"result": value, "result_hash": digest(value)}
        elif args.action == "read":
            value = calculator.read_current(bundle, args.result)
        else:
            value = calculator.write(bundle, args.expected_hash, owner_approved=True)
        print(json.dumps(value, ensure_ascii=False, allow_nan=False))
        return 0
    except (EvidenceError, OSError, ValueError, TypeError, KeyError, ArithmeticError):
        error = sys.exc_info()[1]
        print(json.dumps({"state": "blocked", "category": error.category if isinstance(
            error, EvidenceError) else "invalid-or-unavailable-input"}), file=sys.stderr)
        return 2

if __name__ == "__main__":
    sys.exit(main())
