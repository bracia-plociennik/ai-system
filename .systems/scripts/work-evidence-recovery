#!/usr/bin/env python3
"""Preview or approve exact local initialization, backup or journaled restore."""
import argparse
import json
import sys
from pathlib import Path
from work_evidence import EvidenceError, require, read_json, safe_path, digest
from work_evidence_ledger import Ledger
from work_evidence_recovery import (init_preview, initialize, backup_preview, write_backup,
                                    restore_preview, restore)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("init-preview", "init", "backup-preview", "backup",
                                         "restore-preview", "restore"))
    parser.add_argument("--workspace", required=True)
    parser.add_argument("--request")
    parser.add_argument("--backup-id")
    parser.add_argument("--expected-hash")
    parser.add_argument("--owner-approved", action="store_true")
    args = parser.parse_args()
    try:
        if args.action in {"init", "backup", "restore"}:
            require(args.owner_approved, "owner-approval-required", "recovery")
        if args.action.startswith("init"):
            request = read_json(safe_path(Path(args.workspace), args.request))
            result = (init_preview(args.workspace, request) if args.action == "init-preview"
                      else initialize(args.workspace, request, args.expected_hash, owner_approved=True))
        else:
            ledger = Ledger(args.workspace)
            if args.action == "restore-preview":
                result = restore_preview(ledger, args.backup_id)
            else:
                request = read_json(safe_path(ledger.workspace, args.request))
                if args.action.startswith("backup"):
                    from work_evidence import shape
                    shape(request, {"paths"})
                    result = (backup_preview(ledger, request["paths"]) if args.action == "backup-preview"
                              else write_backup(ledger, request["paths"], args.expected_hash,
                                                owner_approved=True))
                else:
                    result = restore(ledger, request, args.expected_hash, owner_approved=True)
        if args.action.endswith("preview"):
            result = {"preview": result, "preview_hash": digest(result)}
        print(json.dumps(result, allow_nan=False))
        return 0
    except (EvidenceError, OSError, ValueError, TypeError, KeyError):
        error = sys.exc_info()[1]
        print(json.dumps({"state": "blocked", "category": error.category if isinstance(
            error, EvidenceError) else "invalid-or-unavailable-input"}), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
