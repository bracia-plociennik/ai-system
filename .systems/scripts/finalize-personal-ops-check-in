#!/usr/bin/env python3
"""SPOR preview by default; apply uses native indexes/renderer, no implicit integrations."""
import argparse,json,sys
from pathlib import Path
from finalization_artifacts import finalize_spor
p=argparse.ArgumentParser(description=__doc__);p.add_argument('--workspace',type=Path,required=True)
p.add_argument('--apply',action='store_true');p.add_argument('--owner-approved',action='store_true')
a=p.parse_args()
try:print(json.dumps(finalize_spor(a.workspace,json.load(sys.stdin),apply=a.apply,approved=a.owner_approved),ensure_ascii=False,indent=2))
except (ValueError,OSError,KeyError,TypeError) as e:print(json.dumps({'status':'blocked','reason':str(e)}));sys.exit(2)
