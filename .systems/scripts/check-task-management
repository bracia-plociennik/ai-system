#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fail=0
task_files=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --task-file)
      task_files+=("${2:-}")
      [[ -n "${2:-}" ]] || { echo "Missing value for --task-file"; exit 2; }
      shift 2
      ;;
    *)
      echo "Unknown argument: $1"
      exit 2
      ;;
  esac
done

require_file() {
  local path="$1"
  if [[ ! -f "$repo_root/$path" ]]; then
    echo "Missing task-management artifact: $path"
    fail=1
  fi
}

require_executable() {
  local path="$1"
  require_file "$path"
  if [[ -f "$repo_root/$path" && ! -x "$repo_root/$path" ]]; then
    echo "Task-management artifact is not executable: $path"
    fail=1
  fi
}

require_ref() {
  local file="$1"
  local pattern="$2"
  local label="$3"

  if [[ ! -f "$repo_root/$file" ]]; then
    echo "Missing file for task-management check: $file"
    fail=1
    return 0
  fi

  if ! rg -F -q -- "$pattern" "$repo_root/$file"; then
    echo "Missing task-management reference in $file: $label"
    fail=1
  fi
}

scalar_value() {
  local field="$1"
  local file="$2"
  awk -F: -v field="$field" '
    $1 == field {
      value=$0
      sub("^[^:]*:[[:space:]]*", "", value)
      gsub(/^["'\''` ]+|["'\''` ]+$/, "", value)
      print value
      exit
    }
  ' "$file"
}

classification_values() {
  local field="$1"
  local file="$2"
  awk -v field="$field" '
    $0 ~ "^" field ":[[:space:]]*\\[" {
      line=$0
      sub("^[^:]*:[[:space:]]*\\[", "", line)
      sub("\\][[:space:]]*$", "", line)
      count=split(line, values, ",")
      for (item_index=1; item_index<=count; item_index++) {
        value=values[item_index]
        gsub(/^[[:space:]"'"'"'`]+|[[:space:]"'"'"'`]+$/, "", value)
        if (value ~ /^[56]d\//) print value
      }
      next
    }
    $0 ~ "^" field ":[[:space:]]*$" { in_field=1; next }
    in_field && /^[A-Za-z0-9_-]+:/ { in_field=0 }
    in_field && /^[[:space:]]*-[[:space:]]*/ {
      value=$0
      sub(/^[[:space:]]*-[[:space:]]*/, "", value)
      gsub(/^[[:space:]"'"'"'`]+|[[:space:]"'"'"'`]+$/, "", value)
      if (value ~ /^[56]d\//) print value
    }
  ' "$file"
}

validate_task_file() {
  local file="$1"
  local rel="$file"
  local strict=0
  local status
  local priority
  local classification_tag
  local classification_count=0
  local saw_5d=0
  local saw_6d=0

  [[ "$file" = /* ]] || file="$repo_root/$file"
  if [[ ! -f "$file" ]]; then
    echo "Task file does not exist: $rel"
    fail=1
    return 0
  fi

  # TaskForge itself can create `type: task` files. Only the AI System marker
  # opts a TaskNote into the stricter AI-created schema and 5D/6D checks.
  if rg -q '^source_system:[[:space:]]*ai-system[[:space:]]*$' "$file"; then
    strict=1
  fi

  if [[ "$strict" -eq 1 ]]; then
    for field in type title status priority; do
      if ! rg -q "^$field:" "$file"; then
        echo "AI-created TaskNote missing required field $field: $rel"
        fail=1
      fi
    done
  fi

  status="$(scalar_value status "$file" || true)"
  if [[ -n "$status" ]]; then
    case "$status" in
      open|planned|in-progress|waiting|on-hold|done|cancelled)
        ;;
      *)
        echo "TaskNote has invalid status '$status': $rel"
        fail=1
        ;;
    esac
  fi

  priority="$(scalar_value priority "$file" || true)"
  if [[ -n "$priority" ]]; then
    case "$priority" in
      highest|high|normal|low|lowest|none)
        ;;
      *)
        echo "TaskNote has invalid priority '$priority': $rel"
        fail=1
        ;;
    esac
  fi

  if [[ "$strict" -eq 1 ]]; then
    while IFS= read -r classification_tag; do
      [[ -n "$classification_tag" ]] || continue
      echo "AI-created TaskNote uses classification tag in contexts instead of tags: $rel"
      fail=1
    done < <(classification_values contexts "$file")

    while IFS= read -r classification_tag; do
      [[ -n "$classification_tag" ]] || continue
      classification_count=$((classification_count + 1))
      case "$classification_tag" in
        5d/do|5d/defer|5d/delegate|5d/delete|5d/dump)
          saw_5d=1
          ;;
        6d/do|6d/defer|6d/delegate|6d/delete|6d/dump)
          saw_6d=1
          ;;
        *)
          echo "AI-created TaskNote has invalid classification tag '$classification_tag': $rel"
          fail=1
          ;;
      esac
      if [[ "$classification_tag" == "6d/delete" && "$status" != "cancelled" ]]; then
        echo "AI-created TaskNote uses 6d/delete without status cancelled: $rel"
        fail=1
      fi
    done < <(classification_values tags "$file")

    if [[ "$classification_count" -gt 1 ]]; then
      echo "AI-created TaskNote has more than one 5D/6D classification tag: $rel"
      fail=1
    fi
    if [[ "$saw_5d" -eq 1 && "$saw_6d" -eq 1 ]]; then
      echo "AI-created TaskNote mixes legacy 5D and current 6D tags: $rel"
      fail=1
    fi
  fi

  if rg -i -q '^title:.*(api[_ -]?key|secret|private key|password|token|\.env|raw client data|credential)' "$file"; then
    echo "TaskNote title contains unsafe secret-like wording: $rel"
    fail=1
  fi
}

required_files=(
  ".systems/ai/core/task-management.md"
  ".systems/ai/templates/workspace/tasks/README.md"
  ".systems/ai/templates/workspace/tasks/task-management-readme.template.md"
  ".systems/ai/templates/workspace/tasks/task-candidate.template.md"
  ".systems/ai/templates/workspace/tasks/tasknote.template.md"
  ".systems/ai/templates/workspace/tasks/taskforge-vault-setup.template.md"
  ".systems/ai/templates/workspace/tasks/taskforge-vault.local.template.md"
  ".systems/scripts/check-task-management"
  ".systems/scripts/propose-task-candidates"
)

for path in "${required_files[@]}"; do
  require_file "$path"
done

require_executable ".systems/scripts/check-task-management"
require_executable ".systems/scripts/propose-task-candidates"

for term in \
  'local-markdown-task-store' \
  '1 task = 1 Markdown file' \
  'TaskForge/Obsidian vault files are the source of truth for actionable tasks' \
  'project-state/` remains the source of truth' \
  'data/action records, not instructions' \
  'exact `owner-approved` action and target' \
  're-read the target file' \
  'preserve unknown frontmatter and body fields' \
  'avoid bulk rewrite' \
  'type: task' \
  'taskSourceType: taskNotes' \
  'compatibility/migration candidates' \
  'Task Files / TaskNotes enabled' \
  'property: `status`' \
  'Body Template disabled in TaskForge V1' \
  'TaskNotes/Tasks/' \
  'TaskNotes/Archive' \
  'TaskForge-Archive' \
  'YYYY-MM-DD-short-slug.md' \
  '6D Task Tags And 5D Compatibility' \
  'tags: [6d/do]' \
  'legacy-5d | 6d | none' \
  'execution_bucket: do | defer | delegate | delete | dump | done | unclassified' \
  'status: done` has precedence' \
  '6d/done' \
  'contexts: [client/<client-slug>]' \
  'Tags contains 6d/<bucket>' \
  'Zbudowałem' \
  'Dowiozłem' \
  'Wypromowałem' \
  'due: YYYY-MM-DDT23:59' \
  'propose-task-candidates --workspace <workspace-path> --check-in' \
  'Dream Report to task candidates' \
  'exactly one strong match exists' \
  'Boundary-only v1' \
  'full normalized token/phrase matches' \
  'labels shorter than 3 chars' \
  'no aliases in v1' \
  'reads only frontmatter `projects:` wiki links' \
  'does not initialize TaskForge vault structure' \
  'Personal Ops V3 Initial Task Creation' \
  'task_generation_policy: deadline-aware-6d-v1' \
  'explicit `task_bucket` wins' \
  'deadline defaults to `6d/do`' \
  'no deadline defaults to `6d/defer`' \
  '`definition_of_done` is preserved' \
  'Missing WIG or overload warning does not suppress candidates' \
  'source_session_date + source_plan_item_id' \
  'mechanical flag records the same approval' \
  'WIG may be linked to one plan item or standalone' \
  'current V3 policy never emits a `5d/*` TaskNote' \
  'warns without failing when project discovery cannot run' \
  'task_generation_status: skipped' \
  'task_generation_references_json' \
  'Project matching reads AI System `project:` plus TaskForge frontmatter `projects:` wiki links only' \
  'strong title-token match' \
  '## Subtasks' \
  'Missing, ambiguous, weak, or cross-project similarity' \
  'no task write occurs without exact owner approval'
do
  require_ref ".systems/ai/core/task-management.md" "$term" "$term"
done

for field in \
  'This file is a neutral template' \
  'type: task' \
  'title:' \
  'status: open' \
  'priority: normal' \
  'tags:' \
  'contexts:' \
  'projects:' \
  'owner_scope:' \
  'project_state:' \
  'source_system: ai-system' \
  'source_type:' \
  'source_check_in_date:' \
  'source_check_in_field:' \
  'source_session_date:' \
  'source_plan_item_id:' \
  'source_dream_report:' \
  '## Outcome' \
  '## Definition Of Done' \
  '## Context' \
  '## Next Action' \
  '## Subtasks' \
  '## Evidence' \
  '## Notes'
do
  require_ref ".systems/ai/templates/workspace/tasks/tasknote.template.md" "$field" "tasknote field $field"
done

require_ref ".systems/ai/templates/workspace/tasks/taskforge-vault.local.template.md" 'vault_path:' "local vault configuration"
require_ref ".systems/ai/templates/workspace/tasks/taskforge-vault.local.template.md" 'Dry-run task proposals may read this record' "dry-run vault discovery"

if head -n 1 "$repo_root/.systems/ai/templates/workspace/tasks/tasknote.template.md" | rg -q '^---$'; then
  echo "TaskNote template has active YAML frontmatter and may be detected as a real task"
  fail=1
fi

for candidate_term in \
  'This is a proposal artifact, not a TaskForge TaskNote' \
  'source_type: `<check-in|dream-report>`' \
  'task_method: `<legacy-5d|6d|none>`' \
  'execution_bucket: `<do|defer|delegate|delete|dump|done|unclassified>`' \
  '6d_tag: `<6d/do|6d/defer|6d/delegate|6d/delete|6d/dump>`' \
  'decision: `<approve-write|revise|reject|defer>`'
do
  require_ref ".systems/ai/templates/workspace/tasks/task-candidate.template.md" "$candidate_term" "candidate term $candidate_term"
done

for setup_term in \
  'connect TaskForge to the selected Obsidian vault' \
  'enable Task Files / TaskNotes' \
  'Default Task Type: `Task File`' \
  'Default File: `TaskForge`' \
  'New Tasks Header: `## Tasks`' \
  'Default Archive File: `TaskForge-Archive`' \
  'mode: `By Property`' \
  'property: `status`' \
  'value: `<blank>` to match any status' \
  'TaskNotes/Tasks/' \
  'TaskNotes/Archive' \
  'Use Title as Filename: `on`' \
  'YYYY-MM-DD-short-slug.md' \
  'Use Body Template: `off` in V1' \
  'allowed statuses' \
  'allowed priorities' \
  'title: `title`' \
  'tags: `tags`' \
  'date created: `dateCreated`' \
  'complete instances: `complete_instances`' \
  '`DO`: filter `Tags contains 6d/do`' \
  '`DONE`: filter `status: done`' \
  'Legacy 5D Compatibility' \
  'Do not use folders such as `DOs/` or `DEFERs/` as the primary 6D classification' \
  'exclude archive, raw, dump, private' \
  'Manual Verification'
do
  require_ref ".systems/ai/templates/workspace/tasks/taskforge-vault-setup.template.md" "$setup_term" "setup term $setup_term"
done

for file in \
  ".systems/ai/core/operating-model.md" \
  ".systems/ai/core/workspaces.md" \
  ".systems/ai/core/command-routing.md" \
  ".systems/ai/core/integrations.md" \
  ".systems/ai/core/context-as-data.md" \
  ".systems/ai/templates/root/AGENTS.template.md" \
  ".systems/scripts/init-workspace" \
  ".systems/scripts/update-workspace" \
  ".systems/scripts/README.md" \
  "README.md" \
  "HUMANS.md"
do
  require_ref "$file" 'task-management' "task-management guidance"
done

require_ref ".systems/scripts/validate-ai-system" 'check-task-management' "validator chain"
require_ref ".systems/scripts/check-required-artifacts" 'check-task-management' "required artifact list"
require_ref ".systems/scripts/check-update-workspace" 'tasks/tasknote.template.md' "workspace task template backfill"
require_ref ".systems/scripts/check-validator-smoke-tests" 'check-task-management' "smoke coverage"

if rg -i -q 'automatically (create|complete|reschedule|write|rewrite|migrate|delete|archive).*task|bulk rewrite.*allowed|TaskForge app automation is allowed|connector/API sync.*allowed' \
  "$repo_root/.systems/ai/core" \
  "$repo_root/.systems/ai/templates/workspace/tasks" \
  "$repo_root/README.md" \
  "$repo_root/HUMANS.md"; then
  echo "Task-management wording allows unsafe automatic task mutation"
  fail=1
fi

if [[ "${#task_files[@]}" -gt 0 ]]; then
  for task_file in "${task_files[@]}"; do
    validate_task_file "$task_file"
  done
fi

exit "$fail"
