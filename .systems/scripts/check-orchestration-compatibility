#!/usr/bin/env python3
"""Read-only protocol, capture or Git-proof inspection; no execution authority."""

import argparse
import json
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
from orchestration_compatibility import Blocked, require, negotiate, inspect_plan
from capture_parity import collection
from qa_source_binding import snapshot, verify_qa_binding


def scan(workspace, owner=None):
    root = Path(workspace).absolute()
    require(root.is_dir() and root.resolve() == root, "missing/linked workspace")
    if owner:
        owners = [owner if owner == "capture-state" else owner + "/capture-state"]
    else:
        patterns = ["capture-state", "project-state/*/capture-state", "clients/*/capture-state", "clients/*/project-state/*/capture-state",
                    "owned-assets/*/capture-state", "owned-assets/*/project-state/*/capture-state"]
        owners = [p.relative_to(root).as_posix() for pattern in patterns for p in root.glob(pattern) if p.is_dir()]
    results = {name: collection(root, name) for name in owners}
    return {"collections": results, "supporting_only": True, "invalid": sum(len(r["errors"]) for r in results.values())}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--workflow-root", type=Path)
    group.add_argument("--plan", type=Path)
    group.add_argument("--workspace", type=Path)
    group.add_argument("--snapshot", action="store_true")
    group.add_argument("--verify-snapshot", type=Path)
    parser.add_argument("--owned-root")
    parser.add_argument("--repo", type=Path)
    parser.add_argument("--qa-file", type=Path)
    parser.add_argument("--project")
    parser.add_argument("--task")
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[2]
    try:
        require(not args.owned_root or args.workspace, "--owned-root requires --workspace")
        if args.workflow_root:
            result = negotiate(args.workflow_root)
        elif args.plan:
            require(not args.plan.is_symlink(), "linked compatibility plan")
            result = inspect_plan(json.loads(args.plan.read_text()))
        elif args.workspace:
            result = scan(args.workspace, args.owned_root)
        elif args.snapshot:
            require(args.repo and args.project and args.task, "snapshot needs repo/project/task")
            result = snapshot(args.repo, args.project, args.task)
        elif args.verify_snapshot:
            require(args.repo and args.qa_file and args.project and args.task, "binding requires repo, immutable QA and scope")
            require(not args.verify_snapshot.is_symlink() and not args.qa_file.is_symlink(), "linked QA proof")
            result = verify_qa_binding(json.loads(args.verify_snapshot.read_text()), args.repo, args.qa_file, args.project, args.task)
        else:
            for name in (".systems/ai/core/orchestration-compatibility.md", ".systems/ai/core/phase-commit-policy.md",
                         ".systems/ai/templates/workspace/project-state/compatibility-plan.template.json"):
                require((root / name).is_file(), "missing compatibility artifact: " + name)
            return subprocess.call([sys.executable, "-B", "-m", "unittest", "discover", "-s", str(root / ".systems/scripts/tests"), "-p", "test_orchestration_compatibility.py"])
        print(json.dumps(result, indent=2))
        return 1 if result.get("invalid", 0) else 0
    except (Blocked, ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError) as error:
        print("Compatibility blocked; fresh review/QA required: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
