@dataclass
class TimeRange:
    start: str = ""
    end: str = ""
    raw: str = ""
    minutes: str = ""
    hours: str = ""


def normalize_slug(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_value = "".join(ch for ch in normalized if not unicodedata.combining(ch))
    ascii_value = ascii_value.lower()
    ascii_value = re.sub(r"[^a-z0-9]+", "_", ascii_value).strip("_")
    return ascii_value or "value"


def normalize_day_mode(value: str) -> str:
    return normalize_slug(value).replace("_", "-") if value.strip() else ""


def normalize_bool(value: str):
    normalized = value.strip().lower()
    if normalized in {"yes", "true", "1", "tak"}:
        return True
    if normalized in {"no", "false", "0", "nie"}:
        return False
    return ""


def yaml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if value is None or value == "":
        return ""
    return json.dumps(str(value), ensure_ascii=False)


def parse_check_in_date(raw: str) -> date:
    value = raw.strip().strip('"')
    for fmt in ("%B %d, %Y", "%b %d, %Y", "%Y-%m-%d"):
        try:
            return datetime.strptime(value, fmt).date()
        except ValueError:
            continue
    raise ValueError(f"Could not parse Data value: {raw!r}")


def clean_datetime_part(raw: str) -> str:
    value = raw.strip()
    value = re.sub(r"\([^)]*\)", "", value)
    value = value.replace(",", "")
    return re.sub(r"\s+", " ", value).strip()


def parse_datetime_part(raw: str, base_date: date, default_date: date | None = None) -> datetime | None:
    value = clean_datetime_part(raw)
    if not value:
        return None

    if re.fullmatch(r"\d{1,2}:\d{2}", value):
        target_date = default_date or base_date
        hour, minute = value.split(":", 1)
        return datetime(target_date.year, target_date.month, target_date.day, int(hour), int(minute))

    no_year = re.fullmatch(r"([A-Za-z]+)\s+(\d{1,2})\s+(\d{1,2}:\d{2})", value)
    if no_year:
        value_with_year = f"{no_year.group(1)} {no_year.group(2)} {base_date.year} {no_year.group(3)}"
        for fmt in ("%B %d %Y %H:%M", "%b %d %Y %H:%M"):
            try:
                return datetime.strptime(value_with_year, fmt)
            except ValueError:
                continue

    formats = (
        "%B %d %Y %H:%M",
        "%b %d %Y %H:%M",
        "%Y-%m-%d %H:%M",
    )
    for fmt in formats:
        try:
            return datetime.strptime(value, fmt)
        except ValueError:
            continue
    return None


def parse_time_range(raw: str, base_date: date) -> TimeRange:
    value = raw.strip()
    if not value:
        return TimeRange()

    parts = re.split(r"\s*(?:→|->)\s*", value, maxsplit=1)
    if len(parts) != 2:
        return TimeRange(raw=value)

    start_dt = parse_datetime_part(parts[0], base_date)
    end_dt = parse_datetime_part(parts[1], base_date, start_dt.date() if start_dt else base_date)
    if not start_dt or not end_dt:
        return TimeRange(raw=value)

    if end_dt < start_dt:
        end_dt += timedelta(days=1)

    minutes = int((end_dt - start_dt).total_seconds() // 60)
    hours = minutes / 60
    return TimeRange(
        start=start_dt.strftime("%Y-%m-%d %H:%M"),
        end=end_dt.strftime("%Y-%m-%d %H:%M"),
        raw=value,
        minutes=str(minutes),
        hours=f"{hours:.2f}".rstrip("0").rstrip("."),
    )


def source_row_id(row: dict[str, str], row_number: int) -> str:
    for column in SOURCE_ID_COLUMNS:
        if row.get(column, "").strip():
            return row[column].strip()
    return f"row-{row_number:04d}"


def markdown_section(title: str, value: str) -> str:
    body = value.strip()
    return f"## {title}\n\n{body}\n" if body else f"## {title}\n"


def markdown_subsection(title: str, value: str) -> str:
    body = value.strip()
    return f"### {title}\n\n{body}\n" if body else f"### {title}\n"


def bool_text(value) -> str:
    if value is True:
        return "true"
    if value is False:
        return "false"
    return ""


def time_range_text(time_range: TimeRange) -> str:
    if time_range.start or time_range.end:
        return f"{time_range.start} -> {time_range.end}".strip()
    return time_range.raw


def attachment_kind(path: Path) -> str:
    suffix = path.suffix.lower()
    name = path.name.lower()
    if suffix == ".md" and ".ocr" in name:
        return "ocr"
    if suffix in {".png", ".jpg", ".jpeg", ".webp", ".gif"}:
        if "screenshot" in name or "screen" in name:
            return "screenshot"
        return "note_image"
    return "other"


def collect_attachments(workspace: Path, file_path: str) -> list[dict[str, str]]:
    markdown_path = workspace / file_path
    assets_dir = markdown_path.with_suffix(".assets")
    if not assets_dir.is_dir():
        return []

    attachments = []
    for path in sorted(item for item in assets_dir.iterdir() if item.is_file()):
        attachments.append(
            {
                "path": path.relative_to(markdown_path.parent).as_posix(),
                "kind": attachment_kind(path),
            }
        )
    return attachments


def attachment_counts(attachments: list[dict[str, str]]) -> dict[str, str]:
    return {
        "attachment_count": str(len(attachments)),
        "ocr_count": str(sum(1 for item in attachments if item["kind"] == "ocr")),
        "screenshot_count": str(sum(1 for item in attachments if item["kind"] == "screenshot")),
        "note_image_count": str(sum(1 for item in attachments if item["kind"] == "note_image")),
    }


def known_source_columns() -> set[str]:
    return set(FIELD_COLUMNS) | set(REFLECTION_COLUMNS) | set(HABIT_COLUMNS) | set(SOURCE_ID_COLUMNS)


def unmapped_fields(row: dict[str, str]) -> dict[str, str]:
    known = known_source_columns()
    return {
        key: value.strip()
        for key, value in row.items()
        if key not in known and value.strip()
    }


def build_record(row: dict[str, str], row_number: int, source_database: str, privacy: str) -> dict:
    check_date = parse_check_in_date(row.get("Data", ""))
    date_text = check_date.isoformat()
    row_id = source_row_id(row, row_number)
    title = row.get("Name", "").strip() or f"Daily check-in {date_text}"
    day_mode_raw = row.get("Tryb dnia", "").strip()
    sleep_range = parse_time_range(row.get("Sen", ""), check_date)
    if_range = parse_time_range(row.get("IF (intermittent-fasting)", ""), check_date)
    training_range = parse_time_range(row.get("Trening", ""), check_date)
    nsdr_range = parse_time_range(row.get("NSDR", ""), check_date)

    habits = []
    for label in HABIT_COLUMNS:
        if label in row:
            raw_value = row.get(label, "")
            parsed = normalize_bool(raw_value)
            habits.append(
                {
                    "slug": normalize_slug(label),
                    "label": label,
                    "value": parsed,
                    "raw_value": raw_value,
                }
            )

    reflections = {
        key: row.get(column, "").strip()
        for column, (key, _section_title) in REFLECTION_COLUMNS.items()
    }

    frontmatter = {
        "type": "daily-check-in",
        "date": date_text,
        "title": title,
        "source": "notion-migration",
        "source_provider": "notion",
        "source_database": source_database,
        "source_row_id": row_id,
        "privacy": privacy,
        "minimum_day_done": normalize_bool(row.get("Czy zrobiłem MINIMUM DNIA?", "")),
        "day_mode": normalize_day_mode(day_mode_raw),
        "day_mode_raw": day_mode_raw,
        "body_subjective": row.get("Ciało (subiektywnie)", "").strip(),
        "energy_subjective": row.get("Energia (subiektywnie)", "").strip(),
        "mental_subjective": row.get("Mental (subiektywnie)", "").strip(),
        "routine_state_subjective": row.get("Stan po rutynie (subiektywnie)", "").strip(),
        "limitations_subjective": row.get("Ograniczenia (subiektywnie)", "").strip(),
        "sleep_start": sleep_range.start,
        "sleep_end": sleep_range.end,
        "sleep_raw": sleep_range.raw,
        "if_start": if_range.start,
        "if_end": if_range.end,
        "if_raw": if_range.raw,
        "training_start": training_range.start,
        "training_end": training_range.end,
        "training_raw": training_range.raw,
        "nsdr_start": nsdr_range.start,
        "nsdr_end": nsdr_range.end,
        "nsdr_raw": nsdr_range.raw,
        "day_plan_status": "",
        "morning_check_in_status": "",
        "afternoon_check_in_status": "",
        "next_day_seed_status": "",
    }

    file_path = Path("personal-ops") / "check-ins" / check_date.strftime("%Y") / f"{date_text}.md"
    phases = {
        "day_plan": {
            "Data": date_text,
            "Sen od-do": time_range_text(sleep_range),
            "Trening od-do": time_range_text(training_range),
            "NSDR od-do": time_range_text(nsdr_range),
            "IF od-do": time_range_text(if_range),
            "Tryb dnia": day_mode_raw,
            "Zbudowałem": reflections.get("built", ""),
            "Dowiozłem": reflections.get("delivered", ""),
            "Wypromowałem": reflections.get("promoted", ""),
            "Coś dla ciała": reflections.get("body", ""),
            "Coś dla ducha": reflections.get("spirit", ""),
            "Coś dla bliskich": reflections.get("close_people", ""),
        },
        "morning": {
            "Pobudka": bool_text(next((habit["value"] for habit in habits if "Pobudka" in habit["label"]), "")),
            "Kuchnia": bool_text(next((habit["value"] for habit in habits if habit["label"].startswith("Kuchnia:")), "")),
            "Dwór": bool_text(next((habit["value"] for habit in habits if habit["label"].startswith("Dwór:")), "")),
            "Napiłem się": bool_text(next((habit["value"] for habit in habits if habit["label"].startswith("Napiłem")), "")),
            "Mantra": reflections.get("mantra", ""),
            "Deep Focus": bool_text(next((habit["value"] for habit in habits if habit["label"].startswith("Muzyka Deep Focus")), "")),
            "Mama i Oliwia": bool_text(next((habit["value"] for habit in habits if habit["label"].startswith("Mama i Oliwia")), "")),
            "Insta Story": bool_text(next((habit["value"] for habit in habits if habit["label"].startswith("Insta Story")), "")),
            "Stan po rutynie": frontmatter["routine_state_subjective"],
            "Energia": frontmatter["energy_subjective"],
            "Mental": frontmatter["mental_subjective"],
            "Ciało": frontmatter["body_subjective"],
            "Ograniczenia": frontmatter["limitations_subjective"],
            "Jestem wdzięczny": reflections.get("gratitude", ""),
            "Zagrożenie dnia": reflections.get("threat", ""),
        },
        "afternoon": {
            "Czy zrobiłem minimum": bool_text(frontmatter["minimum_day_done"]),
            "Nawyki": reflections.get("habits_text", ""),
            "Co dało +1%": reflections.get("plus_one", ""),
            "Co było zbędne": reflections.get("redundant", ""),
        },
        "next_day_seed": {field: "" for field in PLAN_FIELDS},
        "additional": {
            "Dodatkowe informacje": reflections.get("additional", ""),
            "Załączniki": "",
        },
    }

    return {
        "date": date_text,
        "file_path": file_path.as_posix(),
        "frontmatter": frontmatter,
        "phases": phases,
        "habits": habits,
        "reflections": reflections,
        "sleep_range": sleep_range,
        "if_range": if_range,
        "training_range": training_range,
        "nsdr_range": nsdr_range,
        "unmapped_fields": unmapped_fields(row),
        "attachments": [],
    }


def render_markdown(record: dict) -> str:
    lines = ["---"]
    for key, value in record["frontmatter"].items():
        lines.append(f"{key}: {yaml_value(value)}")
    lines.extend(["---", "", f"# {record['frontmatter']['title']}", ""])

    phase_order = [
        ("1. Plan dnia", "day_plan", PLAN_FIELDS),
        (
            "2. Poranny check-in",
            "morning",
            [
                "Pobudka",
                "Kuchnia",
                "Dwór",
                "Napiłem się",
                "Mantra",
                "Deep Focus",
                "Mama i Oliwia",
                "Insta Story",
                "Stan po rutynie",
                "Energia",
                "Mental",
                "Ciało",
                "Ograniczenia",
                "Jestem wdzięczny",
                "Zagrożenie dnia",
            ],
        ),
        (
            "3. Popołudniowy check-in",
            "afternoon",
            ["Czy zrobiłem minimum", "Nawyki", "Co dało +1%", "Co było zbędne"],
        ),
        ("4. Seed kolejnego dnia", "next_day_seed", PLAN_FIELDS),
        ("5. Dodatkowe informacje", "additional", ["Dodatkowe informacje", "Załączniki"]),
    ]

    for heading, phase_key, fields in phase_order:
        lines.append(f"## {heading}")
        lines.append("")
        for field in fields:
            value = record["phases"].get(phase_key, {}).get(field, "")
            if phase_key == "additional" and field == "Załączniki":
                if record.get("attachments"):
                    value = "\n".join(f"- {item['path']}" for item in record["attachments"])
                else:
                    value = "- "
            lines.append(markdown_subsection(field, value).rstrip())
            lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def csv_row(record: dict) -> dict[str, str]:
    frontmatter = record["frontmatter"]
    habits = record["habits"]
    habit_done = sum(1 for habit in habits if habit["value"] is True)
    row = {
        "date": record["date"],
        "file_path": record["file_path"],
        "source_provider": frontmatter["source_provider"],
        "source_row_id": frontmatter["source_row_id"],
        "minimum_day_done": str(frontmatter["minimum_day_done"]).lower() if frontmatter["minimum_day_done"] != "" else "",
        "day_mode": frontmatter["day_mode"],
        "body_subjective": frontmatter["body_subjective"],
        "energy_subjective": frontmatter["energy_subjective"],
        "mental_subjective": frontmatter["mental_subjective"],
        "routine_state_subjective": frontmatter["routine_state_subjective"],
        "limitations_subjective": frontmatter["limitations_subjective"],
        "sleep_start": frontmatter["sleep_start"],
        "sleep_end": frontmatter["sleep_end"],
        "sleep_hours": record["sleep_range"].hours,
        "if_start": frontmatter["if_start"],
        "if_end": frontmatter["if_end"],
        "if_hours": record["if_range"].hours,
        "training_start": frontmatter["training_start"],
        "training_end": frontmatter["training_end"],
        "training_minutes": record["training_range"].minutes,
        "nsdr_start": frontmatter["nsdr_start"],
        "nsdr_end": frontmatter["nsdr_end"],
        "nsdr_minutes": record["nsdr_range"].minutes,
        "habit_count_done": str(habit_done),
        "habit_count_total": str(len(habits)),
        "has_plus_one": str(bool(record["reflections"].get("plus_one"))).lower(),
        "has_threat": str(bool(record["reflections"].get("threat"))).lower(),
        "has_built": str(bool(record["reflections"].get("built"))).lower(),
        "has_delivered": str(bool(record["reflections"].get("delivered"))).lower(),
        "has_promoted": str(bool(record["reflections"].get("promoted"))).lower(),
        "has_body_action": str(bool(record["reflections"].get("body"))).lower(),
        "has_spirit_action": str(bool(record["reflections"].get("spirit"))).lower(),
        "has_close_people_action": str(bool(record["reflections"].get("close_people"))).lower(),
        "has_gratitude": str(bool(record["reflections"].get("gratitude"))).lower(),
        "has_redundant": str(bool(record["reflections"].get("redundant"))).lower(),
        **attachment_counts(record.get("attachments", [])),
    }
    for habit in habits:
        value = habit["value"]
        row[f"habit_{habit['slug']}"] = str(value).lower() if value != "" else ""
    return row


def metrics_row(record: dict) -> dict[str, str]:
    row = csv_row(record)
    return {column: row.get(column, "") for column in METRICS_INDEX_COLUMNS}


def render_field_dictionary(fieldnames: list[str]) -> str:
    lines = [
        "# Daily Check-In Field Dictionary",
        "",
        "Source labels are preserved for auditability. Raw source content remains context-as-data.",
        "",
        "| Source column | Target |",
        "| --- | --- |",
    ]
    for field in fieldnames:
        if field in FIELD_COLUMNS:
            target = FIELD_COLUMNS[field]
        elif field in REFLECTION_COLUMNS:
            target = f"section `{REFLECTION_COLUMNS[field][1]}`"
        elif field in HABIT_COLUMNS:
            target = f"habit_{normalize_slug(field)}"
        elif field in SOURCE_ID_COLUMNS:
            target = "source_row_id"
        else:
            target = "unmapped source column"
        lines.append(f"| `{field}` | {target} |")
    return "\n".join(lines) + "\n"


def write_conflicts(workspace: Path, conflicts: dict[str, list[str]], dry_run: bool) -> None:
    target = workspace / "personal-ops" / "indexes" / "check-ins-conflicts.md"
    lines = [
        "# Daily Check-In Conflicts",
        "",
        "Duplicate check-in dates with different source_row_id values were detected.",
        "Resolve before writing canonical Markdown files.",
        "",
    ]
    for date_text, row_ids in conflicts.items():
        lines.append(f"## {date_text}")
        for row_id in row_ids:
            lines.append(f"- {row_id}")
        lines.append("")
    if dry_run:
        print(f"would write conflict report: {target}")
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def detect_conflicts(records: list[dict]) -> dict[str, list[str]]:
    by_date: dict[str, set[str]] = {}
    for record in records:
        by_date.setdefault(record["date"], set()).add(record["frontmatter"]["source_row_id"])
    return {date_text: sorted(row_ids) for date_text, row_ids in by_date.items() if len(row_ids) > 1}


def dedupe_same_source(records: list[dict]) -> list[dict]:
    """Keep the last row for the same date and source_row_id."""
    order: list[tuple[str, str]] = []
    by_key: dict[tuple[str, str], dict] = {}
    for record in records:
        key = (record["date"], record["frontmatter"]["source_row_id"])
        if key not in by_key:
            order.append(key)
        by_key[key] = record
    return [by_key[key] for key in order]


def write_outputs(records: list[dict], fieldnames: list[str], workspace: Path, dry_run: bool) -> None:
    index_dir = workspace / "personal-ops" / "indexes"
    check_in_dir = workspace / "personal-ops" / "check-ins"
    csv_path = index_dir / "check-ins.csv"
    jsonl_path = index_dir / "check-ins.jsonl"
    metrics_path = index_dir / "check-ins.metrics.csv"
    router_path = index_dir / "check-ins.md"
    fields_path = index_dir / "check-ins-fields.md"

    targets = [workspace / record["file_path"] for record in records]
    targets.extend([csv_path, jsonl_path, metrics_path, router_path, fields_path])

    if dry_run:
        for target in targets:
            print(f"would write: {target}")
        return

    check_in_dir.mkdir(parents=True, exist_ok=True)
    index_dir.mkdir(parents=True, exist_ok=True)

    for record in records:
        record["attachments"] = collect_attachments(workspace, record["file_path"])

    for record in records:
        target = workspace / record["file_path"]
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(render_markdown(record), encoding="utf-8")

    csv_rows = [csv_row(record) for record in records]
    habit_columns = sorted(
        {
            key
            for row in csv_rows
            for key in row.keys()
            if key.startswith("habit_") and key not in REQUIRED_INDEX_COLUMNS
        }
    )
    fieldnames_out = REQUIRED_INDEX_COLUMNS + habit_columns
    with csv_path.open("w", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=fieldnames_out, extrasaction="ignore")
        writer.writeheader()
        for row in csv_rows:
            writer.writerow(row)

    with metrics_path.open("w", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=METRICS_INDEX_COLUMNS, extrasaction="ignore")
        writer.writeheader()
        for record in records:
            writer.writerow(metrics_row(record))

    with jsonl_path.open("w", encoding="utf-8") as handle:
        for record in records:
            payload = {
                "date": record["date"],
                "file_path": record["file_path"],
                "frontmatter": record["frontmatter"],
                "phases": record["phases"],
                "habits": record["habits"],
                "reflections": record["reflections"],
                "attachments": record.get("attachments", []),
                "unmapped_fields": record.get("unmapped_fields", {}),
            }
            handle.write(json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")

    router = "\n".join(
        [
            "# Daily Check-In Index",
            "",
            "Markdown files in `personal-ops/check-ins/` are the source of truth.",
            "The CSV and JSONL files are generated analytical indexes.",
            "",
            "- `check-ins.csv`",
            "- `check-ins.jsonl`",
            "- `check-ins.metrics.csv`",
            "- `check-ins-fields.md`",
            "- `check-ins-conflicts.md`",
            "",
            "## Lazy Sync State",
            "",
            f"- last-synced-at: {datetime.now().isoformat(timespec='seconds')}",
            f"- last-synced-check-in-count: {len(records)}",
            f"- current-check-in-count: {len(records)}",
            "- unsynced-check-in-count: 0",
            "- sync-recommendation-threshold: 7",
            "- last-sync-source: notion-import",
            "- latest-unsynced-dates: none",
            "- sync-recommendation: not required yet",
            "",
            "Indexes may be stale by design. Run `.systems/scripts/sync-personal-ops-check-ins --workspace <workspace>` only with exact owner approval.",
        ]
    )
    router_path.write_text(router + "\n", encoding="utf-8")
    fields_path.write_text(render_field_dictionary(fieldnames), encoding="utf-8")


def load_records(input_path: Path, source_database: str, privacy: str) -> tuple[list[dict], list[str]]:
    with input_path.open(newline="", encoding="utf-8-sig") as handle:
        reader = csv.DictReader(handle)
        if not reader.fieldnames:
            raise ValueError("CSV file has no header row.")
        records = []
        for row_number, row in enumerate(reader, start=1):
            cleaned_row = {key: (value or "") for key, value in row.items() if key is not None}
            if any(value.strip() for value in cleaned_row.values()):
                records.append(
                    build_record(cleaned_row, row_number, source_database=source_database, privacy=privacy)
                )
        return records, list(reader.fieldnames)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", required=True, type=Path, help="Notion daily check-in CSV export.")
    parser.add_argument("--workspace", required=True, type=Path, help="Selected AI System workspace path.")
    parser.add_argument("--source-database", default="daily-check-in")
    parser.add_argument("--privacy", default="private-sensitive")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    try:
        records, fieldnames = load_records(args.input, args.source_database, args.privacy)
        if not records:
            raise ValueError("CSV file has no check-in rows.")
        records = dedupe_same_source(records)
        conflicts = detect_conflicts(records)
        if conflicts:
            write_conflicts(args.workspace, conflicts, args.dry_run)
            print("STOP: duplicate check-in dates with different source_row_id values detected.", file=sys.stderr)
            return 2
        write_outputs(records, fieldnames, args.workspace, args.dry_run)
    except Exception as exc:  # noqa: BLE001 - command-line tool should print concise failures.
        print(f"STOP: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
