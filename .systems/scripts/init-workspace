#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: .systems/scripts/init-workspace [options]

Options:
  --workspace <path>     workspace path (default: selected workspace or ./ai-system-workspace)
  --workspace-id <id>    workspace id written to core/status.md (default: registry id or path basename)
  --workspace-profile <generic|primary-entity>
                         workspace structure profile (default: generic)
  --primary-entity-slug <slug>
                         primary entity slug for primary-entity profile (default: workspace id)
  --primary-entity-label <label>
                         primary entity label for primary-entity profile (default: workspace id)
  --primary-entity-type <type>
                         primary entity type for primary-entity profile (default: primary-entity)
  --primary-entity-owner <owner>
                         primary entity owner for primary-entity profile (default: unknown)
  --operating-lens <lens>
                         operating lens for primary-entity profile (default: not-set)
  -h, --help             show this help
EOF
}

workspace_arg=""
workspace_id_arg=""
workspace_profile="generic"
primary_entity_slug_arg=""
primary_entity_label_arg=""
primary_entity_type_arg=""
primary_entity_owner_arg=""
operating_lens_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workspace)
      workspace_arg="${2:-}"
      [[ -n "$workspace_arg" ]] || { echo "Missing value for --workspace"; exit 2; }
      shift 2
      ;;
    --workspace-id)
      workspace_id_arg="${2:-}"
      [[ -n "$workspace_id_arg" ]] || { echo "Missing value for --workspace-id"; exit 2; }
      shift 2
      ;;
    --workspace-profile)
      workspace_profile="${2:-}"
      [[ -n "$workspace_profile" ]] || { echo "Missing value for --workspace-profile"; exit 2; }
      shift 2
      ;;
    --primary-entity-slug)
      primary_entity_slug_arg="${2:-}"
      [[ -n "$primary_entity_slug_arg" ]] || { echo "Missing value for --primary-entity-slug"; exit 2; }
      shift 2
      ;;
    --primary-entity-label)
      primary_entity_label_arg="${2:-}"
      [[ -n "$primary_entity_label_arg" ]] || { echo "Missing value for --primary-entity-label"; exit 2; }
      shift 2
      ;;
    --primary-entity-type)
      primary_entity_type_arg="${2:-}"
      [[ -n "$primary_entity_type_arg" ]] || { echo "Missing value for --primary-entity-type"; exit 2; }
      shift 2
      ;;
    --primary-entity-owner)
      primary_entity_owner_arg="${2:-}"
      [[ -n "$primary_entity_owner_arg" ]] || { echo "Missing value for --primary-entity-owner"; exit 2; }
      shift 2
      ;;
    --operating-lens)
      operating_lens_arg="${2:-}"
      [[ -n "$operating_lens_arg" ]] || { echo "Missing value for --operating-lens"; exit 2; }
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

case "$workspace_profile" in
  generic|primary-entity)
    ;;
  *)
    echo "Unknown workspace profile: $workspace_profile"
    usage
    exit 2
    ;;
esac

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ai_system_home="$(cd "$script_dir/../.." && pwd -P)"
templates="$ai_system_home/.systems/ai/templates/workspace"
source "$script_dir/lib-workspaces"

if [[ -n "$workspace_arg" ]]; then
  workspace_home="$workspace_arg"
elif [[ -n "${AI_SYSTEM_WORKSPACE_HOME:-}" ]]; then
  workspace_home="$AI_SYSTEM_WORKSPACE_HOME"
else
  default_workspaces=()
  registry_file="$(ai_system_workspace_registry_file "$ai_system_home")"
  while IFS= read -r default_workspace; do
    default_workspaces+=("$default_workspace")
  done < <(ai_system_workspace_registry_default_paths "$ai_system_home")
  if [[ "${#default_workspaces[@]}" -gt 1 ]]; then
    echo "STOP: multiple default workspaces in ai-system-workspaces.md"
    exit 1
  elif [[ "${#default_workspaces[@]}" -eq 1 ]]; then
    workspace_home="${default_workspaces[0]}"
  elif [[ -f "$registry_file" ]]; then
    echo "STOP: ai-system-workspaces.md exists but no default=yes workspace is defined"
    exit 1
  else
    workspace_home="$ai_system_home/ai-system-workspace"
  fi
fi

mkdir -p "$workspace_home"
workspace_home="$(cd "$workspace_home" && pwd -P)"
workspace_home_relative="$(ai_system_workspace_relative_path "$ai_system_home" "$workspace_home")"

workspace_id="$workspace_id_arg"
if [[ -z "$workspace_id" ]]; then
  workspace_id="$(ai_system_workspace_registry_id_for_path "$ai_system_home" "$workspace_home" || true)"
fi
if [[ -z "$workspace_id" ]]; then
  workspace_id="$(basename "$workspace_home")"
fi

primary_entity_slug="${primary_entity_slug_arg:-$workspace_id}"
primary_entity_label="${primary_entity_label_arg:-$workspace_id}"
primary_entity_type="${primary_entity_type_arg:-primary-entity}"
primary_entity_owner="${primary_entity_owner_arg:-unknown}"
operating_lens="${operating_lens_arg:-not-set}"

relative_path() {
  local path="$1"

  if [[ "$path" == "$ai_system_home/"* ]]; then
    echo "${path#$ai_system_home/}"
  else
    echo "$path"
  fi
}

ensure_dir() {
  local destination="$1"

  if [[ -d "$destination" ]]; then
    echo "kept existing dir: $(relative_path "$destination")"
    return 0
  fi

  mkdir -p "$destination"
  echo "created dir: $(relative_path "$destination")"
}

copy_template() {
  local source="$1"
  local destination="$2"

  if [[ ! -f "$source" ]]; then
    echo "Missing template: $(relative_path "$source")"
    exit 1
  fi

  if [[ -e "$destination" ]]; then
    echo "kept existing file: $(relative_path "$destination")"
    return 0
  fi

  mkdir -p "$(dirname "$destination")"
  cp "$source" "$destination"
  echo "created file: $(relative_path "$destination")"
}

copy_template_with_date() {
  local source="$1"
  local destination="$2"
  local today

  if [[ ! -f "$source" ]]; then
    echo "Missing template: $(relative_path "$source")"
    exit 1
  fi

  if [[ -e "$destination" ]]; then
    echo "kept existing file: $(relative_path "$destination")"
    return 0
  fi

  today="$(date +%F)"
  mkdir -p "$(dirname "$destination")"
  sed "s/<YYYY-MM-DD>/$today/g" "$source" > "$destination"
  echo "created file: $(relative_path "$destination")"
}

copy_template_with_context() {
  local source="$1"
  local destination="$2"
  local today
  local escaped_workspace_id
  local escaped_workspace_home
  local escaped_primary_entity_slug
  local escaped_primary_entity_label
  local escaped_primary_entity_type
  local escaped_primary_entity_owner
  local escaped_operating_lens

  if [[ ! -f "$source" ]]; then
    echo "Missing template: $(relative_path "$source")"
    exit 1
  fi

  if [[ -e "$destination" ]]; then
    echo "kept existing file: $(relative_path "$destination")"
    return 0
  fi

  today="$(date +%F)"
  escaped_workspace_id="${workspace_id//&/\\&}"
  escaped_workspace_home="${workspace_home_relative//&/\\&}"
  escaped_primary_entity_slug="${primary_entity_slug//&/\\&}"
  escaped_primary_entity_label="${primary_entity_label//&/\\&}"
  escaped_primary_entity_type="${primary_entity_type//&/\\&}"
  escaped_primary_entity_owner="${primary_entity_owner//&/\\&}"
  escaped_operating_lens="${operating_lens//&/\\&}"
  mkdir -p "$(dirname "$destination")"
  sed \
    -e "s|<YYYY-MM-DD>|$today|g" \
    -e "s|<WORKSPACE_ID>|$escaped_workspace_id|g" \
    -e "s|<WORKSPACE_HOME>|$escaped_workspace_home|g" \
    -e "s|<PRIMARY_ENTITY_SLUG>|$escaped_primary_entity_slug|g" \
    -e "s|<PRIMARY_ENTITY_LABEL>|$escaped_primary_entity_label|g" \
    -e "s|<PRIMARY_ENTITY_TYPE>|$escaped_primary_entity_type|g" \
    -e "s|<PRIMARY_ENTITY_OWNER>|$escaped_primary_entity_owner|g" \
    -e "s|<OPERATING_LENS>|$escaped_operating_lens|g" \
    "$source" > "$destination"
  echo "created file: $(relative_path "$destination")"
}

copy_primary_entity_directory_readme() {
  local destination="$1"
  local directory_label="$2"
  local directory_purpose="$3"
  local source="$templates/primary-entity-directory-readme.template.md"
  local today
  local escaped_workspace_id
  local escaped_workspace_home
  local escaped_primary_entity_slug
  local escaped_primary_entity_label
  local escaped_primary_entity_type
  local escaped_primary_entity_owner
  local escaped_operating_lens
  local escaped_directory_label
  local escaped_directory_purpose

  if [[ ! -f "$source" ]]; then
    echo "Missing template: $(relative_path "$source")"
    exit 1
  fi

  if [[ -e "$destination" ]]; then
    echo "kept existing file: $(relative_path "$destination")"
    return 0
  fi

  today="$(date +%F)"
  escaped_workspace_id="${workspace_id//&/\\&}"
  escaped_workspace_home="${workspace_home_relative//&/\\&}"
  escaped_primary_entity_slug="${primary_entity_slug//&/\\&}"
  escaped_primary_entity_label="${primary_entity_label//&/\\&}"
  escaped_primary_entity_type="${primary_entity_type//&/\\&}"
  escaped_primary_entity_owner="${primary_entity_owner//&/\\&}"
  escaped_operating_lens="${operating_lens//&/\\&}"
  escaped_directory_label="${directory_label//&/\\&}"
  escaped_directory_purpose="${directory_purpose//&/\\&}"
  mkdir -p "$(dirname "$destination")"
  sed \
    -e "s|<YYYY-MM-DD>|$today|g" \
    -e "s|<WORKSPACE_ID>|$escaped_workspace_id|g" \
    -e "s|<WORKSPACE_HOME>|$escaped_workspace_home|g" \
    -e "s|<PRIMARY_ENTITY_SLUG>|$escaped_primary_entity_slug|g" \
    -e "s|<PRIMARY_ENTITY_LABEL>|$escaped_primary_entity_label|g" \
    -e "s|<PRIMARY_ENTITY_TYPE>|$escaped_primary_entity_type|g" \
    -e "s|<PRIMARY_ENTITY_OWNER>|$escaped_primary_entity_owner|g" \
    -e "s|<OPERATING_LENS>|$escaped_operating_lens|g" \
    -e "s|<PRIMARY_ENTITY_DIRECTORY_LABEL>|$escaped_directory_label|g" \
    -e "s|<PRIMARY_ENTITY_DIRECTORY_PURPOSE>|$escaped_directory_purpose|g" \
    "$source" > "$destination"
  echo "created file: $(relative_path "$destination")"
}

ensure_dir "$workspace_home/core"
ensure_dir "$workspace_home/dump/incoming"
ensure_dir "$workspace_home/clients"
ensure_dir "$workspace_home/projects"
ensure_dir "$workspace_home/project-state"
ensure_dir "$workspace_home/capture-state"
ensure_dir "$workspace_home/micro-projects"
ensure_dir "$workspace_home/humans"
ensure_dir "$workspace_home/links"
ensure_dir "$workspace_home/memory"
ensure_dir "$workspace_home/external-memory"
ensure_dir "$workspace_home/external-memory/memory"
ensure_dir "$workspace_home/system-insights"
ensure_dir "$workspace_home/system-insights/insights"
ensure_dir "$workspace_home/personal-ops"
ensure_dir "$workspace_home/personal-ops/check-ins"
ensure_dir "$workspace_home/personal-ops/check-ins/import-profiles"
ensure_dir "$workspace_home/personal-ops/indexes"
ensure_dir "$workspace_home/dreams"
ensure_dir "$workspace_home/dreams/runs"
ensure_dir "$workspace_home/checkpoints"
ensure_dir "$workspace_home/checkpoints/blocks"
ensure_dir "$workspace_home/tasks"
ensure_dir "$workspace_home/tasks/weekly-plans"
# weekly-planning creates only neutral plan routers/templates; it never creates a real plan or TaskNote.
ensure_dir "$workspace_home/skills"
ensure_dir "$workspace_home/archive"

if [[ "$workspace_profile" == "generic" ]]; then
  ensure_dir "$workspace_home/owned-assets"
  copy_template_with_context "$templates/workspace-readme.template.md" "$workspace_home/README.md"
else
  ensure_dir "$workspace_home/assets"
  ensure_dir "$workspace_home/checkpoints"
  ensure_dir "$workspace_home/contacts"
  ensure_dir "$workspace_home/context"
  ensure_dir "$workspace_home/contracts"
  ensure_dir "$workspace_home/decisions"
  ensure_dir "$workspace_home/distillations"
  ensure_dir "$workspace_home/documents"
  ensure_dir "$workspace_home/notes"
  ensure_dir "$workspace_home/tasks"
  copy_template_with_context "$templates/primary-entity-workspace-readme.template.md" "$workspace_home/README.md"
  copy_template_with_context "$templates/primary-entity-status.template.md" "$workspace_home/status.md"
  copy_template_with_context "$templates/primary-entity-memory.template.md" "$workspace_home/memory.md"
  copy_primary_entity_directory_readme "$workspace_home/assets/README.md" "Primary Entity Assets" "Store reusable primary entity assets such as brand, identity, offer, sales, delivery, legal, finance, operations, content, and website materials."
  copy_primary_entity_directory_readme "$workspace_home/checkpoints/README.md" "Primary Entity Checkpoints" "Store primary entity state snapshots for safe resume after major decisions, migrations, triage, or long pauses."
  copy_primary_entity_directory_readme "$workspace_home/contacts/README.md" "Primary Entity Contacts" "Store contact notes and relationship context connected to the primary entity."
  copy_primary_entity_directory_readme "$workspace_home/context/README.md" "Primary Entity Context" "Store source context, background, positioning, business constraints, and owner-approved intake notes for the primary entity."
  copy_primary_entity_directory_readme "$workspace_home/contracts/README.md" "Primary Entity Contracts" "Store owner-approved contract references and contract materials for the primary entity."
  copy_primary_entity_directory_readme "$workspace_home/decisions/README.md" "Primary Entity Decisions" "Store durable primary entity decisions, open decisions, and decision evidence."
  copy_primary_entity_directory_readme "$workspace_home/distillations/README.md" "Primary Entity Distillations" "Store compressed summaries and lessons distilled from primary entity memory, notes, and materials."
  copy_primary_entity_directory_readme "$workspace_home/documents/README.md" "Primary Entity Documents" "Store owner-approved documents that belong to the primary entity."
  copy_primary_entity_directory_readme "$workspace_home/dump/incoming/README.md" "Primary Entity Incoming Dump" "Drop unclassified files here when ownership is unknown, mixed, or already known to belong to the primary entity."
  copy_primary_entity_directory_readme "$workspace_home/notes/README.md" "Primary Entity Notes" "Store raw and working notes for the primary entity before they are promoted into memory, decisions, tasks, or documents."
fi

copy_template "$templates/tasks/task-management-readme.template.md" "$workspace_home/tasks/README.md"
copy_template "$templates/tasks/tasknote.template.md" "$workspace_home/tasks/tasknote.template.md"
copy_template "$templates/tasks/task-candidate.template.md" "$workspace_home/tasks/task-candidate.template.md"
copy_template "$templates/tasks/taskforge-vault-setup.template.md" "$workspace_home/tasks/taskforge-vault-setup.template.md"
copy_template "$templates/tasks/weekly-plan.template.md" "$workspace_home/tasks/weekly-plan.template.md"
copy_template "$templates/tasks/weekly-plan.template.md" "$workspace_home/tasks/weekly-plans/weekly-plan.template.md"
copy_template "$templates/tasks/weekly-plans-readme.template.md" "$workspace_home/tasks/weekly-plans/README.md"

copy_template "$templates/core/README.md" "$workspace_home/core/README.md"
copy_template_with_context "$templates/core/status.template.md" "$workspace_home/core/status.md"
copy_template_with_context "$templates/core/workstreams.template.md" "$workspace_home/core/workstreams.md"
copy_template "$templates/dump/README.md" "$workspace_home/dump/README.md"
copy_template "$templates/clients/README.md" "$workspace_home/clients/README.md"
if [[ "$workspace_profile" == "generic" ]]; then
  copy_template "$templates/owned-assets/README.md" "$workspace_home/owned-assets/README.md"
fi
copy_template "$templates/projects/README.md" "$workspace_home/projects/README.md"
copy_template "$templates/project-state/project-state-readme.template.md" "$workspace_home/project-state/README.md"
copy_template "$templates/project-state/project-state.template.md" "$workspace_home/project-state/project-state.md"
copy_template "$templates/capture-state/capture-state-readme.template.md" "$workspace_home/capture-state/README.md"
copy_template "$templates/capture-state/capture-state.template.md" "$workspace_home/capture-state/capture-state.md"
copy_template "$templates/checkpoints/README.md" "$workspace_home/checkpoints/README.md"
copy_template "$templates/checkpoints/blocks/README.md" "$workspace_home/checkpoints/blocks/README.md"
copy_template "$templates/micro-projects/README.md" "$workspace_home/micro-projects/README.md"
copy_template "$templates/humans/README.md" "$workspace_home/humans/README.md"
copy_template "$templates/links/links-readme.template.md" "$workspace_home/links/README.md"
copy_template "$templates/memory/README.md" "$workspace_home/memory/README.md"
copy_template "$templates/memory/workspace-memory.template.md" "$workspace_home/memory/workspace-memory.md"
copy_template "$templates/external-memory/README.md" "$workspace_home/external-memory/README.md"
copy_template "$templates/external-memory/memory/README.md" "$workspace_home/external-memory/memory/README.md"
copy_template "$templates/system-insights/system-insights-readme.template.md" "$workspace_home/system-insights/README.md"
copy_template "$templates/system-insights/system-insights.template.md" "$workspace_home/system-insights/system-insights.md"
copy_template "$templates/system-insights/insights-readme.template.md" "$workspace_home/system-insights/insights/README.md"
copy_template "$templates/personal-ops/personal-ops-readme.template.md" "$workspace_home/personal-ops/README.md"
copy_template "$templates/personal-ops/check-ins-readme.template.md" "$workspace_home/personal-ops/check-ins/README.md"
copy_template "$templates/personal-ops/manual-daily-check-in.template.md" "$workspace_home/personal-ops/check-ins/import-profiles/manual-daily-check-in.md"
copy_template "$templates/personal-ops/check-ins-v3-index.template.md" "$workspace_home/personal-ops/indexes/check-ins-v3.md"
# check-in-settings.local.md and taskforge-vault.local.md are owner-created local-only settings.
# Do not create populated local configuration or private vault paths during bootstrap.
copy_template "$templates/dreams/dreams-readme.template.md" "$workspace_home/dreams/README.md"
copy_template "$templates/dreams/dreaming-scope.local.template.md" "$workspace_home/dreams/dreaming-scope.local.md"
copy_template "$templates/skills/README.md" "$workspace_home/skills/README.md"
copy_template "$templates/archive/README.md" "$workspace_home/archive/README.md"

echo
echo "AI_SYSTEM_HOME: $ai_system_home"
echo "AI_SYSTEM_WORKSPACE_HOME: $workspace_home"
echo "AI_SYSTEM_WORKSPACE_ID: $workspace_id"
echo "AI_SYSTEM_WORKSPACE_PROFILE: $workspace_profile"
if [[ "$workspace_profile" == "primary-entity" ]]; then
  echo "AI_SYSTEM_PRIMARY_ENTITY: $primary_entity_slug"
fi
echo
echo "Next prompt:"
echo "Review selected AI System workspace status and recommend the next safe action."
