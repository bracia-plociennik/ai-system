#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: .systems/scripts/init-ai-system [options]

Options:
  --refresh-agents    overwrite root AGENTS.md from the committed template
  -h, --help          show this help
EOF
}

refresh_agents="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --refresh-agents)
      refresh_agents="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ai_system_home="$(cd "$script_dir/../.." && pwd -P)"
template="$ai_system_home/.systems/ai/templates/root/AGENTS.template.md"
agents="$ai_system_home/AGENTS.md"

relative_path() {
  local path="$1"

  if [[ "$path" == "$ai_system_home/"* ]]; then
    echo "${path#$ai_system_home/}"
  else
    echo "$path"
  fi
}

if [[ ! -f "$template" ]]; then
  echo "Missing template: $(relative_path "$template")"
  exit 1
fi

if [[ -e "$agents" && "$refresh_agents" != "true" ]]; then
  echo "kept existing file: $(relative_path "$agents")"
else
  action="created"
  if [[ -e "$agents" ]]; then
    action="refreshed"
  fi
  cp "$template" "$agents"
  chmod 0644 "$agents"
  echo "$action file: $(relative_path "$agents")"
fi

echo
echo "AI_SYSTEM_HOME: $ai_system_home"
echo "AGENTS_TEMPLATE: $(relative_path "$template")"
echo "AGENTS_LOCAL: $(relative_path "$agents")"
