#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
profile="standard"

# The declared standard chain is the producer of the execution plan.
# Scoped checks use explicit registry dependencies; fast uses shared sanity checks.
# AI_SYSTEM_SKIP_SMOKE_TESTS always produces supporting-only non-final evidence.
standard_checks=(
  check-product-publication
  check-execution-modes
  check-required-artifacts
  check-checkout-role
  check-readmes
  check-naming
  check-privacy-boundary
  check-system-skills
  check-contract-compliance
  check-delivery-constraints
  check-distillation-state
  check-owner-approval
  check-validation-routing
  check-model-selection-guidance
  check-cross-system-upgrade-handoff
  check-weekly-planning
  check-personal-ops-v4
  check-personal-ops-aggregates-v4
  check-spor-proposals
  check-work-evidence
  check-weekly-planning-v4
  check-block-checkpoint
  check-end-of-task-capture
  check-update-workspace
  check-project-state
  check-project-orchestration
  check-orchestration-compatibility
  check-external-source-registry
  check-external-export-import-workflow
  check-personal-ops
  check-task-management
  check-dreaming-mode
  check-system-insights
  check-prompt-composition
  check-validation-profiles
  check-validation-integrity
  check-execution-efficiency
)
checks="$(IFS=,; echo "${standard_checks[*]}")"
exec python3 -B "$script_dir/validation_runner.py" "$@" --default-profile "$profile" --standard-checks "$checks" --full-smoke-check check-validator-smoke-tests
