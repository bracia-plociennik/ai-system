#!/usr/bin/env python3
"""Explicit local tracker actions; preview is read-only."""
import argparse
import json
import sys

from work_evidence import EvidenceError, require
from work_evidence_ledger import Ledger
from work_evidence_xlsx import Tracker


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("export", "preview", "prepare", "apply", "recover"))
    parser.add_argument("--workspace", required=True)
    parser.add_argument("--transaction-id")
    parser.add_argument("--manifest-hash")
    parser.add_argument("--owner-approved", action="store_true")
    args = parser.parse_args()
    try:
        if args.action != "preview":
            require(args.owner_approved, "owner-approval-required", "action")
        tracker = Tracker(Ledger(args.workspace))
        if args.action in {"apply", "recover"}:
            result = tracker.apply(args.transaction_id, args.manifest_hash)
        else:
            result = getattr(tracker, args.action)()
        print(json.dumps(result, ensure_ascii=False, allow_nan=False))
        return 0
    except (EvidenceError, OSError, ValueError, TypeError, KeyError, ImportError) as error:
        category = error.category if isinstance(error, EvidenceError) else "invalid-or-unavailable-input"
        print(json.dumps({"status": "blocked", "category": category}), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
