#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fail=0

if git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if git -C "$repo_root" ls-files --error-unmatch AGENTS.md >/dev/null 2>&1; then
    echo "Forbidden tracked artifact: AGENTS.md"
    echo "Root AGENTS.md is generated local-only. Run: git rm --cached AGENTS.md"
    fail=1
  fi
fi

required=(
  "HUMANS.md"
  "README.md"
  ".systems/ai/core/operating-model.md"
  ".systems/ai/core/privacy.md"
  ".systems/ai/core/workspaces.md"
  ".systems/ai/core/update-from-upstream.md"
  ".systems/ai/core/dump-triage.md"
  ".systems/ai/core/memory.md"
  ".systems/ai/core/system-insights.md"
  ".systems/ai/core/contract-compliance.md"
  ".systems/ai/core/guide.md"
  ".systems/ai/core/command-routing.md"
  ".systems/ai/core/response-contract.md"
  ".systems/ai/core/task-intake.md"
  ".systems/ai/core/context-as-data.md"
  ".systems/ai/core/client-brief.md"
  ".systems/ai/core/prompt-composition.md"
  ".systems/ai/templates/workspace-registry.template.md"
  ".systems/ai/templates/root/README.md"
  ".systems/ai/templates/root/AGENTS.template.md"
  ".systems/ai/templates/prompting/README.md"
  ".systems/ai/templates/prompting/prompt-module.template.md"
  ".systems/ai/templates/prompting/role-profile.template.md"
  ".systems/ai/templates/prompting/variable-pack.template.md"
  ".systems/ai/templates/prompting/client-prompting-readme.template.md"
  ".systems/ai/templates/prompting/project-prompting-readme.template.md"
  ".systems/ai/templates/prompting/workspace-prompting-readme.template.md"
  ".systems/ai/templates/prompting/client-collaboration-profile.template.md"
  ".systems/ai/templates/prompting/ai-system-operation-role.template.md"
  ".systems/ai/templates/prompting/ai-system-maintenance-baseline.template.md"
  ".systems/ai/examples/prompting/README.md"
  ".systems/ai/examples/prompting/client-collaboration-profile-example.md"
  ".systems/ai/examples/prompting/project-domain-role-example.md"
  ".systems/ai/examples/prompting/variable-pack-example.md"
  ".systems/ai/examples/prompting/ai-system-operation-role-example.md"
  ".systems/ai/examples/prompting/workspace-prompting-readme-example.md"
  ".systems/ai/templates/workspace/memory/workspace-memory.template.md"
  ".systems/ai/templates/workspace/memory/workspace-memory-entry.template.md"
  ".systems/ai/templates/workspace/workspace-readme.template.md"
  ".systems/ai/templates/workspace/primary-entity-workspace-readme.template.md"
  ".systems/ai/templates/workspace/primary-entity-status.template.md"
  ".systems/ai/templates/workspace/primary-entity-memory.template.md"
  ".systems/ai/templates/workspace/primary-entity-directory-readme.template.md"
  ".systems/ai/templates/workspace/core/README.md"
  ".systems/ai/templates/workspace/core/status.template.md"
  ".systems/ai/templates/workspace/core/workstreams.template.md"
  ".systems/ai/templates/workspace/dump/README.md"
  ".systems/ai/templates/workspace/clients/README.md"
  ".systems/ai/templates/workspace/clients/client-brief.template.md"
  ".systems/ai/templates/workspace/clients/client-memory.template.md"
  ".systems/ai/templates/workspace/clients/client-memory-entry.template.md"
  ".systems/ai/templates/workspace/owned-assets/README.md"
  ".systems/ai/templates/workspace/owned-assets/owned-asset-readme.template.md"
  ".systems/ai/templates/workspace/owned-assets/owned-asset-memory.template.md"
  ".systems/ai/templates/workspace/owned-assets/owned-asset-memory-entry.template.md"
  ".systems/ai/templates/workspace/projects/README.md"
  ".systems/ai/templates/workspace/projects/project-memory.template.md"
  ".systems/ai/templates/workspace/projects/project-memory-entry.template.md"
  ".systems/ai/templates/workspace/projects/checkpoint.template.md"
  ".systems/ai/templates/workspace/projects/distillation.template.md"
  ".systems/ai/templates/workspace/micro-projects/README.md"
  ".systems/ai/templates/workspace/humans/README.md"
  ".systems/ai/templates/workspace/memory/README.md"
  ".systems/ai/templates/workspace/external-memory/README.md"
  ".systems/ai/templates/workspace/system-insights/README.md"
  ".systems/ai/templates/workspace/system-insights/system-insights-readme.template.md"
  ".systems/ai/templates/workspace/system-insights/system-insights.template.md"
  ".systems/ai/templates/workspace/system-insights/insights-readme.template.md"
  ".systems/ai/templates/workspace/system-insights/system-insight.template.md"
  ".systems/ai/templates/workspace/skills/README.md"
  ".systems/ai/templates/workspace/archive/README.md"
  ".systems/scripts/init-workspace"
  ".systems/scripts/update-workspace"
  ".systems/scripts/init-ai-system"
  ".systems/scripts/update-from-upstream"
  ".systems/scripts/lib-workspaces"
  ".systems/scripts/check-readmes"
  ".systems/scripts/check-contract-compliance"
  ".systems/scripts/check-update-workspace"
  ".systems/scripts/check-privacy-boundary"
  ".systems/scripts/check-system-insights"
  ".systems/scripts/check-prompt-composition"
  ".systems/scripts/check-validator-smoke-tests"
)

for path in "${required[@]}"; do
  if [[ ! -f "$repo_root/$path" ]]; then
    echo "Missing required artifact: $path"
    fail=1
  fi
done

exit "$fail"
