#!/usr/bin/env python3
"""Review or activate the registered owner's single shared Workflow default.

This configures routing only; it does not enroll projects, merge their instructions,
initialize artifacts, remove old installations or grant execution permission.
"""
import argparse
import json
import os
import subprocess
from pathlib import Path
import sys
import tempfile

sys.dont_write_bytecode = True
from agent_context import registration, source_consistency
from durable_runtime import SHARED_CONFIGURATION, unlinked, identity


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--system-home')
    p.add_argument('--disable', action='store_true')
    p.add_argument('--approved', action='store_true', help='actual owner scope verified by caller')
    p.add_argument('--dry-run', action='store_true')
    args = p.parse_args()
    try:
        _, system, _, _ = registration(system_home=args.system_home)
        config = unlinked(system / SHARED_CONFIGURATION, exists=False)
        home = unlinked(system / 'ai-workflow')
        if not args.disable:
            if source_consistency(system, 'shared-workflow-v1.json', 'shared-workflow-v1') != 'verified-source':
                raise ValueError('installed System does not have verified shared Workflow support')
            if source_consistency(home, 'shared-installation-v1.json', 'shared-installation-v1') != 'verified-source':
                raise ValueError('installed Workflow does not have verified shared support')
            identity(home)
        value = dict(schema_version=1, enabled=not args.disable, workflow_home='ai-workflow')
        data = (json.dumps(value, indent=2, sort_keys=True) + '\n').encode()
        before = config.read_bytes() if config.exists() else None
        result = dict(path=str(config), configuration=value,
                      action='unchanged' if before == data else 'would-write', execution_authorized=False)
        if args.approved and not args.dry_run and before != data:
            config.parent.mkdir(parents=True, exist_ok=True)
            fd, name = tempfile.mkstemp(prefix='.shared-installation-', dir=config.parent)
            try:
                with os.fdopen(fd, 'wb') as stream:
                    stream.write(data)
                    stream.flush()
                    os.fsync(stream.fileno())
                unlinked(config, exists=False)
                current = config.read_bytes() if config.exists() else None
                if current != before:
                    raise ValueError('shared configuration changed during activation')
                os.replace(name, config)
                result['action'] = 'written'
            finally:
                if os.path.exists(name):
                    os.unlink(name)
        print(json.dumps(result, indent=2))
        return 0
    except (ValueError, OSError, KeyError, TypeError, subprocess.SubprocessError) as exc:
        print('Shared Workflow: ' + str(exc), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
