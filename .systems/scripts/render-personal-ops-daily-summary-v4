#!/usr/bin/env python3
"""Render the deterministic SPOR Daily V4 read-only plan."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import date
from decimal import Decimal
from pathlib import Path

from personal_ops_v4 import DAILY_ALIGNMENT_QUESTION, alignment_summary, json_value, load_daily, normalize_life_alignment_answer


CALCULATOR = Path(__file__).with_name("calculate-personal-ops-budgets")
FOOD_TIMES = ("09:00-11:00", "11:00-13:00", "13:00-15:00", "15:00-17:00", "17:00-19:00", "19:00-21:00")
POLISH_MONTHS = ("", "stycznia", "lutego", "marca", "kwietnia", "maja", "czerwca", "lipca", "sierpnia", "września", "października", "listopada", "grudnia")
POLISH_WEEKDAYS = ("poniedziałek", "wtorek", "środa", "czwartek", "piątek", "sobota", "niedziela")
CATEGORY_LABELS = {
    "build": "Build",
    "deliver": "Deliver",
    "promote": "Promote",
    "self": "Self",
    "close": "Close ones",
    "close-ones": "Close ones",
    "close_ones": "Close ones",
}
PLAN_STREAMS = set(CATEGORY_LABELS)


def number(value: object) -> str:
    if value is None or str(value) == "":
        return "nie podano"
    raw = format(Decimal(str(value)).quantize(Decimal("0.01")), "f").rstrip("0").rstrip(".") or "0"
    integer, separator, fraction = raw.partition(".")
    grouped = f"{int(integer):,}".replace(",", " ")
    return f"{grouped},{fraction}" if separator else grouped


def display_deadline(value: object, fallback: str = "-") -> str:
    raw = str(value or "").strip()
    if not raw or raw in {"-", "—"}:
        return fallback
    if "T" in raw:
        return raw.split("T", 1)[1][:5]
    if " " in raw and len(raw.split(" ", 1)[1]) >= 5:
        return raw.split(" ", 1)[1][:5]
    return raw


def display_date(value: object) -> str:
    target = date.fromisoformat(str(value))
    return f"{target.day} {POLISH_MONTHS[target.month]} {target.year}, {POLISH_WEEKDAYS[target.weekday()]}"


def display_range(start: object, end: object) -> str:
    return f"{start}–{end}"


def markdown_cell(value: object) -> str:
    return str(value or "-").replace("|", "\\|").replace("\n", " ").strip() or "-"


def alignment_section(properties: dict, workspace: Path) -> list[str]:
    report_date = date.fromisoformat(str(properties["session_date"]))
    summary = alignment_summary(workspace, report_date)
    daily = summary["daily"]
    answer = normalize_life_alignment_answer(properties.get("planned_day_life_alignment_answer", "unknown"))
    card14 = daily["card"] if daily["answer_count"] >= 14 else "nie oceniono"
    card30 = daily["card_30"] if daily["count_30"] >= 30 else "nie oceniono"
    resolution = daily.get("resolution")
    return [
        "### Kierunek życia",
        f"- Pytanie: {DAILY_ALIGNMENT_QUESTION}",
        f"- Odpowiedź: `{answer.upper()}`",
        f"- Ostatnie 14 odpowiedzi: `{daily['no_count']}/{daily['answer_count']}` NIE; kartka: `{card14}`",
        f"- Ostatnie 30 odpowiedzi: `{daily['no_30']}/{daily['count_30']}` NIE; kartka: `{card30}`",
        f"- Stan rozwiązania: `{json.dumps(resolution, ensure_ascii=False) if resolution else 'brak'}`",
        f"- Gate TaskNotes: `{summary['tasknote_gate']}`",
    ]


def minutes(value: object) -> int:
    hours, minute = str(value).split(":", 1)
    return int(hours) * 60 + int(minute)


def row_category(row: dict) -> str:
    explicit = str(row.get("stream") or row.get("category") or "").strip().lower()
    if explicit in CATEGORY_LABELS:
        return explicit
    block_id = str(row.get("block_id", "")).strip().lower()
    for prefix, category in (
        ("build", "build"),
        ("deliver", "deliver"),
        ("promote", "promote"),
        ("meal", "self"),
        ("routine", "self"),
        ("training", "self"),
        ("nsdr", "self"),
        ("shutdown", "self"),
        ("close", "close"),
    ):
        if block_id.startswith(prefix):
            return category
    return ""


def prefixed_title(title: object, stream: object = "", wig: bool = False) -> str:
    parts = []
    if wig:
        parts.append("`WIG`")
    label = CATEGORY_LABELS.get(str(stream or "").strip().lower(), "")
    if label:
        parts.append(f"`{label}`")
    parts.append(str(title or "").strip())
    return " ".join(part for part in parts if part)


def task_bucket(item: dict) -> str:
    raw = str(item.get("task_bucket") or item.get("category") or "").strip().lower()
    return raw.removeprefix("6d/")


def score_advice(kind: str, score: object) -> str:
    try:
        value = int(str(score))
    except (TypeError, ValueError):
        return "brak wskazówki bez wyniku skali"
    guidance = {
        "mental": {
            1: "ogranicz plan do minimum i chroń podstawową regenerację",
            2: "wybierz jeden priorytet i ogranicz przełączanie kontekstu",
            3: "pracuj w zamkniętych blokach i pilnuj przerw",
            4: "utrzymaj standardowy plan bez rozszerzania zakresu",
            5: "wykorzystaj klarowność, ale zachowaj ustalone granice bloków",
        },
        "body": {
            1: "przejdź na minimum dnia i nie dokładaj obciążenia",
            2: "zmniejsz obciążenie i potraktuj regenerację priorytetowo",
            3: "zachowaj adaptacyjność treningu i pilnuj NSDR",
            4: "realizuj standardowy plan, obserwując drobne ograniczenia",
            5: "pełna gotowość nie zmienia ustalonych limitów dnia",
        },
    }
    return guidance.get(kind, {}).get(value, "wynik poza skalą 1–5")


def state_note(value: object) -> str:
    if isinstance(value, dict):
        return str(value.get("note") or "nie podano")
    return "nie podano"


def state_score(properties: dict, current: dict, name: str, fallback_key: str) -> object:
    value = current.get(name)
    if isinstance(value, dict) and str(value.get("score", "")).strip():
        return value.get("score")
    return properties.get(fallback_key, "")


def state_items(value: object, fallback: list[str]) -> str:
    rows = value if isinstance(value, list) else []
    labels = []
    for row in rows:
        if isinstance(row, dict):
            label = str(row.get("title") or row.get("outcome") or "").strip()
        else:
            label = str(row).strip()
        if label:
            labels.append(label)
    seen = {label.casefold() for label in labels}
    for label in fallback:
        if label.casefold() not in seen:
            labels.append(label)
            seen.add(label.casefold())
    return "; ".join(labels) if labels else "nie podano"


def render_state(properties: dict, items: list[dict]) -> list[str]:
    current = json_value(properties, "current_state_json", {})
    if not isinstance(current, dict):
        raise ValueError("current_state_json must be an object")
    mental = state_score(properties, current, "mental", "mental_clarity_score")
    body = state_score(properties, current, "body", "body_readiness_score")
    mental_display = f"{mental}/5" if str(mental).strip() else "nie podano"
    body_display = f"{body}/5" if str(body).strip() else "nie podano"
    constraints = []
    for constraint in current.get("constraints", []) if isinstance(current.get("constraints"), list) else []:
        if isinstance(constraint, dict):
            title = str(constraint.get("title") or "nie podano").strip()
            mitigation = str(constraint.get("mitigation") or "mitygacja nie podana").strip()
            constraints.append(f"{title} — {mitigation}")
        elif str(constraint).strip():
            constraints.append(str(constraint).strip())
    self_fallback = [str(item.get("title", "")).strip() for item in items if str(item.get("stream", "")).strip().lower() == "self"]
    close_fallback = [str(item.get("title", "")).strip() for item in items if str(item.get("stream", "")).strip().lower() in {"close", "close-ones", "close_ones"}]
    return [
        "### Stan i kierunek dnia",
        f"- **Mental:** `{mental_display}` — {state_note(current.get('mental'))}. Wskazówka operacyjna: {score_advice('mental', mental)}.",
        f"- **Ciało:** `{body_display}` — {state_note(current.get('body'))}. Wskazówka operacyjna: {score_advice('body', body)}.",
        f"- **Ograniczenia / zagrożenia:** {'; '.join(constraints) if constraints else 'nie podano'}.",
        f"- **Tryb pracy:** `{properties.get('work_mode') or 'nie podano'}` — {current.get('work_mode_reason') or 'powód nie podany'}.",
        f"- **Tryb organizmu:** `{properties.get('organism_mode') or 'nie podano'}` — {current.get('organism_mode_reason') or 'powód nie podany'}.",
        f"- **Self:** {state_items(current.get('self'), self_fallback)}.",
        f"- **Close ones:** {state_items(current.get('close_ones'), close_fallback)}.",
    ]


def food_detail(block: dict) -> str:
    return f"~{number(block.get('calorie_target'))} kcal, B {number(block.get('protein_g'))} g, T {number(block.get('fat_g'))} g, W {number(block.get('carbohydrates_g'))} g"


def is_meal_row(row: dict) -> bool:
    block_id = str(row.get("block_id", "")).lower()
    label = str(row.get("label", "")).lower()
    return block_id.startswith("meal") or any(word in label for word in ("posił", "śniadan", "kolac", "obiad"))


def matching_food_block(row: dict, blocks: dict[str, dict]) -> tuple[str, dict] | None:
    if not is_meal_row(row):
        return None
    row_start = minutes(row.get("start"))
    for time in FOOD_TIMES:
        block = blocks.get(time, {})
        if block.get("status") != "configured":
            continue
        start, end = (minutes(value) for value in time.split("-", 1))
        if start <= row_start < end:
            return time, block
    return None


def read_config(workspace: Path) -> dict[str, str]:
    path = workspace / "personal-ops/check-ins/check-in-settings.local.md"
    values: dict[str, str] = {}
    in_frontmatter = False
    if not path.is_file():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.strip() == "---":
            in_frontmatter = not in_frontmatter
            continue
        if not in_frontmatter or not line.strip() or line.lstrip().startswith("#") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        values[key.strip()] = value.strip().strip('"')
    return values


def budget(workspace: Path, target: date) -> dict:
    result = subprocess.run([sys.executable, str(CALCULATOR), "--workspace", str(workspace), "--date", target.isoformat(), "--json"], capture_output=True, text=True)
    if result.returncode:
        raise ValueError(result.stderr.strip() or result.stdout.strip() or "budget calculator failed")
    return json.loads(result.stdout)


def schedule_rows(workspace: Path, properties: dict) -> list[dict]:
    if str(properties.get("daily_plan_contract", "")).strip() == "per-day-schedule-v1":
        rows = json_value(properties, "planned_schedule_json", None)
        if not isinstance(rows, list) or not rows or any(not isinstance(row, dict) for row in rows):
            raise ValueError("invalid planned_schedule_json for per-day-schedule-v1")
        return rows

    config = read_config(workspace)
    session_date = str(properties.get("session_date", "")).strip()
    raw_overrides = config.get("schedule_historical_overrides_json", "")
    if raw_overrides:
        overrides = json.loads(raw_overrides)
        if not isinstance(overrides, dict):
            raise ValueError("invalid local schedule configuration: schedule_historical_overrides_json")
        if session_date in overrides:
            rows = overrides[session_date]
            if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
                raise ValueError(f"invalid historical schedule override: {session_date}")
            return rows

    variant = str(properties.get("planned_schedule_variant", "standard"))
    key = "schedule_merged_adapt_shifted_json" if variant == "merged-adapt-shifted" else "schedule_standard_json"
    raw = config.get(key, "")
    if not raw:
        raise ValueError(f"missing local schedule configuration: {key}")
    rows = json.loads(raw)
    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
        raise ValueError(f"invalid local schedule configuration: {key}")
    return rows


def render_food(schedule: dict) -> list[str]:
    lines = ["### Makro", f"**Cel:** {number(schedule.get('planned_calorie_target'))} kcal | **profil:** {schedule.get('day_type', 'unknown')}"]
    if schedule.get("status") != "available":
        lines.append(f"Status: {schedule.get('status', 'unknown')} — {schedule.get('reason', 'brak projekcji')}")
        return lines
    blocks = {str(block.get("time")): block for block in schedule.get("food_blocks", [])}
    if set(blocks) != set(FOOD_TIMES):
        raise ValueError("V4 summary requires exactly six macro blocks")
    for time in FOOD_TIMES:
        block = blocks[time]
        if block.get("status") == "empty":
            lines.append(f"- `{time.replace('-', '–')}`: empty")
        elif block.get("status") == "configured":
            lines.append(f"- `{time.replace('-', '–')}`: `~{number(block.get('calorie_target'))} kcal | B {number(block.get('protein_g'))} g | T {number(block.get('fat_g'))} g | W {number(block.get('carbohydrates_g'))} g`")
        else:
            raise ValueError(f"invalid macro block status: {time}")
    totals = schedule.get("totals", {})
    lines.append(f"**Suma:** `~{number(schedule.get('daily_calorie_target'))} kcal | B {number(totals.get('protein_g'))} g | T {number(totals.get('fat_g'))} g | W {number(totals.get('carbohydrates_g'))} g`")
    return lines


def render(properties: dict, rows: list[dict], budget_report: dict, workspace: Path) -> str:
    items = json_value(properties, "planned_items_json", [])
    by_block: dict[str, list[dict]] = {}
    unallocated: list[dict] = []
    for item in items:
        if not isinstance(item, dict):
            continue
        block_id = str(item.get("block_id", "")).strip()
        if block_id:
            by_block.setdefault(block_id, []).append(item)
        elif str(item.get("stream", "")).strip().lower() in PLAN_STREAMS:
            unallocated.append(item)

    food_schedule = budget_report["weekly_calories"]["food_schedule"]
    food_blocks = {str(block.get("time")): block for block in food_schedule.get("food_blocks", [])} if food_schedule.get("status") == "available" else {}
    represented_food: set[str] = set()
    table_records: list[dict] = []
    rendered_items: set[int] = set()
    wig_item_id = str(properties.get("wig_plan_item_id", "")).strip()
    for order, row in enumerate(rows):
        start, end = str(row.get("start", "")), str(row.get("end", ""))
        block_id = str(row.get("block_id", ""))
        matched = by_block.get(block_id, [])
        food_match = matching_food_block(row, food_blocks)
        if food_match:
            represented_food.add(food_match[0])
        if matched:
            for item in matched:
                rendered_items.add(id(item))
                stream = str(item.get("stream", ""))
                table_records.append({
                    "start": start,
                    "end": end,
                    "order": order,
                    "title": prefixed_title(item.get("title", row.get("label", "")), stream, str(item.get("id", "")).strip() == wig_item_id),
                    "dod": item.get("definition_of_done", "") or row.get("dod", ""),
                    "deadline": item.get("deadline", "") or row.get("deadline", "-"),
                })
        else:
            stream = row_category(row)
            table_records.append({
                "start": start,
                "end": end,
                "order": order,
                "title": prefixed_title(row.get("label", ""), stream),
                "dod": food_detail(food_match[1]) if food_match else row.get("dod", ""),
                "deadline": row.get("deadline", "-"),
            })

    schedule_warnings: list[str] = []
    if food_schedule.get("status") == "available":
        for index, time in enumerate(FOOD_TIMES):
            block = food_blocks.get(time, {})
            if block.get("status") != "configured" or time in represented_food:
                continue
            start, configured_end = time.split("-", 1)
            start_minute, end_minute = minutes(start), minutes(configured_end)
            overlapping = [record for record in table_records if minutes(record["start"]) <= start_minute < minutes(record["end"])]
            later_starts = [minutes(record["start"]) for record in table_records if start_minute < minutes(record["start"]) < end_minute]
            rendered_end = configured_end
            if not overlapping and later_starts:
                clipped = min(later_starts)
                rendered_end = f"{clipped // 60:02d}:{clipped % 60:02d}"
            elif overlapping:
                schedule_warnings.append(f"konflikt posiłku {time.replace('-', '–')} z harmonogramem")
            table_records.append({
                "start": start,
                "end": rendered_end,
                "order": len(rows) + index,
                "title": prefixed_title("Posiłek", "self"),
                "dod": food_detail(block),
                "deadline": "-",
            })

    table = ["| Czas | Element | DoD | DL |", "|---|---|---|---|"]
    for record in sorted(table_records, key=lambda value: (minutes(value["start"]), value["order"])):
        table.append(
            f"| {display_range(record['start'], record['end'])} | {markdown_cell(record['title'])} | {markdown_cell(record['dod'])} | {markdown_cell(display_deadline(record['deadline']))} |"
        )

    lines = [f"## Plan na dziś - {display_date(properties.get('session_date'))}", "", *table]
    if unallocated:
        lines.extend(["", "## Niezaalokowane"])
        for item in unallocated:
            lines.append(f"- {prefixed_title(item.get('title', ''), item.get('stream', ''))} | DoD: {item.get('definition_of_done', '')} | DL: {display_deadline(item.get('deadline', ''), 'bez deadlineu')}")
    hidden_allocations = [item for item in items if isinstance(item, dict) and str(item.get("stream", "")).strip().lower() in PLAN_STREAMS and id(item) not in rendered_items and str(item.get("block_id", "")).strip()]
    if hidden_allocations:
        if not unallocated:
            lines.extend(["", "## Niezaalokowane"])
        for item in hidden_allocations:
            lines.append(f"- {prefixed_title(item.get('title', ''), item.get('stream', ''))} | DoD: {item.get('definition_of_done', '')} | DL: {display_deadline(item.get('deadline', ''), 'bez deadlineu')}")
    lines.extend(["", *render_state(properties, [item for item in items if isinstance(item, dict)])])
    lines.extend(["", *alignment_section(properties, workspace)])
    if properties.get("wig_title"):
        wig_deadline_value = ""
        for item in items:
            if isinstance(item, dict) and str(item.get("id", "")).strip() == wig_item_id:
                wig_deadline_value = str(item.get("deadline", "")).strip()
                break
        lines.extend(["", "### WIG", f"**WIG:** {properties.get('wig_title')}", f"**DoD:** {properties.get('wig_definition_of_done', '') or 'nie podano'}", f"**DL:** {display_deadline(wig_deadline_value, 'bez deadlineu')}"])
    if properties.get("planned_if_start") and properties.get("planned_if_end"):
        lines.extend(["", "### IF", f"**Okno:** {display_range(properties.get('planned_if_start'), properties.get('planned_if_end'))}"])
    lines.extend(["", *render_food(food_schedule)])
    monthly = budget_report["monthly_spending"]
    weekly = budget_report["weekly_calories"]
    currency = monthly.get("currency", properties.get("planned_budget_currency", ""))
    lines.extend([
        "", "### Budżet wydatków",
        f"- Limit dnia: `{number(properties.get('planned_budget_max'))} {properties.get('planned_budget_currency', currency)}`",
        f"- Budżet bazowy: `{number(monthly.get('base_budget'))} {currency}`",
        f"- Bufor: `{number(monthly.get('buffer'))} {currency}`",
        f"- Wydatki: `{number(monthly.get('current_spending'))} {currency}`",
        f"- Pozostało: `{number(monthly.get('remaining_base_budget'))} {currency}`",
        f"- Pozostałe dni włącznie z dzisiaj: `{number(monthly.get('remaining_days_inclusive'))}`",
        f"- Średnia na pozostały dzień: `{number(monthly.get('average_available_per_remaining_day'))} {currency}`",
        f"- Przekroczenie tempa: `{number(monthly.get('pace_overrun'))} {currency}`",
        f"- Dni bez wydatków od dziś: `{number(monthly.get('no_spend_days_from_today'))}`",
        f"- Powrót do limitu: `{monthly.get('standard_spend_resume_date') or 'nie podano'}`",
    ])
    if monthly.get("approximate"):
        lines.append("- Status danych: `wartości przybliżone`")
    lines.extend([
        "", "### Budżet kalorii",
        f"- Tygodniowy limit: `{number(weekly.get('weekly_budget'))} kcal`",
        f"- Zjedzone przed dzisiaj: `{number(weekly.get('actual_consumed'))} kcal`",
        f"- Pozostało przed dzisiaj: `{number(weekly.get('remaining_before_today'))} kcal`",
        f"- Plan na dzisiaj: `{number(weekly.get('planned_today'))} kcal`",
        f"- Pozostało po dzisiaj: `{number(weekly.get('remaining_after_today'))} kcal`",
        f"- Pozostałe dni po dzisiaj: `{number(weekly.get('remaining_days_after_today'))}`",
        f"- Mechanicznie na pozostały dzień: `{number(weekly.get('mechanical_limit_after_today'))} kcal`",
        f"- Limit zdroworozsądkowy: `{number(weekly.get('common_sense_limit_after_today'))} kcal`",
        f"- Niewyrównane saldo: `{number(weekly.get('unbalanced_balance'))} kcal`",
    ])
    if weekly.get("approximate"):
        lines.append("- Status danych: `wartości przybliżone`")
    activity = []
    represented_ids = {str(row.get("block_id", "")).lower() for row in rows}
    if properties.get("planned_training_start") and properties.get("planned_training_end") and not any(value.startswith("training") for value in represented_ids):
        activity.append(f"- Self · Trening: {display_range(properties.get('planned_training_start'), properties.get('planned_training_end'))} ({properties.get('planned_training_type', 'nie podano')})")
    if properties.get("planned_nsdr_start") and properties.get("planned_nsdr_end") and not any(value.startswith("nsdr") for value in represented_ids):
        activity.append(f"- Self · NSDR: {display_range(properties.get('planned_nsdr_start'), properties.get('planned_nsdr_end'))}")
    if activity:
        lines.extend(["", "### Aktywność i regeneracja", *activity])
    deferred = [item for item in items if isinstance(item, dict) and task_bucket(item) == "defer"]
    if deferred:
        lines.extend(["", "### Odroczone", *[f"- {prefixed_title(item.get('title', ''), item.get('stream', ''))}" for item in deferred]])
    if properties.get("task_generation_status"):
        lines.extend(["", "### TaskNotes", f"- Status: {properties.get('task_generation_status')}"])
    warnings = []
    for label, report in (("wydatków", monthly), ("kalorii", weekly)):
        coverage = report.get("coverage")
        if coverage and coverage["status"] != "complete":
            warnings.append(f"budżet {label}: znana suma częściowa; brak danych dla {len(coverage['missing_dates'])} dni; pełne saldo nieznane")
    for label, key in (("mental", "mental_clarity_score"), ("ciało", "body_readiness_score")):
        try:
            if str(properties.get(key, "")) and Decimal(str(properties[key])) <= 3:
                warnings.append(f"{label} {properties[key]}/5")
        except Exception:  # noqa: BLE001
            warnings.append(f"{label} nie podano")
    if properties.get("organism_mode") == "recovery":
        warnings.append("tryb recovery")
    warnings.extend(schedule_warnings)
    warnings.extend(f"konflikt IF: {value.replace('-', '–')}" for value in food_schedule.get("if_conflicts", []))
    if warnings:
        lines.extend(["", "### Ostrzeżenia", *[f"- {warning}" for warning in warnings]])
    lines.extend(["", "Zapis jest read-only planem; nie wykonuje zadań ani działań zewnętrznych."])
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workspace", required=True, type=Path)
    parser.add_argument("--date", required=True)
    parser.add_argument("--check-file", type=Path)
    args = parser.parse_args()
    try:
        target = date.fromisoformat(args.date)
        workspace = args.workspace.resolve()
        _, properties, _ = load_daily(workspace, target)
        expected = render(properties, schedule_rows(workspace, properties), budget(workspace, target), workspace)
        if args.check_file:
            actual = args.check_file.read_text(encoding="utf-8")
            if actual.rstrip("\n") != expected.rstrip("\n"):
                print("daily V4 summary mismatch", file=sys.stderr)
                return 1
        else:
            sys.stdout.write(expected)
        return 0
    except Exception as exc:  # noqa: BLE001
        print(f"STOP: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
