python3 - "$repo_root" "$sync_workspace" <<'PY'
import csv
import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path
from unittest.mock import patch

root = Path(sys.argv[1])
workspace = Path(sys.argv[2])
sys.path.insert(0, str(root / ".systems/scripts"))
from personal_ops_v4 import daily_index_fields, load_official_v4_records

index_root = workspace / "personal-ops/indexes"
fields = daily_index_fields()
with (index_root / "check-ins-v4.csv").open(encoding="utf-8", newline="") as handle:
    full_rows = list(csv.DictReader(handle))
with (index_root / "check-ins-v4.metrics.csv").open(encoding="utf-8", newline="") as handle:
    metric_rows = list(csv.DictReader(handle))
assert len(full_rows) == len(metric_rows) == 3
assert list(full_rows[0]) == [field["key"] for field in fields]
assert list(metric_rows[0]) == [field["key"] for field in fields if field.get("metric")]
assert "planned_items_json" in full_rows[0]
assert "planned_items_json" not in metric_rows[0]
assert json.loads(full_rows[0]["planned_items_json"])
redacted = next(row for row in full_rows if row["session_date"] == "2026-08-19")
assert redacted["planned_items_json"] == ""
assert redacted["planned_calories_representative"] == ""
assert redacted["work_mode"] == "growth"
combined = "\n".join(path.read_text(encoding="utf-8") for path in index_root.glob("check-ins-v4*"))
assert "RAW-SENTINEL-V4" not in combined
records = load_official_v4_records(workspace)
assert len(records) == 3
redacted_jsonl = next(row for row in records if row["session_date"] == "2026-08-19")
assert redacted_jsonl["planned_items_json"] == ""

loader = importlib.machinery.SourceFileLoader("sync_v4", str(root / ".systems/scripts/sync-personal-ops-check-ins-v4"))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)
rollback_root = workspace / "rollback"
rollback_root.mkdir()
outputs = {rollback_root / name: f"new-{name}\n" for name in module.INDEX_FILENAMES}
for path in outputs:
    path.write_text(f"old-{path.name}\n", encoding="utf-8")
original_replace = Path.replace

def failing_replace(source, target):
    if ".check-ins-v4-stage." in source.parent.name and source.name == "check-ins-v4.metrics.csv":
        raise OSError("forced replacement failure")
    return original_replace(source, target)

try:
    with patch.object(Path, "replace", failing_replace):
        module.write_index_set_atomic(outputs)
except OSError:
    pass
else:
    raise SystemExit("forced V4 index replacement failure did not fail")
for path in outputs:
    assert path.read_text(encoding="utf-8") == f"old-{path.name}\n"
PY

before_status="$(shasum -a 256 "$sync_workspace"/personal-ops/indexes/check-ins-v4*)"
status_output="$(python3 "$repo_root/.systems/scripts/sync-personal-ops-check-ins-v4" --workspace "$sync_workspace" --status-only)"
after_status="$(shasum -a 256 "$sync_workspace"/personal-ops/indexes/check-ins-v4*)"
test "$before_status" = "$after_status"
printf '%s\n' "$status_output" | grep -q '^unsynced-v4-check-in-count: 0$'

rm "$sync_workspace/personal-ops/indexes/check-ins-v4.csv"
