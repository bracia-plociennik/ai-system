python3 "$repo_root/.systems/scripts/sync-personal-ops-check-ins-v4" --workspace "$sync_workspace" --post-write >/dev/null
for name in check-ins-v4.jsonl check-ins-v4.csv check-ins-v4.metrics.csv check-ins-v4.md check-ins-v4.trends.md; do
  test -f "$sync_workspace/personal-ops/indexes/$name"
