food = report["weekly_calories"]["food_schedule"]
if food.get("status") != "unavailable":
    raise AssertionError(repr(food))
if "macro_rest_block_13_15_status" not in food.get("invalid_or_missing_fields", []):
    raise AssertionError(repr(food))
if any("protein_g" in block for block in food.get("food_blocks", [])):
    raise AssertionError(repr(food))
PY
