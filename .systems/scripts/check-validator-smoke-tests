    "previous_day_actual_nsdr_approximate": True,
    "previous_day_actual_if_approximate": True,
    "planned_training_approximate": False,
    "planned_nsdr_approximate": True,
    "planned_if_approximate": True,
    "attachments_json": json.dumps([{ "path": "2026-07-22.assets/note.png", "kind": "note-image" }]),
    "ocr_entries_json": json.dumps([{ "path": "2026-07-22.assets/note.ocr.md", "status": "completed" }]),
