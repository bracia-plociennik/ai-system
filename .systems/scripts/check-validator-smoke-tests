python3 - "$tmp/personal-ops-properties-v3-candidates.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    candidates = json.load(handle)
assert {candidate["source_plan_item_id"] for candidate in candidates} == {"build-01", "deliver-01", "promote-01"}, candidates
assert all(candidate["tags"] == ["6d/do"] for candidate in candidates), candidates
assert all(candidate["status"] == "open" and candidate["priority"] == "high" for candidate in candidates), candidates
assert "wig-build-01" not in {candidate["source_plan_item_id"] for candidate in candidates}, candidates
PY

deadline_policy_report="$properties_v3_workspace/personal-ops/check-ins/2026/2026-07-26.md"
cp "$properties_v3_report" "$deadline_policy_report"
python3 - "$deadline_policy_report" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8").replace("2026-07-22", "2026-07-26").replace("2026-07-21", "2026-07-25")
items = [
    {"id": "build-01", "stream": "build", "title": "Deadline defaults to DO", "definition_of_done": "Delivered result", "deadline": "2026-07-26T18:00"},
    {"id": "deliver-01", "stream": "deliver", "title": "No deadline defaults to DEFER", "definition_of_done": "Reviewed result"},
    {"id": "promote-01", "stream": "promote", "title": "Explicit DO without deadline", "definition_of_done": "Published result", "task_bucket": "6d/do"},
    {"id": "build-02", "stream": "build", "title": "Explicit DUMP with deadline", "definition_of_done": "Captured result", "task_bucket": "dump", "deadline": "2026-07-27"},
]
encoded = json.dumps(json.dumps(items, ensure_ascii=False))
text = re.sub(r"^  planned_items_json:.*$", f"  planned_items_json: {encoded}", text, flags=re.MULTILINE)
text = re.sub(r"^  task_candidate_eligible_count:.*$", "  task_candidate_eligible_count: 4", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_do_count:.*$", "  planned_do_count: 2", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_defer_count:.*$", "  planned_defer_count: 1", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_delegate_count:.*$", "  planned_delegate_count: 0", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_delete_count:.*$", "  planned_delete_count: 0", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_dump_count:.*$", "  planned_dump_count: 1", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_with_deadline_count:.*$", "  planned_with_deadline_count: 2", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_without_deadline_count:.*$", "  planned_without_deadline_count: 2", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_earliest_deadline:.*$", "  planned_earliest_deadline: \"2026-07-26T18:00\"", text, flags=re.MULTILINE)
text = re.sub(r"^  planned_latest_deadline:.*$", "  planned_latest_deadline: \"2026-07-27T23:59\"", text, flags=re.MULTILINE)
path.write_text(text, encoding="utf-8")
PY
"$copy_repo/.systems/scripts/propose-task-candidates" --workspace "$properties_v3_workspace" --check-in "$deadline_policy_report" --task-vault "$properties_v3_vault" --json > "$tmp/personal-ops-deadline-policy-candidates.json"
python3 - "$tmp/personal-ops-deadline-policy-candidates.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    candidates = json.load(handle)
actual = [(candidate["execution_bucket"], candidate["due"], candidate["scheduled"], candidate["tags"]) for candidate in candidates]
expected = [
    ("do", "2026-07-26T18:00", "", ["6d/do"]),
    ("defer", "", "", ["6d/defer"]),
    ("do", "", "", ["6d/do"]),
    ("dump", "2026-07-27T23:59", "", ["6d/dump"]),
]
assert actual == expected, actual
assert candidates[0]["definition_of_done"] == "Delivered result", candidates
PY
