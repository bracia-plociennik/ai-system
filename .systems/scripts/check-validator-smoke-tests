write_manual_checkin() {
  local workspace="$1"
  local date_text="$2"
  local year="${date_text%%-*}"
  local target="$workspace/personal-ops/check-ins/$year/$date_text.md"
  mkdir -p "$(dirname "$target")"
  cat > "$target" <<MD
---
type: daily-check-in
date: "$date_text"
title: "Daily check-in $date_text"
source: manual
source_provider: ai-system
source_database: manual-daily-check-in
source_row_id: "manual-$date_text"
privacy: private-sensitive
minimum_day_done: true
day_mode: wzrost
day_mode_raw: WZROST
body_subjective: ok
energy_subjective: wysoka
mental_subjective: ostry
routine_state_subjective: wysoki
limitations_subjective: brak
sleep_start: "$date_text 00:00"
sleep_end: "$date_text 08:00"
sleep_raw:
if_start:
if_end:
if_raw:
training_start:
training_end:
training_raw:
nsdr_start:
nsdr_end:
nsdr_raw:
day_plan_status:
morning_check_in_status:
afternoon_check_in_status:
next_day_seed_status:
---

# Daily check-in $date_text

## 1. Plan dnia

### Data

$date_text

### Sen od-do

$date_text 00:00 -> $date_text 08:00

### Trening od-do

### NSDR od-do

### IF od-do

### Tryb dnia

WZROST

### Zbudowałem

Test build

### Dowiozłem

Test delivery

### Wypromowałem

### Coś dla ciała

Stretching

### Coś dla ducha

### Coś dla bliskich

## 2. Poranny check-in

### Pobudka

true

### Kuchnia

true

### Dwór

true

### Napiłem się

false

### Mantra

test

### Deep Focus

true

### Mama i Oliwia

true

### Insta Story

false

### Stan po rutynie

wysoki

### Energia

wysoka

### Mental

ostry

### Ciało

ok

### Ograniczenia

brak

### Jestem wdzięczny

Test gratitude

### Zagrożenie dnia

Test threat

## 3. Popołudniowy check-in

### Czy zrobiłem minimum

true

### Nawyki

Test habits

### Co dało +1%

Test plus one

### Co było zbędne

Test noise

## 4. Seed kolejnego dnia

### Data

### Sen od-do

### Trening od-do

### NSDR od-do

### IF od-do

### Tryb dnia

### Zbudowałem

### Dowiozłem

### Wypromowałem

### Coś dla ciała

### Coś dla ducha

### Coś dla bliskich

## 5. Dodatkowe informacje

### Dodatkowe informacje

### Załączniki

-
MD
}

