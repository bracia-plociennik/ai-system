import json
import sys
from decimal import Decimal

food = json.loads(open(sys.argv[1], encoding="utf-8").read())["weekly_calories"]["food_schedule"]
if food.get("status") != "available":
    raise AssertionError(f"rest status: {food!r}")
if food.get("selection_basis") != "planned_training_profile":
    raise AssertionError(f"rest selection basis: {food!r}")
if food.get("planned_calorie_target") != 2300.0:
    raise AssertionError(f"rest calorie target: {food!r}")
if food.get("day_type") != "rest":
    raise AssertionError(f"rest day type: {food!r}")
if food.get("totals") != {"protein_g": 180.0, "fat_g": 80.0, "carbohydrates_g": 215.0}:
    raise AssertionError(f"rest totals: {food!r}")
if Decimal(str(food.get("macro_derived_calories"))) != Decimal("2300"):
    raise AssertionError(f"rest macro calories: {food!r}")
if Decimal(str(food.get("macro_calorie_delta"))) != Decimal("0"):
    raise AssertionError(f"rest macro delta: {food!r}")
if Decimal(str(food.get("block_calorie_sum"))) != Decimal("2300"):
    raise AssertionError(f"rest block calories: {food!r}")
if food.get("if_conflicts") != []:
    raise AssertionError(f"rest IF conflicts: {food!r}")
PY
