lines.extend(["---", "", "## Interpreted Check-In", "", "Readable projection only.", "", "## Lekcja dnia", "", "- Topic: Fixture lesson", "", "## OCR / Notatka robocza", "", "- Full OCR raw-ocr-sentinel", "", "## Dodatkowe informacje", "", "- none", "", "## Załączniki", "", "- 2026-07-22.assets/note.png", "", "## Raw Check-In", "", "raw-check-in-sentinel: preserve verbatim", ""])
