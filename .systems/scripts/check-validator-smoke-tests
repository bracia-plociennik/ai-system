source = workspace / "personal-ops/archive/legacy-source/2026-05-12.md"
payload["legacy_metadata"]["origin"]["source_path"] = source.relative_to(workspace).as_posix()
payload["legacy_metadata"]["origin"]["source_sha256"] = hashlib.sha256(source.read_bytes()).hexdigest()
content = json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n"
snapshot.write_text(content, encoding="utf-8")
manifest = snapshot.with_name("manifest.json")
data = json.loads(manifest.read_text())
data["legacy_normalized_v3_sha256"] = hashlib.sha256(content.encode()).hexdigest()
manifest.write_text(json.dumps(data), encoding="utf-8")
PY
