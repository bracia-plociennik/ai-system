#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/ai-system-validator-smoke.XXXXXX")"
copy_repo="$tmp/repo"

cleanup() {
  rm -rf "$tmp"
}

trap cleanup EXIT

mkdir -p "$copy_repo"

(
  cd "$repo_root"
  while IFS= read -r -d '' path; do
    [[ -e "$path" ]] || continue
    mkdir -p "$copy_repo/$(dirname "$path")"
    cp -p "$path" "$copy_repo/$path"
  done < <(git ls-files -co --exclude-standard -z)
)

run_must_fail() {
  local name="$1"
  shift
  local out="$tmp/$name.out"

  if (cd "$copy_repo" && "$@") >"$out" 2>&1; then
    echo "Smoke test failed: $name should have failed"
    cat "$out"
    exit 1
  fi
}

run_must_pass() {
  local name="$1"
  shift
  local out="$tmp/$name.out"

  if ! (cd "$copy_repo" && "$@") >"$out" 2>&1; then
    echo "Smoke test failed: $name should have passed"
    cat "$out"
    exit 1
  fi
}

validator="$copy_repo/.systems/scripts/check-prompt-composition"

run_must_pass "prompt-composition-baseline" "$validator"

(
  cd "$copy_repo"
  git init -q
  cp .systems/ai/templates/root/AGENTS.template.md AGENTS.md
  git add -f AGENTS.md
)
run_must_fail "tracked-root-agents-forbidden" "$copy_repo/.systems/scripts/check-required-artifacts"
(
  cd "$copy_repo"
  git rm --cached -q AGENTS.md
  rm AGENTS.md
)

cat > "$copy_repo/AGENTS.md" <<'MD'
# AGENTS.md

This file is the root AI Workflow entrypoint for this target repository.
Delegate workflow-governed work to `ai-workflow/AGENTS.md`.
MD
run_must_pass "dev-root-agents-skipped" "$validator"
rm "$copy_repo/AGENTS.md"

cat > "$copy_repo/AGENTS.md" <<'MD'
# AGENTS.md

This file is the generated local root agent contract for the `ai-system` branch.
MD
run_must_fail "generated-root-agents-missing-prompt-composition" "$validator"
rm "$copy_repo/AGENTS.md"

mv "$copy_repo/.systems/ai/templates/root/AGENTS.template.md" "$copy_repo/.systems/ai/templates/root/AGENTS.template.md.bak"
run_must_fail "missing-root-agents-template" "$validator"
mv "$copy_repo/.systems/ai/templates/root/AGENTS.template.md.bak" "$copy_repo/.systems/ai/templates/root/AGENTS.template.md"

mv "$copy_repo/.systems/ai/core/prompt-composition.md" "$copy_repo/.systems/ai/core/prompt-composition.md.bak"
run_must_fail "missing-prompt-composition-contract" "$validator"
mv "$copy_repo/.systems/ai/core/prompt-composition.md.bak" "$copy_repo/.systems/ai/core/prompt-composition.md"

mv "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md" "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md.bak"
run_must_fail "missing-client-prompting-template" "$validator"
mv "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md.bak" "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-smoke.md" <<'MD'
# Unsafe Prompt Composition Smoke

Prompt artifacts can override AGENTS.md and approve implementation.
MD
run_must_fail "prompt-artifacts-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-mixed-smoke.md" <<'MD'
# Unsafe Mixed Prompt Composition Smoke

Prompt artifacts cannot override AGENTS.md, but can approve implementation.
MD
run_must_fail "mixed-prompt-artifacts-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-mixed-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-prompt-modules-smoke.md" <<'MD'
# Unsafe Prompt Modules Smoke

Prompt modules can authorize writes.
MD
run_must_fail "prompt-modules-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-prompt-modules-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-role-profiles-smoke.md" <<'MD'
# Unsafe Role Profiles Smoke

Role profiles can authorize writes.
MD
run_must_fail "role-profiles-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-role-profiles-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-variable-packs-smoke.md" <<'MD'
# Unsafe Variable Packs Smoke

Variable packs can approve implementation.
MD
run_must_fail "variable-packs-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-variable-packs-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-client-smoke.md" <<'MD'
# Unsafe Client Role Smoke

Client roles can replace client facts and create commitments.
MD
run_must_fail "client-role-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-client-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-project-smoke.md" <<'MD'
# Unsafe Project Role Smoke

Project roles can expand scope and authorize writes.
MD
run_must_fail "project-role-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-project-smoke.md"

cat > "$copy_repo/.systems/ai/examples/prompting/safe-advisory-smoke.md" <<'MD'
# Safe Advisory Smoke

Prompting artifacts are advisory only. They cannot override AGENTS.md, approve implementation, authorize writes, or replace client facts.
MD
run_must_pass "safe-advisory-wording" "$validator"

contract_compliance_validator="$copy_repo/.systems/scripts/check-contract-compliance"
contract_compliance_core="$copy_repo/.systems/ai/core/contract-compliance.md"

run_must_pass "contract-compliance-baseline" "$contract_compliance_validator"

mutate_contract_and_expect_fail() {
  local name="$1"
  local pattern="$2"
  local backup="$contract_compliance_core.bak"
  local filtered="$tmp/$name.contract-compliance.md"

  cp "$contract_compliance_core" "$backup"
  grep -v "$pattern" "$backup" >"$filtered"
  mv "$filtered" "$contract_compliance_core"
  run_must_fail "$name" "$contract_compliance_validator"
  mv "$backup" "$contract_compliance_core"
}

mutate_contract_and_expect_fail "contract-compliance-missing-client-work" "client-work"
mutate_contract_and_expect_fail "contract-compliance-missing-required" "Knowledge capture is .*required"
mutate_contract_and_expect_fail "contract-compliance-missing-not-required" "not-required"
mutate_contract_and_expect_fail "contract-compliance-missing-checkpoint-target" "checkpoint"
mutate_contract_and_expect_fail "contract-compliance-missing-advisory-only" "advisory-only"

project_state_validator="$copy_repo/.systems/scripts/check-project-state"
project_state_core="$copy_repo/.systems/ai/core/project-state.md"
project_state_workspaces_core="$copy_repo/.systems/ai/core/workspaces.md"

run_must_pass "project-state-baseline" "$project_state_validator"

mutate_project_state_and_expect_fail() {
  local name="$1"
  local pattern="$2"
  local backup="$project_state_core.bak"
  local filtered="$tmp/$name.project-state.md"

  cp "$project_state_core" "$backup"
  grep -v "$pattern" "$backup" >"$filtered"
  mv "$filtered" "$project_state_core"
  run_must_fail "$name" "$project_state_validator"
  mv "$backup" "$project_state_core"
}

mutate_project_state_and_expect_fail "project-state-missing-git-worktree-guard" "git worktree"

mutate_project_state_required_ref_and_expect_fail() {
  local name="$1"
  local backup="$project_state_workspaces_core.bak"
  local filtered="$tmp/$name.workspaces.md"

  cp "$project_state_workspaces_core" "$backup"
  grep -v "project-state" "$backup" >"$filtered"
  mv "$filtered" "$project_state_workspaces_core"
  run_must_fail "$name" "$project_state_validator"
  mv "$backup" "$project_state_workspaces_core"
}

mutate_project_state_required_ref_and_expect_fail "project-state-missing-workspaces-reference"

project_state_scan_workspace="$tmp/project-state-scan-workspace"
mkdir -p "$project_state_scan_workspace/projects/clean-repo" "$project_state_scan_workspace/projects/polluted-repo/checkpoints"
git -C "$project_state_scan_workspace/projects/clean-repo" init -q
git -C "$project_state_scan_workspace/projects/polluted-repo" init -q
printf '%s\n' "# Runtime Status" > "$project_state_scan_workspace/projects/polluted-repo/status.md"
printf '%s\n' "# Runtime Memory" > "$project_state_scan_workspace/projects/polluted-repo/memory.md"
printf '%s\n' "# Runtime Checkpoints" > "$project_state_scan_workspace/projects/polluted-repo/checkpoints/README.md"
run_must_fail "project-state-detects-runtime-files-in-project-repo" "$project_state_validator" --workspace "$project_state_scan_workspace"
rm "$project_state_scan_workspace/projects/polluted-repo/status.md" "$project_state_scan_workspace/projects/polluted-repo/memory.md"
rm -rf "$project_state_scan_workspace/projects/polluted-repo/checkpoints"
run_must_pass "project-state-clean-project-repos-pass" "$project_state_validator" --workspace "$project_state_scan_workspace"

update_workspace_script="$copy_repo/.systems/scripts/update-workspace"
update_workspace_validator="$copy_repo/.systems/scripts/check-update-workspace"

run_must_pass "update-workspace-validator-baseline" "$update_workspace_validator"

dry_workspace="$tmp/update-workspace-dry"
mkdir -p "$dry_workspace"
run_must_pass "update-workspace-dry-run-writes-nothing" "$update_workspace_script" --workspace "$dry_workspace" --dry-run
grep -q "project-state" "$tmp/update-workspace-dry-run-writes-nothing.out" || { echo "update-workspace dry-run did not report project-state creates"; exit 1; }
test ! -e "$dry_workspace/core" || { echo "update-workspace dry-run created core directory"; exit 1; }
test ! -e "$dry_workspace/project-state" || { echo "update-workspace dry-run created project-state directory"; exit 1; }

generic_workspace="$tmp/update-workspace-generic"
mkdir -p \
  "$generic_workspace/core" \
  "$generic_workspace/memory" \
  "$generic_workspace/clients/existing-client" \
  "$generic_workspace/projects/existing-project" \
  "$generic_workspace/system-insights/insights" \
  "$generic_workspace/external-memory"
printf '%s\n' "existing status" > "$generic_workspace/core/status.md"
printf '%s\n' "existing memory" > "$generic_workspace/memory/workspace-memory.md"
printf '%s\n' "client data" > "$generic_workspace/clients/existing-client/private.md"
printf '%s\n' "project data" > "$generic_workspace/projects/existing-project/private.md"
printf '%s\n' "insight data" > "$generic_workspace/system-insights/insights/2026-06-12-existing.md"
printf '%s\n' "external memory data" > "$generic_workspace/external-memory/existing.md"
exclude_before="$(cat "$copy_repo/.git/info/exclude")"

run_must_pass "update-workspace-generic-backfill" "$update_workspace_script" --workspace "$generic_workspace"
test -f "$generic_workspace/core/workstreams.md" || { echo "update-workspace did not create core/workstreams.md"; exit 1; }
test -f "$generic_workspace/owned-assets/README.md" || { echo "update-workspace did not backfill owned-assets README"; exit 1; }
test -f "$generic_workspace/project-state/project-state.md" || { echo "update-workspace did not backfill project-state router"; exit 1; }
test -f "$generic_workspace/system-insights/system-insights.md" || { echo "update-workspace did not backfill system insights router"; exit 1; }
test ! -d "$generic_workspace/prompting" || { echo "update-workspace created prompting by default"; exit 1; }
grep -q "existing status" "$generic_workspace/core/status.md" || { echo "update-workspace overwrote core/status.md"; exit 1; }
grep -q "existing memory" "$generic_workspace/memory/workspace-memory.md" || { echo "update-workspace overwrote workspace-memory.md"; exit 1; }
grep -q "client data" "$generic_workspace/clients/existing-client/private.md" || { echo "update-workspace modified client data"; exit 1; }
grep -q "project data" "$generic_workspace/projects/existing-project/private.md" || { echo "update-workspace modified project data"; exit 1; }
grep -q "insight data" "$generic_workspace/system-insights/insights/2026-06-12-existing.md" || { echo "update-workspace modified system insight entry"; exit 1; }
grep -q "external memory data" "$generic_workspace/external-memory/existing.md" || { echo "update-workspace modified external memory"; exit 1; }
test "$exclude_before" = "$(cat "$copy_repo/.git/info/exclude")" || { echo "update-workspace modified .git/info/exclude"; exit 1; }
test ! -e "$copy_repo/AGENTS.md" || { echo "update-workspace created root AGENTS.md"; exit 1; }

primary_detected_workspace="$tmp/update-workspace-primary-detected"
mkdir -p "$primary_detected_workspace"
printf '%s\n' "# Existing Primary Status" > "$primary_detected_workspace/status.md"
run_must_pass "update-workspace-primary-detected" "$update_workspace_script" --workspace "$primary_detected_workspace"
test -f "$primary_detected_workspace/memory.md" || { echo "update-workspace did not backfill primary memory.md"; exit 1; }
test -f "$primary_detected_workspace/checkpoints/README.md" || { echo "update-workspace did not backfill primary checkpoints README"; exit 1; }
test ! -d "$primary_detected_workspace/owned-assets" || { echo "update-workspace treated detected primary workspace as generic"; exit 1; }

primary_explicit_workspace="$tmp/update-workspace-primary-explicit"
mkdir -p "$primary_explicit_workspace"
run_must_pass "update-workspace-primary-explicit" "$update_workspace_script" --workspace "$primary_explicit_workspace" --workspace-profile primary-entity
test -f "$primary_explicit_workspace/status.md" || { echo "update-workspace explicit primary did not create status.md"; exit 1; }
test -f "$primary_explicit_workspace/assets/README.md" || { echo "update-workspace explicit primary did not create assets README"; exit 1; }

missing_workspace="$tmp/update-workspace-missing"
run_must_fail "update-workspace-missing-root-stops" "$update_workspace_script" --workspace "$missing_workspace"

all_active_workspace="$tmp/update-workspace-all-active"
all_paused_workspace="$tmp/update-workspace-all-paused"
all_planned_workspace="$tmp/update-workspace-all-planned"
all_archived_workspace="$tmp/update-workspace-all-archived"
all_missing_workspace="$tmp/update-workspace-all-missing"
mkdir -p "$all_active_workspace" "$all_paused_workspace" "$all_planned_workspace" "$all_archived_workspace"
cat > "$copy_repo/ai-system-workspaces.md" <<MD
# AI System Workspaces

| workspace-id | path | default | status | scope | notes |
| --- | --- | --- | --- | --- | --- |
| all-active | $all_active_workspace | yes | active | smoke | active |
| all-paused | $all_paused_workspace | no | paused | smoke | paused |
| all-planned | $all_planned_workspace | no | planned | smoke | planned |
| all-archived | $all_archived_workspace | no | archived | smoke | archived |
| all-missing | $all_missing_workspace | no | active | smoke | missing |
MD
run_must_pass "update-workspace-all" "$update_workspace_script" --all
test -f "$all_active_workspace/core/workstreams.md" || { echo "update-workspace --all did not update active workspace"; exit 1; }
test -f "$all_paused_workspace/core/workstreams.md" || { echo "update-workspace --all did not update paused workspace"; exit 1; }
test ! -e "$all_planned_workspace/core/workstreams.md" || { echo "update-workspace --all updated planned workspace"; exit 1; }
test ! -e "$all_archived_workspace/core/workstreams.md" || { echo "update-workspace --all updated archived workspace"; exit 1; }
test ! -e "$all_missing_workspace" || { echo "update-workspace --all created missing workspace root"; exit 1; }
run_must_pass "update-workspace-explicit-archived" "$update_workspace_script" --workspace "$all_archived_workspace"
test -f "$all_archived_workspace/core/workstreams.md" || { echo "update-workspace explicit archived workspace was not updated"; exit 1; }
rm "$copy_repo/ai-system-workspaces.md"

system_insights_validator="$copy_repo/.systems/scripts/check-system-insights"
system_insights_workspace="$tmp/system-insights-smoke-workspace"
mkdir -p "$system_insights_workspace/system-insights/insights" "$system_insights_workspace/external-memory"

run_must_pass "system-insights-baseline" "$system_insights_validator"

cat > "$system_insights_workspace/system-insights/insights/2026-06-12-valid-frontend.md" <<'MD'
# 2026-06-12 - Valid Frontend Insight

- Date: `2026-06-12`
- Category: `frontend`
- Status: `accepted`
- Source scope: `checkpoint`
- Privacy check: `confirmed no raw client data, client names, secrets, repo-specific facts, project-specific details, or production identifiers`
- Skill candidate: `yes`
- Suggested skill target: `AI_SYSTEM_WORKSPACE_HOME/skills/frontend-quality-review`

## TEMAT

- `Frontend - jakość UI`

## 0. SYGNAŁY

- Visual QA catches layout issues that static checks miss.

## 1. CO ZOSTAŁO FAKTYCZNIE ZROBIONE

- Converted repeated UI review observations into an anonymized checklist candidate.

## 2. PROBLEMY (→ KONWERSJA)

| Problem | Przyczyna | Konwersja |
| --- | --- | --- |
| Text overflow in compact controls | Responsive constraints were incomplete | Verify longest labels on mobile and desktop |

## 3. WZORCE

- Repeated UI issues cluster around overflow, state coverage, and unstable dimensions.

## 4. DECYZJE

| Treść | Wpływ |
| --- | --- |
| Include viewport and state checks in frontend review | Reduces visual regressions that pass static validation |

## 5. ZASADY NA PRZYSZŁOŚĆ

| Zasada | Kiedy stosować |
| --- | --- |
| Verify compact components with realistic long content | When UI includes buttons, cards, tabs, counters, or toolbars |

## 6. OTWARTE LUKI

- Need a reusable frontend quality skill.

## 7. ODRZUCONE JAKO SZUM

| Pominięte | Dlaczego |
| --- | --- |
| Exact project copy and brand details | Not reusable and could identify the source project |

## 8. WALIDACJA OPERACYJNA

### co zostaje

- Keep viewport and state visual QA as a reusable frontend standard.

### co poprawić / usunąć

- Remove review patterns that rely only on static validation.

### czego brakuje

- A concrete skill checklist with viewport sizes and acceptance rules.
MD
run_must_pass "system-insights-valid-entry" env AI_SYSTEM_WORKSPACE_HOME="$system_insights_workspace" "$system_insights_validator"

cat > "$system_insights_workspace/system-insights/insights/2026-06-12-missing-privacy.md" <<'MD'
# 2026-06-12 - Missing Privacy

- Date: `2026-06-12`
- Category: `quality`
- Status: `proposed`
- Source scope: `QA review`
- Skill candidate: `no`
- Suggested skill target: `n/a`

## TEMAT
## 0. SYGNAŁY
## 1. CO ZOSTAŁO FAKTYCZNIE ZROBIONE
## 2. PROBLEMY (→ KONWERSJA)
## 3. WZORCE
## 4. DECYZJE
## 5. ZASADY NA PRZYSZŁOŚĆ
## 6. OTWARTE LUKI
## 7. ODRZUCONE JAKO SZUM
## 8. WALIDACJA OPERACYJNA
### co zostaje
### co poprawić / usunąć
### czego brakuje
MD
run_must_fail "system-insights-missing-privacy-check" env AI_SYSTEM_WORKSPACE_HOME="$system_insights_workspace" "$system_insights_validator"
rm "$system_insights_workspace/system-insights/insights/2026-06-12-missing-privacy.md"

cat > "$system_insights_workspace/system-insights/insights/2026-06-12-missing-operational-validation.md" <<'MD'
# 2026-06-12 - Missing Operational Validation

- Date: `2026-06-12`
- Category: `quality`
- Status: `proposed`
- Source scope: `QA review`
- Privacy check: `confirmed no raw client data, client names, secrets, repo-specific facts, project-specific details, or production identifiers`
- Skill candidate: `no`
- Suggested skill target: `n/a`

## TEMAT
## 0. SYGNAŁY
## 1. CO ZOSTAŁO FAKTYCZNIE ZROBIONE
## 2. PROBLEMY (→ KONWERSJA)
## 3. WZORCE
## 4. DECYZJE
## 5. ZASADY NA PRZYSZŁOŚĆ
## 6. OTWARTE LUKI
## 7. ODRZUCONE JAKO SZUM
## 8. WALIDACJA OPERACYJNA
### co zostaje
### co poprawić / usunąć
MD
run_must_fail "system-insights-missing-operational-validation" env AI_SYSTEM_WORKSPACE_HOME="$system_insights_workspace" "$system_insights_validator"
rm "$system_insights_workspace/system-insights/insights/2026-06-12-missing-operational-validation.md"

cp "$system_insights_workspace/system-insights/insights/2026-06-12-valid-frontend.md" "$system_insights_workspace/system-insights/insights/2026-06-12-raw-client-marker.md"
echo "client_name: Example Client" >> "$system_insights_workspace/system-insights/insights/2026-06-12-raw-client-marker.md"
run_must_fail "system-insights-blocks-raw-client-data" env AI_SYSTEM_WORKSPACE_HOME="$system_insights_workspace" "$system_insights_validator"
rm "$system_insights_workspace/system-insights/insights/2026-06-12-raw-client-marker.md"

cat > "$system_insights_workspace/external-memory/2026-06-12-frontend-lesson.md" <<'MD'
# Frontend Lesson

Frontend lesson insight about component quality belongs in System Insights.
MD
run_must_fail "system-insights-blocks-product-domain-external-memory" env AI_SYSTEM_WORKSPACE_HOME="$system_insights_workspace" "$system_insights_validator"
rm "$system_insights_workspace/external-memory/2026-06-12-frontend-lesson.md"

init_target="$tmp/init-system-insights-workspace"
run_must_pass "init-workspace-system-insights" "$copy_repo/.systems/scripts/init-workspace" --workspace "$init_target" --workspace-id smoke
test -f "$init_target/system-insights/system-insights.md" || { echo "init-workspace did not create system insights router"; exit 1; }
test -f "$init_target/system-insights/insights/README.md" || { echo "init-workspace did not create system insights entries README"; exit 1; }
test -f "$init_target/core/workstreams.md" || { echo "init-workspace did not create core/workstreams.md"; exit 1; }
test -f "$init_target/project-state/project-state.md" || { echo "init-workspace did not create project-state router"; exit 1; }

echo "Validator smoke tests passed."
