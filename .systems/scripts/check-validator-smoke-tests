grep -q 'custom value' "$personal_ops_unmapped_workspace/personal-ops/indexes/check-ins.jsonl" || { echo "JSONL index missing custom unmapped field value"; exit 1; }

grep -q 'last-sync-source: notion-import' "$personal_ops_workspace/personal-ops/indexes/check-ins.md" || { echo "notion mapper did not record notion-import sync source"; exit 1; }
grep -q 'unsynced-check-in-count: 0' "$personal_ops_workspace/personal-ops/indexes/check-ins.md" || { echo "notion mapper did not reset unsynced count"; exit 1; }

personal_ops_same_source_workspace="$tmp/personal-ops-same-source-workspace"
personal_ops_same_source_input="$tmp/notion-check-ins-same-source.csv"
mkdir -p "$personal_ops_same_source_workspace"
