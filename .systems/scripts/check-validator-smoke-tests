write_dream_report() {
  local file="$1"
  local variant="$2"
  local repo_row="$3"
  local explicit_path="$4"
  mkdir -p "$(dirname "$file")"
  cat > "$file" <<MD
# Dream Report

## Metadata

- Date: \`2026-06-19\`
- Dream variant: \`$variant\`
- Workspace: \`/tmp/workspace\`
- Project/source path: \`$explicit_path\`
- Result: \`completed\`

## Source Inventory

| Source path | Source type | Reviewed? | Notes |
| --- | --- | --- | --- |
| \`core/status.md\` | \`workspace-artifact\` | \`yes\` | safe |

## Workspace Artifact Findings

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`core/status.md\` | Review stale blocker wording. | \`status/evidence\` | Keeps workspace easier to resume. | \`safe\` | \`review\` |

## Project/Repo Review Findings

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
$repo_row

## Memory Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`memory/workspace-memory.md\` | No durable capture needed. | \`none\` | Duplicate of existing report. | \`safe\` | \`reject\` |

## Project-State / Status Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`project-state/project-state.md\` | Review candidate only. | \`project-state\` | Could improve routing later. | \`safe\` | \`defer\` |

## System Insights Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`system-insights/system-insights.md\` | Candidate requires anonymization. | \`system-insights\` | Reusable workflow lesson. | \`needs anonymization\` | \`defer\` |

## External Memory Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`external-memory/README.md\` | No product improvement. | \`none\` | Not actionable. | \`safe\` | \`reject\` |

## Skill Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`skills/README.md\` | No skill candidate. | \`none\` | Too broad. | \`safe\` | \`reject\` |

## Personal Ops Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`personal-ops/indexes/check-ins.md\` | Review index freshness only. | \`personal-ops\` | Avoid copying private details. | \`private-sensitive\` | \`review\` |

## Things To Improve Or Remove

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`dump/README.md\` | Remove duplicate notes later. | \`review\` | Reduces noise. | \`safe\` | \`defer\` |

## Missing Capabilities

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`core/status.md\` | No missing capability. | \`none\` | No action. | \`safe\` | \`reject\` |

## Rejected As Noise

| Source path | Finding | Reason rejected |
| --- | --- | --- |
| \`dump/incoming/example.md\` | Vague note. | \`too vague\` |

## Privacy/Scope Check

- Raw client data copied: \`no\`
- Secret markers copied: \`no\`
- Production identifiers copied: \`no\`
- Personal/private details copied: \`no\`
- Full-repo explicit project/source path provided: \`$explicit_path\`
- Full-repo exclusions respected: \`yes\`
- Context-as-data boundary respected: \`yes\`
- Durable writes performed: \`no\`
- Scheduler/automation used: \`no\`

## Owner Decision Queue

| Priority | Source path | Finding | Proposed target | Owner action |
| --- | --- | --- | --- | --- |
| \`P2\` | \`core/status.md\` | Review stale blocker wording. | \`status/evidence\` | \`review\` |
MD
}

dream_workspace="$tmp/dreaming-workspace"
workflow_report="$dream_workspace/dreams/runs/2026-06-19-workspace/dream-report.md"
write_dream_report "$workflow_report" "workspace-artifacts-only" '| `not-applicable` | `not-applicable` | `none` | `not-applicable` | `safe` | `reject` |' "not-applicable"
run_must_pass "dreaming-mode-valid-workspace-report" "$dreaming_validator" --workspace "$dream_workspace"

full_repo_workspace="$tmp/dreaming-full-repo-workspace"
full_repo_report="$full_repo_workspace/dreams/runs/2026-06-19-full-repo/dream-report.md"
write_dream_report "$full_repo_report" "full-repo" '| `projects/example/app.md` | `Review repeated manual step.` | `review` | `Could become a task.` | `safe` | `review` |' "yes"
run_must_pass "dreaming-mode-valid-full-repo-report" "$dreaming_validator" --workspace "$full_repo_workspace"

bad_dream_workspace="$tmp/dreaming-bad-workspace"
bad_dream_report="$bad_dream_workspace/dreams/runs/2026-06-19-bad/dream-report.md"
write_dream_report "$bad_dream_report" "workspace-artifacts-only" '| `not-applicable` | `not-applicable` | `none` | `not-applicable` | `safe` | `reject` |' "not-applicable"
printf '%s\n' 'api_key: sk_test_12345678901234567890' >> "$bad_dream_report"
run_must_fail "dreaming-mode-secret-marker-report" "$dreaming_validator" --workspace "$bad_dream_workspace"

init_target="$tmp/init-system-insights-workspace"
run_must_pass "init-workspace-system-insights" "$copy_repo/.systems/scripts/init-workspace" --workspace "$init_target" --workspace-id smoke --workspace-profile primary-entity
test -f "$init_target/system-insights/system-insights.md" || { echo "init-workspace did not create system insights router"; exit 1; }
test -f "$init_target/system-insights/insights/README.md" || { echo "init-workspace did not create system insights entries README"; exit 1; }
test -f "$init_target/core/workstreams.md" || { echo "init-workspace did not create core/workstreams.md"; exit 1; }
test -f "$init_target/project-state/project-state.md" || { echo "init-workspace did not create project-state router"; exit 1; }
test -f "$init_target/links/README.md" || { echo "init-workspace did not create links README"; exit 1; }
test -f "$init_target/personal-ops/check-ins/README.md" || { echo "init-workspace did not create personal-ops check-ins README"; exit 1; }
test -f "$init_target/personal-ops/check-ins/import-profiles/manual-daily-check-in.md" || { echo "init-workspace did not create manual daily check-in profile"; exit 1; }
test -f "$init_target/personal-ops/indexes/check-ins.md" || { echo "init-workspace did not create personal-ops check-ins index"; exit 1; }
test -f "$init_target/tasks/README.md" || { echo "init-workspace did not create tasks README"; exit 1; }
test -f "$init_target/tasks/tasknote.template.md" || { echo "init-workspace did not create tasknote template"; exit 1; }
test -f "$init_target/tasks/taskforge-vault-setup.template.md" || { echo "init-workspace did not create taskforge setup template"; exit 1; }
test -f "$init_target/dreams/README.md" || { echo "init-workspace did not create dreams README"; exit 1; }
test -d "$init_target/dreams/runs" || { echo "init-workspace did not create dreams/runs"; exit 1; }

dreams_update_workspace="$tmp/dreaming-update-workspace"
mkdir -p "$dreams_update_workspace/dreams/runs/2026-06-19-existing"
printf '%s\n' 'existing report sentinel' > "$dreams_update_workspace/dreams/runs/2026-06-19-existing/dream-report.md"
run_must_pass "update-workspace-dreams-backfill" "$copy_repo/.systems/scripts/update-workspace" --workspace "$dreams_update_workspace"
test -f "$dreams_update_workspace/dreams/README.md" || { echo "update-workspace did not create dreams README"; exit 1; }
grep -q 'existing report sentinel' "$dreams_update_workspace/dreams/runs/2026-06-19-existing/dream-report.md" || { echo "update-workspace overwrote existing dream report"; exit 1; }

task_update_workspace="$tmp/task-management-update-workspace"
mkdir -p "$task_update_workspace/tasks"
printf '%s\n' 'existing tasks readme sentinel' > "$task_update_workspace/tasks/README.md"
run_must_pass "update-workspace-task-management-backfill" "$copy_repo/.systems/scripts/update-workspace" --workspace "$task_update_workspace" --workspace-profile primary-entity
grep -q 'existing tasks readme sentinel' "$task_update_workspace/tasks/README.md" || { echo "update-workspace overwrote existing tasks README"; exit 1; }
test -f "$task_update_workspace/tasks/tasknote.template.md" || { echo "update-workspace did not create tasknote template"; exit 1; }
test -f "$task_update_workspace/tasks/taskforge-vault-setup.template.md" || { echo "update-workspace did not create taskforge setup template"; exit 1; }

validation_profiles_validator="$copy_repo/.systems/scripts/check-validation-profiles"
validation_profiles_script="$copy_repo/.systems/scripts/validate-ai-system"
run_must_pass "validation-profiles-valid" "$validation_profiles_validator"
run_must_pass "validation-profile-fast-explain" "$validation_profiles_script" --profile fast --explain
run_must_pass "validation-profile-scoped-check" "$validation_profiles_script" --profile scoped --checks check-validation-profiles --explain
run_must_fail "validation-profile-scoped-requires-checks" "$validation_profiles_script" --profile scoped

validation_profiles_skip_out="$tmp/validation-profile-full-skip-smoke.out"
if ! (cd "$copy_repo" && env AI_SYSTEM_SKIP_SMOKE_TESTS=1 "$validation_profiles_script" --profile full) >"$validation_profiles_skip_out" 2>&1; then
  echo "Smoke test failed: validation-profile-full-skip-smoke should have passed"
  cat "$validation_profiles_skip_out"
  exit 1
fi
grep -F -q 'AI System validation completed with smoke tests skipped; not final validation evidence without explicit owner acceptance of residual risk.' "$validation_profiles_skip_out" || { echo "Skipped-smoke validation missing non-final completion wording"; exit 1; }
if grep -F -q 'AI System validation passed (full profile).' "$validation_profiles_skip_out"; then
  echo "Skipped-smoke validation reported full-profile pass"
  exit 1
fi

cp "$copy_repo/.systems/scripts/validate-ai-system" "$copy_repo/.systems/scripts/validate-ai-system.bak"
perl -0pi -e 's/profile="standard"/profile="full"/' "$copy_repo/.systems/scripts/validate-ai-system"
run_must_fail "validation-profiles-require-standard-default" "$validation_profiles_validator"
mv "$copy_repo/.systems/scripts/validate-ai-system.bak" "$copy_repo/.systems/scripts/validate-ai-system"

cp "$copy_repo/.github/workflows/ai-system-validate.yml" "$copy_repo/.github/workflows/ai-system-validate.yml.bak"
perl -0pi -e 's/validate-ai-system --profile full/validate-ai-system/' "$copy_repo/.github/workflows/ai-system-validate.yml"
run_must_fail "validation-profiles-require-ci-explicit-full" "$validation_profiles_validator"
mv "$copy_repo/.github/workflows/ai-system-validate.yml.bak" "$copy_repo/.github/workflows/ai-system-validate.yml"

cp "$copy_repo/.systems/scripts/validate-ai-system" "$copy_repo/.systems/scripts/validate-ai-system.bak"
perl -0pi -e 's/check-validator-smoke-tests/check-validator-light-tests/g' "$copy_repo/.systems/scripts/validate-ai-system"
run_must_fail "validation-profiles-require-full-smoke-tests" "$validation_profiles_validator"
mv "$copy_repo/.systems/scripts/validate-ai-system.bak" "$copy_repo/.systems/scripts/validate-ai-system"

cp "$copy_repo/.systems/ai/core/validation-profiles.md" "$copy_repo/.systems/ai/core/validation-profiles.md.bak"
printf '\nfast is enough before commit\n' >> "$copy_repo/.systems/ai/core/validation-profiles.md"
run_must_fail "validation-profiles-block-fast-enough-before-commit" "$validation_profiles_validator"
mv "$copy_repo/.systems/ai/core/validation-profiles.md.bak" "$copy_repo/.systems/ai/core/validation-profiles.md"

cp "$copy_repo/.systems/ai/core/validation-profiles.md" "$copy_repo/.systems/ai/core/validation-profiles.md.bak"
printf '\nstandard may replace full\n' >> "$copy_repo/.systems/ai/core/validation-profiles.md"
run_must_fail "validation-profiles-block-standard-replaces-full" "$validation_profiles_validator"
mv "$copy_repo/.systems/ai/core/validation-profiles.md.bak" "$copy_repo/.systems/ai/core/validation-profiles.md"

cp "$copy_repo/.systems/ai/core/validation-profiles.md" "$copy_repo/.systems/ai/core/validation-profiles.md.bak"
printf '\nskip smoke tests and mark PASS\n' >> "$copy_repo/.systems/ai/core/validation-profiles.md"
run_must_fail "validation-profiles-block-skipped-smoke-pass" "$validation_profiles_validator"
mv "$copy_repo/.systems/ai/core/validation-profiles.md.bak" "$copy_repo/.systems/ai/core/validation-profiles.md"

echo "Validator smoke tests passed."
