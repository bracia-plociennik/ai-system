        {"id": "build-01", "stream": "build", "title": "Demo Project analytics fixture"},
        {"id": "deliver-01", "stream": "deliver", "title": "Deliver analytics fixture"},
        {"id": "promote-01", "stream": "promote", "title": "Triage analytics fixture"},
    ]),
    "previous_day_actual_items_json": json.dumps([{ "id": "actual-build-01", "stream": "build", "title": "Closed fixture" }]),
    "previous_day_actual_build_count": 1,
