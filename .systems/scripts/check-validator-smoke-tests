grep -q 'ai-system:v3:2026-07-22:build-01' "$properties_v3_vault/TaskNotes/Tasks/demo-project-parent.md" || { echo "Properties v3 did not extend the matching TaskNote with a subtask"; exit 1; }
grep -q '^  task_generation_status: "created-and-subtasks"$' "$properties_v3_report" || { echo "Properties v3 did not record created-and-subtasks status"; exit 1; }
grep -q '^  task_generation_references_json: .*TaskNotes/Tasks/' "$properties_v3_report" || { echo "Properties v3 did not record TaskNote references"; exit 1; }
run_must_pass "personal-ops-properties-v3-write-tasknotes-deduplicates" "$copy_repo/.systems/scripts/propose-task-candidates" --workspace "$properties_v3_workspace" --check-in "$properties_v3_report" --task-vault "$properties_v3_vault" --owner-approved --write
test "$(rg -c 'ai-system:v3:2026-07-22:build-01' "$properties_v3_vault/TaskNotes/Tasks/demo-project-parent.md")" = "1" || { echo "Properties v3 duplicated a subtask on repeat write"; exit 1; }
grep -q '^  task_generation_status: "already-generated"$' "$properties_v3_report" || { echo "Properties v3 did not record deduplicated status"; exit 1; }
