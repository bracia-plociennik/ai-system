for field in schema["fields"]:
    key = field["key"]
    value = values[key]
    if isinstance(value, bool):
        rendered = "true" if value else "false"
    elif value == "":
        rendered = ""
    elif isinstance(value, (int, float)):
        rendered = str(value)
    else:
        rendered = json.dumps(str(value), ensure_ascii=False)
