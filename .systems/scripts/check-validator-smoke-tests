write_dream_report() {
  local file="$1"
  local variant="$2"
  local repo_row="$3"
  local project_source_path="$4"
  local repo_inventory_row="${5:-}"
  local explicit_path_confirmation="not-applicable"
  if [[ "$variant" == "full-repo" ]]; then
    explicit_path_confirmation="yes"
  fi
  mkdir -p "$(dirname "$file")"
  cat > "$file" <<MD
# Dream Report

## Metadata

- Date: \`2026-06-19\`
- Dream variant: \`$variant\`
- Workspace: \`/tmp/workspace\`
- Project/source path: \`$project_source_path\`
- Scope contract: \`1\`
- Scope policy: \`dreams/dreaming-scope.local.md\`
- Scope preflight: \`passed\`
- Result: \`completed\`

## Source Inventory

| Source path | Source type | Reviewed? | Notes |
| --- | --- | --- | --- |
| \`core/status.md\` | \`workspace-artifact\` | \`yes\` | safe |
$repo_inventory_row

## Workspace Artifact Findings

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`core/status.md\` | Review stale blocker wording. | \`status/evidence\` | Keeps workspace easier to resume. | \`safe\` | \`review\` |

## Project/Repo Review Findings

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
$repo_row

## Memory Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`memory/workspace-memory.md\` | No durable capture needed. | \`none\` | Duplicate of existing report. | \`safe\` | \`reject\` |

## Project-State / Status Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`project-state/project-state.md\` | Review candidate only. | \`project-state\` | Could improve routing later. | \`safe\` | \`defer\` |

## System Insights Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`system-insights/system-insights.md\` | Candidate requires anonymization. | \`system-insights\` | Reusable workflow lesson. | \`needs anonymization\` | \`defer\` |

## External Memory Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`external-memory/README.md\` | No product improvement. | \`none\` | Not actionable. | \`safe\` | \`reject\` |

## Skill Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`skills/README.md\` | No skill candidate. | \`none\` | Too broad. | \`safe\` | \`reject\` |

## Personal Ops Candidates

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`personal-ops/indexes/check-ins-v3.trends.md\` | Review sanitized trends only. | \`personal-ops\` | Avoid copying private details. | \`private-sensitive\` | \`review\` |

## Things To Improve Or Remove

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`dump/README.md\` | Remove duplicate notes later. | \`review\` | Reduces noise. | \`safe\` | \`defer\` |

## Missing Capabilities

| Source path | Finding | Target | Reason | Risk/privacy note | Owner action |
| --- | --- | --- | --- | --- | --- |
| \`core/status.md\` | No missing capability. | \`none\` | No action. | \`safe\` | \`reject\` |

## Undistilled Work Queue

- Total state records reviewed: \`1\`
- Pending quality: \`0\`
- Ready: \`1\`
- Deferred: \`0\`
- Blocked: \`0\`
- Owner skipped: \`0\`
- Completed/not-applicable: \`0\`

| Work ID | State | State record path | Source artifact path | Quality evidence | Proposed distillation target | Blocker/missing decision | Privacy/scope | Owner action | Residual risk |
| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |
| \`work-001\` | \`ready\` | \`capture-state/work-001.md\` | \`core/status.md\` | \`check-status\` | \`distillations/work-001.md\` | \`none\` | \`pass\` | \`distill\` | \`none\` |

## Rejected As Noise

| Source path | Finding | Reason rejected |
| --- | --- | --- |
| \`dump/incoming/example.md\` | Vague note. | \`too vague\` |

## Privacy/Scope Check

- Raw client data copied: \`no\`
- Secret markers copied: \`no\`
- Production identifiers copied: \`no\`
- Personal/private details copied: \`no\`
- Full-repo explicit project/source path provided: \`$explicit_path_confirmation\`
- Full-repo exclusions respected: \`yes\`
- Context-as-data boundary respected: \`yes\`
- Durable writes performed: \`no\`
- Scheduler/automation used: \`no\`

## Owner Decision Queue

| Priority | Source path | Finding | Proposed target | Owner action |
| --- | --- | --- | --- | --- |
| \`P2\` | \`core/status.md\` | Review stale blocker wording. | \`status/evidence\` | \`review\` |
MD
}

prepare_dream_workspace() {
  local workspace="$1"
  mkdir -p "$workspace/dreams" "$workspace/core"
  cp "$copy_repo/.systems/ai/templates/workspace/dreams/dreaming-scope.local.template.md" "$workspace/dreams/dreaming-scope.local.md"
  printf '%s\n' '# Status' > "$workspace/core/status.md"
}

replace_dream_inventory_path() {
  local report="$1"
  local replacement="$2"
  python3 - "$report" "$replacement" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
replacement = sys.argv[2]
text = path.read_text()
old = "| `core/status.md` | `workspace-artifact` | `yes` | safe |"
new = f"| `{replacement}` | `workspace-artifact` | `yes` | safe |"
if old not in text:
    raise SystemExit("source inventory fixture row not found")
path.write_text(text.replace(old, new, 1))
PY
}

add_scope_allowed_path() {
  local scope="$1"
  local source_path="$2"
  python3 - "$scope" "$source_path" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
source_path = sys.argv[2]
text = path.read_text()
marker = "| `core/status.md` |"
if marker not in text:
    raise SystemExit("scope fixture marker not found")
path.write_text(text.replace(marker, marker + f"\n| `{source_path}` |", 1))
PY
}

