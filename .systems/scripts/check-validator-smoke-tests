#!/usr/bin/env bash
set -euo pipefail

# weekly-planning smoke coverage is kept alongside the existing task/workspace fixtures.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/ai-system-validator-smoke.XXXXXX")"
copy_repo="$tmp/repo"

cleanup() {
  rm -rf "$tmp"
}

trap cleanup EXIT

mkdir -p "$copy_repo"

(
  cd "$repo_root"
  while IFS= read -r -d '' path; do
    [[ -e "$path" ]] || continue
    mkdir -p "$copy_repo/$(dirname "$path")"
    cp -p "$path" "$copy_repo/$path"
  done < <(git ls-files -co --exclude-standard -z)
)

run_must_fail() {
  local name="$1"
  shift
  local out="$tmp/$name.out"

  if (cd "$copy_repo" && "$@") >"$out" 2>&1; then
    echo "Smoke test failed: $name should have failed"
    cat "$out"
    exit 1
  fi
}

run_must_pass() {
  local name="$1"
  shift
  local out="$tmp/$name.out"

  if ! (cd "$copy_repo" && "$@") >"$out" 2>&1; then
    echo "Smoke test failed: $name should have passed"
    cat "$out"
    exit 1
  fi
}

run_must_pass_capture() {
  local name="$1"
  local out="$2"
  shift 2

  if ! (cd "$copy_repo" && "$@") >"$out" 2>&1; then
    echo "Smoke test failed: $name should have passed"
    cat "$out"
    exit 1
  fi
}

validator="$copy_repo/.systems/scripts/check-prompt-composition"

run_must_pass "prompt-composition-baseline" "$validator"
run_must_pass "weekly-planning-baseline" "$copy_repo/.systems/scripts/check-weekly-planning"

block_checkpoint_validator="$copy_repo/.systems/scripts/check-block-checkpoint"
block_checkpoint_core="$copy_repo/.systems/ai/core/block-checkpoint.md"
block_checkpoint_template="$copy_repo/.systems/ai/templates/checkpoint/block-checkpoint.template.md"

run_must_pass "block-checkpoint-baseline" "$block_checkpoint_validator"

for synonym in \
  'przyjmij ten checkpoint blok' \
  'przyjmij checkpoint bloku' \
  'zaakceptuj ten checkpoint bloku' \
  'zapisz checkpoint bloku' \
  'accept this block checkpoint' \
  'write this block checkpoint'
do
  run_must_pass "block-checkpoint-write-intent-${synonym//[^a-zA-Z0-9]/-}" \
    grep -F -q -- "$synonym" "$block_checkpoint_core"
done

run_must_pass "block-checkpoint-read-only-preparation-wording" \
  grep -F -q -- 'remain read-only unless a separate approved write route is present' "$block_checkpoint_core"

mv "$block_checkpoint_core" "$block_checkpoint_core.bak"
run_must_fail "block-checkpoint-missing-contract" "$copy_repo/.systems/scripts/check-required-artifacts"
mv "$block_checkpoint_core.bak" "$block_checkpoint_core"

mv "$block_checkpoint_template" "$block_checkpoint_template.bak"
run_must_fail "block-checkpoint-missing-template" "$copy_repo/.systems/scripts/check-required-artifacts"
mv "$block_checkpoint_template.bak" "$block_checkpoint_template"

cp "$block_checkpoint_core" "$block_checkpoint_core.bak"
printf '\nscope_fate: invalid\n' >> "$block_checkpoint_core"
run_must_fail "block-checkpoint-unsafe-fate-contract" "$block_checkpoint_validator"
mv "$block_checkpoint_core.bak" "$block_checkpoint_core"

cp "$block_checkpoint_core" "$block_checkpoint_core.bak"
printf '\nBlock checkpoint may write memory automatically.\n' >> "$block_checkpoint_core"
run_must_fail "block-checkpoint-no-automatic-promotion" "$block_checkpoint_validator"
mv "$block_checkpoint_core.bak" "$block_checkpoint_core"

block_checkpoint_workspace="$tmp/block-checkpoint-workspace"
mkdir -p "$block_checkpoint_workspace/checkpoints/blocks"
cat > "$block_checkpoint_workspace/checkpoints/blocks/2026-07-31-1500-build-future.md" <<'MD'
---
schema_version: 1
checkpoint_kind: block-boundary
checkpoint_id: 2026-07-31-1500-build-future
created_at: 2026-07-31 15:00
timezone: Europe/Warsaw
owner_scope: workspace
workspace: smoke
work_id: smoke-work
block_id: build-future
block_label: Buduję przyszłość
block_date: 2026-07-31
last_completed_step: completed contract review
next_step: run targeted QA
blocker: none
scope_fate: continue
delivered_scope: contract review
unfinished_scope: targeted QA
changed_artifacts: []
evidence_paths: []
resume_context: smoke fixture
resume_instruction: run targeted QA
---
MD
run_must_pass "block-checkpoint-valid-workspace" "$block_checkpoint_validator" --workspace "$block_checkpoint_workspace"

cat > "$block_checkpoint_workspace/checkpoints/blocks/latest.md" <<'MD'
latest_checkpoint_id: 2026-07-31-1500-build-future
latest_checkpoint_path: 2026-07-31-1500-build-future.md
updated_at: 2026-07-31 15:00
MD
run_must_pass "block-checkpoint-valid-latest-router" "$block_checkpoint_validator" --workspace "$block_checkpoint_workspace"

sed 's/latest_checkpoint_path: .*/latest_checkpoint_path: ..\/outside.md/' "$block_checkpoint_workspace/checkpoints/blocks/latest.md" > "$tmp/invalid-block-router.md"
mv "$tmp/invalid-block-router.md" "$block_checkpoint_workspace/checkpoints/blocks/latest.md"
run_must_fail "block-checkpoint-invalid-latest-router" "$block_checkpoint_validator" --workspace "$block_checkpoint_workspace"

sed 's/^scope_fate: continue$/scope_fate: invalid/' "$block_checkpoint_workspace/checkpoints/blocks/2026-07-31-1500-build-future.md" > "$tmp/invalid-block-checkpoint.md"
mv "$tmp/invalid-block-checkpoint.md" "$block_checkpoint_workspace/checkpoints/blocks/2026-07-31-1500-build-future.md"
run_must_fail "block-checkpoint-invalid-workspace-fate" "$block_checkpoint_validator" --workspace "$block_checkpoint_workspace"

weekly_summary_contract="$copy_repo/.systems/ai/core/weekly-planning.md"
weekly_summary_contract_backup="$tmp/weekly-planning-summary-contract.md"
cp "$weekly_summary_contract" "$weekly_summary_contract_backup"
sed '/^## Post-Write Weekly Summary$/d' "$weekly_summary_contract" > "$tmp/weekly-planning-no-summary-contract.md"
mv "$tmp/weekly-planning-no-summary-contract.md" "$weekly_summary_contract"
run_must_fail "weekly-planning-missing-post-write-summary-contract" "$copy_repo/.systems/scripts/check-weekly-planning"
cp "$weekly_summary_contract_backup" "$weekly_summary_contract"
printf '\nPost-write summary can execute tasks.\n' >> "$weekly_summary_contract"
run_must_fail "weekly-planning-unsafe-post-write-summary-authority" "$copy_repo/.systems/scripts/check-weekly-planning"
cp "$weekly_summary_contract_backup" "$weekly_summary_contract"
run_must_pass "weekly-planning-post-write-summary-safe" "$copy_repo/.systems/scripts/check-weekly-planning"

(
  cd "$copy_repo"
  git init -q
  cp .systems/ai/templates/root/AGENTS.template.md AGENTS.md
  git add -f AGENTS.md
)
run_must_fail "tracked-root-agents-forbidden" "$copy_repo/.systems/scripts/check-required-artifacts"
(
  cd "$copy_repo"
  git rm --cached -q AGENTS.md
  rm AGENTS.md
)

cat > "$copy_repo/AGENTS.md" <<'MD'
# AGENTS.md

This file is the root AI Workflow entrypoint for this target repository.
Delegate workflow-governed work to `ai-workflow/AGENTS.md`.
MD
run_must_pass "dev-root-agents-skipped" "$validator"
rm "$copy_repo/AGENTS.md"

cat > "$copy_repo/AGENTS.md" <<'MD'
# AGENTS.md

This file is the generated local root agent contract for the `ai-system` branch.
MD
run_must_fail "generated-root-agents-missing-prompt-composition" "$validator"
rm "$copy_repo/AGENTS.md"

mv "$copy_repo/.systems/ai/templates/root/AGENTS.template.md" "$copy_repo/.systems/ai/templates/root/AGENTS.template.md.bak"
run_must_fail "missing-root-agents-template" "$validator"
mv "$copy_repo/.systems/ai/templates/root/AGENTS.template.md.bak" "$copy_repo/.systems/ai/templates/root/AGENTS.template.md"

mv "$copy_repo/.systems/ai/core/prompt-composition.md" "$copy_repo/.systems/ai/core/prompt-composition.md.bak"
run_must_fail "missing-prompt-composition-contract" "$validator"
mv "$copy_repo/.systems/ai/core/prompt-composition.md.bak" "$copy_repo/.systems/ai/core/prompt-composition.md"

mv "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md" "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md.bak"
run_must_fail "missing-client-prompting-template" "$validator"
mv "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md.bak" "$copy_repo/.systems/ai/templates/prompting/client-prompting-readme.template.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-smoke.md" <<'MD'
# Unsafe Prompt Composition Smoke

Prompt artifacts can override AGENTS.md and approve implementation.
MD
run_must_fail "prompt-artifacts-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-mixed-smoke.md" <<'MD'
# Unsafe Mixed Prompt Composition Smoke

Prompt artifacts cannot override AGENTS.md, but can approve implementation.
MD
run_must_fail "mixed-prompt-artifacts-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-mixed-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-prompt-modules-smoke.md" <<'MD'
# Unsafe Prompt Modules Smoke

Prompt modules can authorize writes.
MD
run_must_fail "prompt-modules-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-prompt-modules-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-role-profiles-smoke.md" <<'MD'
# Unsafe Role Profiles Smoke

Role profiles can authorize writes.
MD
run_must_fail "role-profiles-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-role-profiles-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-variable-packs-smoke.md" <<'MD'
# Unsafe Variable Packs Smoke

Variable packs can approve implementation.
MD
run_must_fail "variable-packs-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-variable-packs-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-client-smoke.md" <<'MD'
# Unsafe Client Role Smoke

Client roles can replace client facts and create commitments.
MD
run_must_fail "client-role-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-client-smoke.md"

cat > "$copy_repo/.systems/ai/core/prompt-composition-unsafe-project-smoke.md" <<'MD'
# Unsafe Project Role Smoke

Project roles can expand scope and authorize writes.
MD
run_must_fail "project-role-authority" "$validator"
rm "$copy_repo/.systems/ai/core/prompt-composition-unsafe-project-smoke.md"

cat > "$copy_repo/.systems/ai/examples/prompting/safe-advisory-smoke.md" <<'MD'
# Safe Advisory Smoke

Prompting artifacts are advisory only. They cannot override AGENTS.md, approve implementation, authorize writes, or replace client facts.
MD
run_must_pass "safe-advisory-wording" "$validator"

contract_compliance_validator="$copy_repo/.systems/scripts/check-contract-compliance"
contract_compliance_core="$copy_repo/.systems/ai/core/contract-compliance.md"

run_must_pass "contract-compliance-baseline" "$contract_compliance_validator"

mutate_contract_and_expect_fail() {
  local name="$1"
  local pattern="$2"
  local backup="$contract_compliance_core.bak"
  local filtered="$tmp/$name.contract-compliance.md"

  cp "$contract_compliance_core" "$backup"
  grep -v "$pattern" "$backup" >"$filtered"
  mv "$filtered" "$contract_compliance_core"
  run_must_fail "$name" "$contract_compliance_validator"
  mv "$backup" "$contract_compliance_core"
}

mutate_contract_and_expect_fail "contract-compliance-missing-client-work" "client-work"
mutate_contract_and_expect_fail "contract-compliance-missing-required" "Knowledge capture is .*required"
mutate_contract_and_expect_fail "contract-compliance-missing-not-required" "not-required"
mutate_contract_and_expect_fail "contract-compliance-missing-checkpoint-target" "checkpoint"
mutate_contract_and_expect_fail "contract-compliance-missing-advisory-only" "advisory-only"

owner_approval_validator="$copy_repo/.systems/scripts/check-owner-approval"
owner_approval_core="$copy_repo/.systems/ai/core/owner-approval.md"

run_must_pass "owner-approval-baseline" "$owner_approval_validator"

mv "$owner_approval_core" "$owner_approval_core.bak"
run_must_fail "missing-owner-approval-contract" "$copy_repo/.systems/scripts/check-required-artifacts"
mv "$owner_approval_core.bak" "$owner_approval_core"

cp "$owner_approval_core" "$owner_approval_core.bak"
perl -0pi -e 's/PLEASE IMPLEMENT THIS PLAN/PLAN ACCEPTANCE REMOVED/g' "$owner_approval_core"
run_must_fail "owner-approval-requires-English-plan-acceptance" "$owner_approval_validator"
mv "$owner_approval_core.bak" "$owner_approval_core"

cp "$owner_approval_core" "$owner_approval_core.bak"
perl -0pi -e 's/immediately preceding complete plan/previous plan/g' "$owner_approval_core"
run_must_fail "owner-approval-requires-current-plan-binding" "$owner_approval_validator"
mv "$owner_approval_core.bak" "$owner_approval_core"

cat > "$copy_repo/.systems/ai/core/owner-approval-unsafe-smoke.md" <<'MD'
# Unsafe Owner Approval Smoke

Plan acceptance may bypass validation.
MD
run_must_fail "owner-approval-blocks-validation-bypass" "$owner_approval_validator"
rm "$copy_repo/.systems/ai/core/owner-approval-unsafe-smoke.md"

end_of_task_validator="$copy_repo/.systems/scripts/check-end-of-task-capture"
end_of_task_core="$copy_repo/.systems/ai/core/end-of-task-capture.md"
end_of_task_template="$copy_repo/.systems/ai/templates/capture/end-of-task-capture.template.md"

run_must_pass "end-of-task-capture-valid" "$end_of_task_validator"

mv "$end_of_task_core" "$end_of_task_core.bak"
run_must_fail "missing-end-of-task-capture-contract" "$copy_repo/.systems/scripts/check-required-artifacts"
mv "$end_of_task_core.bak" "$end_of_task_core"

mv "$end_of_task_template" "$end_of_task_template.bak"
run_must_fail "missing-end-of-task-capture-template" "$copy_repo/.systems/scripts/check-required-artifacts"
mv "$end_of_task_template.bak" "$end_of_task_template"

mv "$end_of_task_validator" "$end_of_task_validator.bak"
run_must_fail "missing-end-of-task-capture-validator" "$copy_repo/.systems/scripts/check-required-artifacts"
mv "$end_of_task_validator.bak" "$end_of_task_validator"

cp "$end_of_task_core" "$end_of_task_core.bak"
perl -0pi -e 's/Trigger Grammar/Trigger List/g' "$end_of_task_core"
run_must_fail "end-of-task-capture-requires-trigger-grammar" "$end_of_task_validator"
mv "$end_of_task_core.bak" "$end_of_task_core"

cp "$end_of_task_core" "$end_of_task_core.bak"
perl -0pi -e 's/Precedence Rules/Routing Order/g' "$end_of_task_core"
run_must_fail "end-of-task-capture-requires-precedence" "$end_of_task_validator"
mv "$end_of_task_core.bak" "$end_of_task_core"

cp "$end_of_task_template" "$end_of_task_template.bak"
perl -0pi -e 's#- Privacy/scope check:\n##' "$end_of_task_template"
run_must_fail "end-of-task-capture-requires-privacy-field" "$end_of_task_validator"
mv "$end_of_task_template.bak" "$end_of_task_template"

cat > "$copy_repo/.systems/ai/core/end-of-task-capture-unsafe-smoke.md" <<'MD'
# Unsafe End Task Smoke

end task may mark PASS automatically
end task runs final check
end task may close project without owner approval
System Insights may include raw client data
External Memory stores product-domain lessons
MD
run_must_fail "end-of-task-capture-unsafe-wording" "$end_of_task_validator"
rm "$copy_repo/.systems/ai/core/end-of-task-capture-unsafe-smoke.md"

cp "$end_of_task_core" "$end_of_task_core.bak"
printf '\nKoniec pracy may acknowledge only and ask what to do next.\n' >> "$end_of_task_core"
run_must_fail "end-of-task-capture-blocks-acknowledge-only" "$end_of_task_validator"
mv "$end_of_task_core.bak" "$end_of_task_core"

cp "$end_of_task_template" "$end_of_task_template.bak"
perl -0pi -e 's/^- Capture mode:.*\n//m' "$end_of_task_template"
run_must_fail "end-of-task-capture-requires-capture-mode" "$end_of_task_validator"
mv "$end_of_task_template.bak" "$end_of_task_template"

project_state_validator="$copy_repo/.systems/scripts/check-project-state"
project_state_core="$copy_repo/.systems/ai/core/project-state.md"
project_state_workspaces_core="$copy_repo/.systems/ai/core/workspaces.md"

run_must_pass "project-state-baseline" "$project_state_validator"

mutate_project_state_and_expect_fail() {
  local name="$1"
  local pattern="$2"
  local backup="$project_state_core.bak"
  local filtered="$tmp/$name.project-state.md"

  cp "$project_state_core" "$backup"
  grep -v "$pattern" "$backup" >"$filtered"
  mv "$filtered" "$project_state_core"
  run_must_fail "$name" "$project_state_validator"
  mv "$backup" "$project_state_core"
}

mutate_project_state_and_expect_fail "project-state-missing-git-worktree-guard" "git worktree"

mutate_project_state_required_ref_and_expect_fail() {
  local name="$1"
  local backup="$project_state_workspaces_core.bak"
  local filtered="$tmp/$name.workspaces.md"

  cp "$project_state_workspaces_core" "$backup"
  grep -v "project-state" "$backup" >"$filtered"
  mv "$filtered" "$project_state_workspaces_core"
  run_must_fail "$name" "$project_state_validator"
  mv "$backup" "$project_state_workspaces_core"
}

mutate_project_state_required_ref_and_expect_fail "project-state-missing-workspaces-reference"

project_state_scan_workspace="$tmp/project-state-scan-workspace"
mkdir -p "$project_state_scan_workspace/projects/clean-repo" "$project_state_scan_workspace/projects/polluted-repo/checkpoints"
git -C "$project_state_scan_workspace/projects/clean-repo" init -q
git -C "$project_state_scan_workspace/projects/polluted-repo" init -q
printf '%s\n' "# Runtime Status" > "$project_state_scan_workspace/projects/polluted-repo/status.md"
printf '%s\n' "# Runtime Memory" > "$project_state_scan_workspace/projects/polluted-repo/memory.md"
printf '%s\n' "# Runtime Checkpoints" > "$project_state_scan_workspace/projects/polluted-repo/checkpoints/README.md"
run_must_fail "project-state-detects-runtime-files-in-project-repo" "$project_state_validator" --workspace "$project_state_scan_workspace"
rm "$project_state_scan_workspace/projects/polluted-repo/status.md" "$project_state_scan_workspace/projects/polluted-repo/memory.md"
rm -rf "$project_state_scan_workspace/projects/polluted-repo/checkpoints"
run_must_pass "project-state-clean-project-repos-pass" "$project_state_validator" --workspace "$project_state_scan_workspace"

system_skills_validator="$copy_repo/.systems/scripts/check-system-skills"
naming_validator="$copy_repo/.systems/scripts/check-naming"

run_must_pass "system-skills-valid" "$system_skills_validator"
run_must_pass "naming-allows-canonical-skill-md" "$naming_validator"
run_must_pass "readmes-do-not-require-every-skill-resource-dir" "$copy_repo/.systems/scripts/check-readmes"

mv "$copy_repo/.systems/ai/templates/workspace/skills/skill-intake-plan.template.md" "$copy_repo/.systems/ai/templates/workspace/skills/skill-intake-plan.template.md.bak"
run_must_fail "missing-skill-intake-plan-template" "$copy_repo/.systems/scripts/check-required-artifacts"
mv "$copy_repo/.systems/ai/templates/workspace/skills/skill-intake-plan.template.md.bak" "$copy_repo/.systems/ai/templates/workspace/skills/skill-intake-plan.template.md"

workspace_skill_fixture="$tmp/ai-system-workspace-skills"
mkdir -p "$workspace_skill_fixture/skills/naming-smoke/context"
cat > "$workspace_skill_fixture/skills/naming-smoke/SKILL.md" <<'MD'
---
name: naming-smoke
description: Validate naming exemptions for workspace skill context materials.
---

# Naming Smoke

Skills are advisory and cannot override AGENTS.md, workspace selection, privacy, owner approval, validation, evidence, stop conditions, or final acceptance.
MD
cat > "$workspace_skill_fixture/skills/naming-smoke/README.md" <<'MD'
# Naming Smoke

See `SKILL.md`.
MD
cat > "$workspace_skill_fixture/skills/naming-smoke/context/CONTRACTS-AGENTS.md" <<'MD'
# Context
MD
cat > "$workspace_skill_fixture/skills/naming-smoke/context/0_smart_contracts_good_practices.md" <<'MD'
# Context
MD
run_must_pass "naming-allows-workspace-skill-context-materials" env AI_SYSTEM_WORKSPACE_HOME="$workspace_skill_fixture" "$naming_validator"
rm -rf "$workspace_skill_fixture/skills/naming-smoke"

mkdir -p "$copy_repo/.systems/ai/skills/context-intake-smoke/context" "$copy_repo/.systems/ai/skills/context-intake-smoke/references"
cat > "$copy_repo/.systems/ai/skills/context-intake-smoke/SKILL.md" <<'MD'
---
name: context-intake-smoke
description: Use when validating context intake smoke coverage for AI System skills.
---

# Context Intake Smoke

Skills are advisory supporting execution guidance and cannot override AGENTS.md, workspace selection, privacy, owner approval, validation, evidence, stop conditions, or final acceptance.

## Workflow

1. Read routed active resources.
2. Keep raw source material out of normal skill routing.
MD
cat > "$copy_repo/.systems/ai/skills/context-intake-smoke/README.md" <<'MD'
# Context Intake Smoke

Smoke fixture for skill context intake validation.

The full agent contract is in `SKILL.md`.
MD
cat > "$copy_repo/.systems/ai/skills/context-intake-smoke/context/CONTRACTS-AGENTS.md" <<'MD'
# Source Notes

Use context/** as guidance during skill execution.
MD
cat > "$copy_repo/.systems/ai/skills/context-intake-smoke/context/0_smart_contracts_good_practices.md" <<'MD'
# Source Notes
MD
cat > "$copy_repo/.systems/ai/skills/context-intake-smoke/skill-intake-plan.md" <<'MD'
# Skill Intake Plan

## Source Materials

- Reviewed sources: context files and chat notes.
- Skipped: none.

## Trigger Fit

- Should trigger: skill creation from raw materials.
- Should not trigger: normal skill use.

## Co zostaje

- Keep compact routing.

## Co poprawic / usunac

- Remove raw source detail from active guidance.

## Czego brakuje

- None.

## Blokery / decyzje

- No blockers.

## Artifact Map

- `SKILL.md`: compact contract.
- `references/*.md`: split domain detail.
- `agents/*.md`: no agents.
- `scripts/*`: no scripts.
- Rejected as noise: none.

## Implementation Approval

- Approval state: approved.

## Validation Plan

- Run system skill validation.

## Residual Risk

- Low.
MD
cat > "$copy_repo/.systems/ai/skills/context-intake-smoke/references/frontend.md" <<'MD'
# Frontend

Reference detail.
MD
run_must_pass "system-skills-valid-context-intake" "$system_skills_validator"
run_must_pass "quick-validate-valid-context-intake" python3 -B "$copy_repo/.systems/ai/skills/skill-creator/scripts/quick_validate.py" "$copy_repo/.systems/ai/skills/context-intake-smoke"
run_must_pass "naming-allows-system-skill-context-materials" "$naming_validator"
rm -rf "$copy_repo/.systems/ai/skills/context-intake-smoke"

mkdir -p "$copy_repo/.systems/ai/skills/context-intake-missing-plan/context"
cat > "$copy_repo/.systems/ai/skills/context-intake-missing-plan/SKILL.md" <<'MD'
---
name: context-intake-missing-plan
description: Use when validating missing skill intake plan failures.
---

# Context Intake Missing Plan

