perl -0pi -e 's/^  task_candidate_eligible_count:.*$/  task_candidate_eligible_count: 2/m' "$properties_v3_report"
run_must_fail "personal-ops-properties-v3-eligible-count-mismatch" "$properties_v3_sync" --workspace "$properties_v3_workspace"
cmp "$properties_v3_workspace/personal-ops/indexes/check-ins-v3.csv.before-invalid" "$properties_v3_workspace/personal-ops/indexes/check-ins-v3.csv" || { echo "Eligible count mismatch replaced v3 index"; exit 1; }
cp "$properties_v3_report.valid" "$properties_v3_report"
perl -0pi -e 's/^  lesson_topic:.*\n//m' "$properties_v3_report"
run_must_fail "personal-ops-properties-v3-missing-property" "$properties_v3_sync" --workspace "$properties_v3_workspace"
cmp "$properties_v3_workspace/personal-ops/indexes/check-ins-v3.csv.before-invalid" "$properties_v3_workspace/personal-ops/indexes/check-ins-v3.csv" || { echo "Invalid properties replaced v3 index"; exit 1; }
cp "$properties_v3_report.valid" "$properties_v3_report"
perl -0pi -e 's/(  lesson_topic:.*\n)/$1  unknown_property: nope\n/' "$properties_v3_report"
run_must_fail "personal-ops-properties-v3-unknown-property" "$properties_v3_sync" --workspace "$properties_v3_workspace"
cp "$properties_v3_report.valid" "$properties_v3_report"
perl -0pi -e 's/^  task_generation_policy:.*$/  task_generation_policy: "legacy-wig-priority"/m' "$properties_v3_report"
run_must_fail "personal-ops-properties-v3-rejects-retired-task-policy" "$properties_v3_sync" --workspace "$properties_v3_workspace"
cp "$properties_v3_report.valid" "$properties_v3_report"
