test "$(wc -l < "$personal_ops_same_source_workspace/personal-ops/indexes/check-ins.csv" | tr -d ' ')" = "2" || { echo "notion mapper did not dedupe same source row"; exit 1; }
grep -q 'new value' "$personal_ops_same_source_workspace/personal-ops/check-ins/2026/2026-05-14.md" || { echo "notion mapper did not keep latest same-source row"; exit 1; }

