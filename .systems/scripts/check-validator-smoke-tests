import json
import sys
from decimal import Decimal

raw = open(sys.argv[1], encoding="utf-8").read()
assert raw.strip(), "budget calculator produced empty JSON output"
report = json.loads(raw)
monthly = report["monthly_spending"]
weekly = report["weekly_calories"]
assert Decimal(str(monthly["remaining_base_budget"])) == Decimal("1680"), monthly
assert Decimal(str(monthly["average_available_per_remaining_day"])).quantize(Decimal("0.01")) == Decimal("57.93"), monthly
assert Decimal(str(monthly["pace_overrun"])) == Decimal("210"), monthly
assert monthly["no_spend_days_from_today"] == 4, monthly
assert monthly["standard_spend_resume_date"] == "2026-08-07", monthly
assert Decimal(str(weekly["projected_after_today"])) == Decimal("2300"), weekly
assert Decimal(str(weekly["remaining_after_today"])) == Decimal("14500"), weekly
assert Decimal(str(weekly["mechanical_limit_after_today"])).quantize(Decimal("0.01")) == Decimal("2416.67"), weekly
assert weekly["common_sense_limit_after_today"] is None, weekly
food = weekly["food_schedule"]
assert food["status"] == "available", food
assert food["selection_basis"] == "planned_training_profile", food
assert food["planned_calorie_target"] == 2300.0, food
assert food["day_type"] == "training", food
assert food["totals"] == {"protein_g": 180.0, "fat_g": 80.0, "carbohydrates_g": 215.0}, food
assert Decimal(str(food["macro_derived_calories"])) == Decimal("2300"), food
assert Decimal(str(food["macro_calorie_delta"])) == Decimal("0"), food
assert Decimal(str(food["block_calorie_sum"])) == Decimal("2300"), food
assert food["if_conflicts"] == [], food
assert [block["status"] for block in food["food_blocks"]] == ["empty", "configured", "empty", "configured", "empty", "configured"], food
PY
