import json
import sys
from pathlib import Path

repo = Path(sys.argv[1])
destination = Path(sys.argv[2])
schema = json.loads((repo / ".systems/ai/templates/workspace/personal-ops/check-in-properties-v3.schema.json").read_text())
values = {field["key"]: field.get("default", "") for field in schema["fields"]}
values.update({
    "file_path": "personal-ops/check-ins/2026/2026-07-14.md",
    "report_id": "2026-07-14", "session_date": "2026-07-14", "closure_date": "2026-07-13",
    "weekday": "tuesday", "recording_time": "08:00", "timezone": "Europe/Warsaw",
    "source_type": "manual-interpreted", "task_generation_policy": "all-professional-do-v1",
    "plan_readiness": "needs-prioritization", "wig_kind": "none",
    "previous_day_wig_closure_json": "{}", "previous_day_minimum_day_status": "unknown",
    "task_generation_status": "skipped", "task_generation_reason": "fixture", "task_generation_references_json": "[]",
    "planned_items_json": "[]", "previous_day_actual_items_json": "[]", "previous_day_comparisons_json": "[]",
    "dynamic_habits_json": "[]", "attachments_json": "[]", "ocr_entries_json": "[]",
    "task_candidate_eligible_count": 0,
})
lines = ["---", "type: daily-check-in", "schema_version: 3", "index_contract: 3", "session_date: 2026-07-14", "previous_day_date: 2026-07-13", "properties:"]
for field in schema["fields"]:
    value = values[field["key"]]
    rendered = "true" if value is True else "false" if value is False else "" if value == "" else json.dumps(str(value), ensure_ascii=False)
    lines.append(f"  {field['key']}: {rendered}")
lines.extend(["---", "", "## Interpreted Check-In", "", "fixture", ""])
destination.write_text("\n".join(lines), encoding="utf-8")
PY
